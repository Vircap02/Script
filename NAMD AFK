local Window = Library:CreateWindow("NAMD AFK", "shield")

-- ============================================================
-- SECTION: AUTO COIN & BRING ITEM
-- ============================================================
Window:Section("─── Auto Coin Farm ───")

local autoCoinActive = false

Window:Toggle("Auto Coin (Teleport ke Jembatan)", false, function(v)
    autoCoinActive = v
    if autoCoinActive then
        print("Auto Coin diaktifkan!")
    else
        print("Auto Coin dimatikan!")
    end
end, "zap")

-- Tombol Once untuk Bring Object (+100 Coins) ke Karakter
Window:Button("Bring +100 Coins (Once)", function()
    pcall(function()
        if humanoidRootPart then
            local targetObject = Workspace:FindFirstChild("Obbys") and Workspace.Obbys:FindFirstChild("+100 Coins")

            if targetObject then
                if targetObject:IsA("Model") and targetObject.PrimaryPart then
                    targetObject:SetPrimaryPartCFrame(humanoidRootPart.CFrame)
                    print("Berhasil membawa Obbys['+100 Coins'] ke karakter!")
                elseif targetObject:IsA("BasePart") then
                    targetObject.CFrame = humanoidRootPart.CFrame
                    print("Berhasil membawa Obbys['+100 Coins'] ke karakter!")
                else
                    for _, part in ipairs(targetObject:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CFrame = humanoidRootPart.CFrame
                        end
                    end
                    print("Berhasil membawa seluruh part Obbys['+100 Coins'] ke karakter!")
                end
            else
                warn("Objek Obbys['+100 Coins'] tidak ditemukan di Workspace!")
            end
        end
    end)
end, "navigation")

-- Loop Auto Coin (Hanya Teleport ke koordinat jembatan)
task.spawn(function()
    while true do
        if autoCoinActive then
            pcall(function()
                if humanoidRootPart then
                    -- Teleport ke koordinat jembatan secara kontinu
                    humanoidRootPart.CFrame = CFrame.new(-104.14, -159.18, 4.30)
                end
            end)
            task.wait(0.5) 
        else
            task.wait(1)
        end
    end
end)

