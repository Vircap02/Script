createShopButton(
	TeleportTab, 
	"⚡ Auto Ambil (Once)", 
	"TP 1 Item sesuai Tier -> Fire Prompt -> Return", 
	Color3.fromRGB(255, 50, 100), 
	function()
		task.spawn(function()
			if not savedBaseCFrame then
				warn("PERINGATAN: Tandai posisi Anda terlebih dahulu menggunakan '📌 Tandai Lokasi'!")
				return
			end

			local targets = getTargetsByTier()
			if #targets == 0 then
				warn("Tidak ada objek dengan tier " .. selectedTier .. " ditemukan!")
				return
			end

			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not hrp then return end

			if currentIndex > #targets then currentIndex = 1 end
			local target = targets[currentIndex]

			if target and target.Parent then
				local targetCFrame = target:IsA("BasePart") and target.CFrame or (target:IsA("Model") and target:GetPivot())

				if targetCFrame then
					hrp.CFrame = targetCFrame + Vector3.new(0, 3, 0)
					hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)

					task.wait(0.25)

					local prompt = target:FindFirstChildOfClass("ProximityPrompt") or target:FindFirstChildWhichIsA("ProximityPrompt", true)
					if prompt then
						local oldHold = prompt.HoldDuration
						local oldLineOfSight = prompt.RequiresLineOfSight

						prompt.HoldDuration = 0
						prompt.RequiresLineOfSight = false

						if fireproximityprompt then
							fireproximityprompt(prompt)
							print("Auto Ambil [" .. selectedTier .. "]: Berhasil Fire Prompt [" .. currentIndex .. "]")
						end

						task.delay(0.2, function()
							if prompt then
								prompt.HoldDuration = oldHold
								prompt.RequiresLineOfSight = oldLineOfSight
							end
						end)
					end

					task.wait(0.5)

					hrp.CFrame = savedBaseCFrame + Vector3.new(0, 2, 0)
					hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
