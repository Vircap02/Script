local function getTargetsByTier()
	if cachedTargets then return cachedTargets end
	local clothingShops = workspace:FindFirstChild("ClothingShops")
	if not clothingShops then return {} end
	
	cachedTargets = {}
	for _, object in ipairs(clothingShops:GetDescendants()) do
		if object.Name == selectedTier then
			table.insert(cachedTargets, object)
		end
	end
	return cachedTargets
end

