	tabBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
	tabBtn.Font = Enum.Font.GothamSemibold
	tabBtn.TextSize = 12
	tabBtn.Parent = Sidebar

	local tabCorner = Instance.new("UICorner")
	tabCorner.CornerRadius = UDim.new(0, 6)
	tabCorner.Parent = tabBtn

	local container = Instance.new("ScrollingFrame")
	container.Size = UDim2.new(1, 0, 1, 0)
	container.BackgroundTransparency = 1
	container.ScrollBarThickness = 4
	container.ScrollBarImageColor3 = Color3.fromRGB(255, 185, 0)
	container.Visible = false
	container.Parent = TabHolder

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 8)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = container

	tabBtn.MouseEnter:Connect(function()
		if tabBtn.BackgroundColor3 ~= Color3.fromRGB(255, 185, 0) then
			TweenService:Create(tabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 45, 58)}):Play()
		end
	end)
	tabBtn.MouseLeave:Connect(function()
		if tabBtn.BackgroundColor3 ~= Color3.fromRGB(255, 185, 0) then
			TweenService:Create(tabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 38)}):Play()
		end
	end)

	tabBtn.MouseButton1Click:Connect(function()
		for _, t in ipairs(tabs) do
			TweenService:Create(t.Button, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 30, 38), TextColor3 = Color3.fromRGB(180, 180, 190)}):Play()
			t.Container.Visible = false
		end
		
		container.Position = UDim2.new(0.05, 0, 0, 0)
		container.Visible = true
		container.CanvasPosition = Vector2.new(0, 0)
		TweenService:Create(container, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0, 0, 0, 0)
		}):Play()

		TweenService:Create(tabBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(255, 185, 0), TextColor3 = Color3.fromRGB(20, 20, 20)}):Play()
	end)

	table.insert(tabs, {Button = tabBtn, Container = container})
	if #tabs == 1 then
		tabBtn.BackgroundColor3 = Color3.fromRGB(255, 185, 0)
		tabBtn.TextColor3 = Color3.fromRGB(20, 20, 20)
		container.Visible = true
	end
	return container
end

