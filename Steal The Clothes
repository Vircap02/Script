-- BASE SLOTS LOGIC
--------------------------------------------------------------------------------
local function getNearestBase()
	local basesFolder = workspace:FindFirstChild("Bases")
	if not basesFolder then return nil end

	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end

	local nearestBase = nil
	local minDistance = math.huge

	for _, base in ipairs(basesFolder:GetChildren()) do
		local spawnPart = base:FindFirstChild("SpawnPart") or base:FindFirstChildWhichIsA("BasePart", true)
		if spawnPart and spawnPart:IsA("BasePart") then
			local dist = (hrp.Position - spawnPart.Position).Magnitude
			if dist < minDistance then
				minDistance = dist
				nearestBase = base
			end
		end
	end

	return nearestBase
end

local function fireTouchSlots()
	local nearestBase = getNearestBase()
	if not nearestBase then return end

	local slotsFolder = nearestBase:FindFirstChild("Slots")
	if not slotsFolder then return end

	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp or not firetouchinterest then return end

	for _, item in ipairs(slotsFolder:GetDescendants()) do
		if not autoSlotsEnabled then break end
		if item:IsA("TouchTransmitter") then
			local touchablePart = item.Parent
			if touchablePart and touchablePart:IsA("BasePart") then
				firetouchinterest(hrp, touchablePart, 0)
				task.wait()
				firetouchinterest(hrp, touchablePart, 1)
			end
		elseif item:IsA("BasePart") and item.CanTouch then
			firetouchinterest(hrp, item, 0)
			task.wait()
			firetouchinterest(hrp, item, 1)
		end
	end
end

