    local function GetAllCheckpoints()
        local list = {}
        local checkpointsFolder = workspace:FindFirstChild("Level") and workspace.Level:FindFirstChild("Checkpoints")

        if checkpointsFolder then
            for _, folder in pairs(checkpointsFolder:GetChildren()) do
                if string.sub(folder.Name, 1, 3) == "sts" then
                    local cp = folder:FindFirstChild("SpawnLocation")
                    if cp and cp:IsA("BasePart") then
                        table.insert(list, {
                            folderName = folder.Name,
                            obj = cp
                        })
                    end
                end
            end
        end
        -- Urutkan berdasarkan nama agar berurutan mutlak (sts01, sts02, sts03...)
