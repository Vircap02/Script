    local function getRI()
        local pk = workspace:FindFirstChild("Pickups")
        if not pk then return 0 end
        local c = 0
        for _, i in pairs(pk:GetChildren()) do
            if i:IsA("BasePart") or i:IsA("Model") then c = c + 1 end
        end
        return c
    end

    local function gC(root)
        if not root then return nil, nil end
        
        local nearestTarget, targetType, targetKey = nil, nil, nil
        local shortestDist = math.huge

        local allCPs = GetAllCheckpoints()
        for _, cpData in ipairs(allCPs) do
            if cpData.obj and not V_CP[cpData.folderName] then
                local dist = (root.Position - cpData.obj.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearestTarget = cpData.obj
                    targetType = "Checkpoint"
                    targetKey = cpData.folderName
                end
            end
        end

        local pk = workspace:FindFirstChild("Pickups")
        if pk and getRI() > S_COLLECT then
            for _, item in pairs(pk:GetChildren()) do
                local p = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
                if p then
                    local dist = (root.Position - p.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        nearestTarget = item
                        targetType = "Item"
                        targetKey = nil
                    end
                end
            end
        end

        local checkpointsFolder = workspace:FindFirstChild("Level") and workspace.Level:FindFirstChild("Checkpoints")
        if checkpointsFolder then
            for _, folder in pairs(checkpointsFolder:GetChildren()) do
                for _, obj in pairs(folder:GetChildren()) do
                    if obj:IsA("BasePart") and obj.Name ~= "SpawnLocation" and not V_CP[obj.Name] then
                        local dist = (root.Position - obj.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            nearestTarget = obj
                            targetType = "Sticker"
                            targetKey = obj.Name
                        end
                    end
                end
            end
        end

        return nearestTarget, targetType, targetKey
    end

    local function start_run()
        local current_timer = math.random(105, 110)
        S_COLLECT = math.random(2, 5)
        
        ShowNotify("Anti-Cheat Bypass", "Timer: " .. current_timer .. "s | Target Sisa: " .. S_COLLECT)

        V_CP = {} 
        A_RUN = true
        local char = LP.Character or LP.CharacterAdded:Wait(2)
        local root = char:WaitForChild("HumanoidRootPart", 10)
        
        local startObj = workspace:FindFirstChild("Utility") 
            and workspace.Utility:FindFirstChild("ObbyColliders") 
            and workspace.Utility.ObbyColliders:FindFirstChild("GameStart")

        if startObj and startObj:IsA("BasePart") then
            root.CFrame = startObj.CFrame + Vector3.new(0, 3, 0)
            task.wait(1.5)
        end

        local s_tick = tick()
        while A_RUN do
            if tick() - s_tick >= current_timer then break end
            local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not r then task.wait(1) continue end

            local cp14 = workspace:FindFirstChild("Level") and workspace.Level:FindFirstChild("Checkpoints") and workspace.Level.Checkpoints:FindFirstChild("sts14") and workspace.Level.Checkpoints.sts14:FindFirstChild("SpawnLocation")
            if cp14 and (r.Position - cp14.Position).Magnitude < 15 then
                r.Velocity = Vector3.new(0,0,0)
                r.CFrame = cp14.CFrame + Vector3.new(0, 3, 0)
                V_CP["sts14"] = true
                
                while A_RUN and (tick() - s_tick < current_timer) do
                    local sisa = math.floor(current_timer - (tick() - s_tick))
                    if sisa > 0 and sisa % 10 == 0 then
                        ShowNotify("Anti-Cheat Bypass", "Menunggu timer di sts14: " .. sisa .. " detik tersisa...")
                    end
                    task.wait(1)
                end
                break
            end

            local target, ttype, saveKey = gC(r)
            if target then
                r.Velocity = Vector3.new(0,0,0)
                
                if ttype == "Checkpoint" then
                    r.CFrame = target.CFrame + Vector3.new(0, 3, 0)
                    if saveKey then V_CP[saveKey] = true end
                    task.wait(0.2)
                    
                elseif ttype == "Item" then
                    local tp = target:IsA("BasePart") and target or target:FindFirstChildWhichIsA("BasePart", true)
                    r.CFrame = tp.CFrame
                    local pr = target:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if pr then 
                        task.wait(0.1)
                        if fireproximityprompt then fireproximityprompt(pr) else pr:InputHoldBegin() task.wait(0.2) pr:InputHoldEnd() end
                    end
                    
                elseif ttype == "Sticker" then
                    r.CFrame = target.CFrame + Vector3.new(0, 3, 0)
                    if saveKey then V_CP[saveKey] = true end
                end
                
                task.wait(M_DELAY + (math.random() * 0.30)) 
            else 
                task.wait(0.5)
                break 
            end
            task.wait(0.05)
        end
        
        local rEnd = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if rEnd then
            local sts15_cp = workspace:FindFirstChild("Level") 
                and workspace.Level:FindFirstChild("Checkpoints") 
                and workspace.Level.Checkpoints:FindFirstChild("sts15") 
                and workspace.Level.Checkpoints.sts15:FindFirstChild("SpawnLocation")
            
            if sts15_cp and sts15_cp:IsA("BasePart") then
                ShowNotify("Final Checkpoint", "Timer Selesai! Teleporting ke sts15...")
                rEnd.CFrame = sts15_cp.CFrame + Vector3.new(0, 3, 0)
                task.wait(1.2)
            end
        end

        tP_Finish()
        A_RUN = false
    end

    local function JoinSmallServer()
        ShowNotify("Server Finder", "Mencari server paling sepi...")
        local HttpService = game:GetService("HttpService")
        local TeleportService = game:GetService("TeleportService")
        local PlaceId = game.PlaceId
        
        local success, result = pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and result and result.data then
            local targetServer = nil
            for _, server in ipairs(result.data) do
                if server.playing and server.playing < server.maxPlayers and server.id ~= game.JobId then
                    if not targetServer or server.playing < targetServer.playing then
                        targetServer = server
                    end
                end
            end
            
            if targetServer then
                ShowNotify("Server Found", "Menghubungkan ke server sepi...")
                task.wait(1)
                TeleportService:TeleportToPlaceInstance(PlaceId, targetServer.id, LP)
            else
                ShowNotify("Error", "Server kecil tidak ditemukan.")
            end
        else
            ShowNotify("Error", "Gagal mengambil data server.")
        end
    end

