-- Normalisasi Tipe Accessory dari teks UI
local TYPE_MAP = {
    face = "FaceAccessory",
    faceaccessory = "FaceAccessory",
    hair = "HairAccessory",
    hairaccessory = "HairAccessory",
    hat = "HatAccessory",
    hataccessory = "HatAccessory",
    back = "BackAccessory",
    backaccessory = "BackAccessory",
    front = "FrontAccessory",
    frontaccessory = "FrontAccessory",
    shoulder = "ShoulderAccessory",
    shoulderaccessory = "ShoulderAccessory",
    waist = "WaistAccessory",
    waistaccessory = "WaistAccessory",
    neck = "NeckAccessory",
    neckaccessory = "NeckAccessory",
}

local function normalizeType(raw)
    if type(raw) ~= "string" then return nil end
    local clean = string.gsub(raw, "^%s*(.-)%s*$", "%1")
    local afterPipe = string.match(clean, "|%s*([^|]+)$")
    if afterPipe then
        clean = string.gsub(afterPipe, "^%s*(.-)%s*$", "%1")
    end
    local lower = string.lower(clean)
    if TYPE_MAP[lower] then
        return TYPE_MAP[lower]
    end
    for key, mapped in pairs(TYPE_MAP) do
        if string.find(lower, key, 1, true) then
            return mapped
        end
    end
    return #clean > 0 and clean or nil
end

local function isNoiseText(txt)
    if type(txt) ~= "string" then return true end
    local t = string.gsub(txt, "^%s*(.-)%s*$", "%1")
    if #t == 0 then return true end
    local lt = string.lower(t)
    if lt == "locked" or lt == "buy" or lt == "buy points" or lt == "outfits"
        or lt == "featured" or lt == "all" or lt == "new" or lt == "upcoming"
        or lt == "out of season" or lt == "back" or string.find(lt, "no stoc", 1, true)
        or string.find(lt, "pts", 1, true) or string.find(lt, "/10k", 1, true)
        or string.find(lt, "%d+h") or string.find(lt, "%d+m") or string.find(lt, "%d+s")
        or string.match(t, "^[%d%.,]+$") then
        return true
    end
    return false
end

local function extractIdFromText(txt)
    if type(txt) ~= "string" then return nil end
    local lt = string.lower(txt)
    if string.find(lt, "pts", 1, true) or string.find(lt, "k/", 1, true) or string.find(lt, "minutes", 1, true) then
        return nil
    end
    for digits in string.gmatch(txt, "(%d+)") do
        local num = tonumber(digits)
        if num and #digits >= 6 then
            return num
        end
    end
    return nil
end

local function scanContainer(container, state)
    if not container then return end

    for _, attrName in ipairs({ "AssetId", "ItemId", "ProductId", "UGCId", "Id" }) do
        local v = container:GetAttribute(attrName)
        local n = tonumber(v)
        if n and #tostring(math.floor(n)) >= 6 then
            state.id = state.id or n
        end
    end
    if not state.name then
        local aName = container:GetAttribute("ItemName") or container:GetAttribute("AssetName") or container:GetAttribute("DisplayName")
        if type(aName) == "string" and not isNoiseText(aName) then
            state.name = aName
        end
    end
    if not state.itemType then
        local aType = container:GetAttribute("AccessoryType") or container:GetAttribute("AssetType") or container:GetAttribute("ItemType") or container:GetAttribute("Type")
        if type(aType) == "string" then
            state.itemType = normalizeType(aType)
        end
    end

    for _, desc in ipairs(container:GetDescendants()) do
        local lname = string.lower(desc.Name)
        if desc:IsA("IntValue") or desc:IsA("NumberValue") or desc:IsA("StringValue") then
            if lname == "assetid" or lname == "itemid" or lname == "ugcid" or lname == "id" then
                local n = tonumber(desc.Value)
                if n and #tostring(math.floor(n)) >= 6 then
                    state.id = state.id or n
                end
            elseif (lname == "itemname" or lname == "assetname" or lname == "displayname") and not isNoiseText(tostring(desc.Value)) then
                state.name = state.name or tostring(desc.Value)
            elseif lname == "accessorytype" or lname == "assettype" or lname == "itemtype" or lname == "type" then
                state.itemType = state.itemType or normalizeType(tostring(desc.Value))
            end
        elseif desc:IsA("TextLabel") or desc:IsA("TextButton") then
            local trimmed = string.gsub(desc.Text, "^%s*(.-)%s*$", "%1")
            if #trimmed > 0 then
                if string.find(trimmed, "|", 1, true) or string.find(string.lower(trimmed), "accessory", 1, true) then
                    local norm = normalizeType(trimmed)
                    if norm then
                        state.itemType = state.itemType or norm
                    end
                elseif not isNoiseText(trimmed) then
                    if not state.name and not string.match(trimmed, "^[%d%.,]+$") then
                        state.name = trimmed
                    end
                end
                local idCand = extractIdFromText(trimmed)
                if idCand then
                    state.id = state.id or idCand
                end
            end
        elseif desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
            local imgId = string.match(tostring(desc.Image), "(%d%d%d%d%d%d+)")
            if imgId and not state.id then
                state.fallbackId = state.fallbackId or tonumber(imgId)
            end
        end
    end
end

local function detectAtPosition(posX, posY)
    local state = { id = nil, name = nil, itemType = nil, fallbackId = nil }

    local okGui, guiList = pcall(function()
        return playerGui:GetGuiObjectsAtPosition(posX, posY)
    end)

    if okGui and guiList and #guiList > 0 then
        local topObj = guiList[1]
        local curr = topObj
        for _ = 1, 6 do
            if not curr or curr:IsA("ScreenGui") or curr:IsA("PlayerGui") then break end
            scanContainer(curr, state)
            if state.id and state.name and state.itemType then
                break
            end
            curr = curr.Parent
        end

        if not (state.id and state.name) then
            local screenRoot = topObj:FindFirstAncestorOfClass("ScreenGui")
            if screenRoot then
                for _, d in ipairs(screenRoot:GetDescendants()) do
                    if (d:IsA("Frame") or d:IsA("ImageLabel")) and d.Visible and d.AbsoluteSize.X > 140 and d.AbsoluteSize.Y > 140 then
                        local hasBuyOrLocked = false
                        for _, sub in ipairs(d:GetDescendants()) do
                            if (sub:IsA("TextLabel") or sub:IsA("TextButton")) then
                                local st = string.lower(sub.Text)
                                if st == "buy" or st == "locked" then
                                    hasBuyOrLocked = true
                                    break
                                end
                            end
                        end
                        if hasBuyOrLocked then
                            scanContainer(d, state)
                            break
                        end
                    end
                end
            end
        end
    end

    -- Raycast / mouse.Target fallback untuk objek 3D di HP maupun PC
    local target3D = mouse.Target
    if not target3D then
        local cam = workspace.CurrentCamera
        if cam then
            local ray = cam:ViewportPointToRay(posX, posY)
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            if localPlayer.Character then
                rayParams.FilterDescendantsInstances = { localPlayer.Character }
            end
            local res = workspace:Raycast(ray.Origin, ray.Direction * 500, rayParams)
            if res and res.Instance then
                target3D = res.Instance
            end
        end
    end

    if not (state.id and state.name and state.itemType) and target3D then
        local curr = target3D
        for _ = 1, 6 do
            if not curr or curr == workspace then break end
            scanContainer(curr, state)
            local digits = string.match(curr.Name, "(%d%d%d%d%d%d+)")
            if digits and not state.id then
                state.id = tonumber(digits)
            end
            if not state.itemType and curr:IsA("Accoutrement") and curr.AccessoryType ~= Enum.AccessoryType.None then
                state.itemType = curr.AccessoryType.Name
            end
            if not state.name and not curr:IsA("BasePart") and not string.match(curr.Name, "^%d+$") and not isNoiseText(curr.Name) then
                state.name = curr.Name
            end
            curr = curr.Parent
        end
    end

    if not state.id and state.fallbackId then
        state.id = state.fallbackId
    end

    if state.id or state.name or state.itemType then
        return state
    end
    return nil
end

local function isHitOwnGui(posX, posY)
    for _, container in ipairs({ gui, playerGui }) do
        local ok, objs = pcall(function()
            return container:GetGuiObjectsAtPosition(posX, posY)
        end)
        if ok and objs then
            for _, gObj in ipairs(objs) do
                if gObj:IsDescendantOf(gui) then
                    return true
                end
            end
        end
    end
    return false
end

local function handleTapOrClick(pos)
    if not autoDetectEnabled then return end
    if isHitOwnGui(pos.X, pos.Y) then return end

    task.delay(0.1, function()
        if not autoDetectEnabled then return end
        local data = detectAtPosition(pos.X, pos.Y)
        if data then
            if data.id then
                idInput.Text = tostring(data.id)
            end
            if data.name then
                nameInput.Text = data.name
            end
            if data.itemType then
                typeInput.Text = data.itemType
            end
            statusLbl.Text = "Detected: " .. (data.name or "?") .. " | " .. (data.itemType or "?") .. " | " .. tostring(data.id or "?")
            statusLbl.TextColor3 = Color3.fromRGB(110, 255, 175)
        else
            statusLbl.Text = "Belum ada data item terbaca pada tap ini"
            statusLbl.TextColor3 = Color3.fromRGB(255, 190, 100)
        end
    end)
end

