-- Sistem Dragging untuk Panel Utama, Pop-up Ikon, dan Virtual Mouse Cursor
do
    local dragTarget = nil
    local dragStart = nil
    local startPos = nil
    local cursorDragOffset = Vector2.zero

    local function beginPanelDrag(obj, input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local abs = obj.AbsolutePosition
            obj.Position = UDim2.new(0, abs.X, 0, abs.Y)
            dragTarget = obj
            dragStart = input.Position
            startPos = obj.Position
        end
    end

    main.InputBegan:Connect(function(i)
        beginPanelDrag(main, i)
    end)

    floatingIcon.InputBegan:Connect(function(i)
        beginPanelDrag(floatingIcon, i)
    end)

    cursorFrame.InputBegan:Connect(function(i)
        if not mouseSimEnabled then return end
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragTarget = cursorFrame
            cursorDragOffset = cursorPos - Vector2.new(i.Position.X, i.Position.Y)
        end
    end)

    userInputService.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement and mouseSimEnabled and dragTarget ~= cursorFrame then
            setCursorPosition(i.Position.X, i.Position.Y)
        end

        if not dragTarget then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
            if dragTarget == cursorFrame then
                setCursorPosition(i.Position.X + cursorDragOffset.X, i.Position.Y + cursorDragOffset.Y)
            else
                local d = i.Position - dragStart
                local vp = workspace.CurrentCamera.ViewportSize
                local gs = dragTarget.AbsoluteSize
                dragTarget.Position = UDim2.new(
                    0,
                    math.clamp(startPos.X.Offset + d.X, 0, math.max(0, vp.X - gs.X)),
                    0,
                    math.clamp(startPos.Y.Offset + d.Y, 0, math.max(0, vp.Y - gs.Y))
                )
            end
        end
    end)

    userInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragTarget = nil
        end
    end)
end

