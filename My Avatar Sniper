-- Fungsi Eksekusi Remote Purchase
local function fireSnipe()
    local assetId = tonumber(idInput.Text)
    local itemName = nameInput.Text
    local itemType = typeInput.Text

    if not assetId then
        statusLbl.Text = "Error: ID harus berupa angka!"
        statusLbl.TextColor3 = Color3.fromRGB(255, 90, 90)
        return false
    end

    local args = {
        {
            {
                assetId,
                "Asset",
                itemName,
                itemType
            }
        }
    }

    local success, err = pcall(function()
        replicatedStorage:WaitForChild("Honeypot"):WaitForChild("Internal"):WaitForChild("RemoteStorage"):WaitForChild("PromptPurchase - RemoteEvent"):FireServer(unpack(args))
    end)

    if success then
        statusLbl.Text = "Terkirim: " .. itemName .. " (" .. tostring(assetId) .. ")"
        statusLbl.TextColor3 = Color3.fromRGB(120, 255, 140)
    else
        statusLbl.Text = "Gagal: " .. tostring(err)
        statusLbl.TextColor3 = Color3.fromRGB(255, 90, 90)
        warn("[AceSniperUI] FireServer gagal:", err)
    end
    return success
end

