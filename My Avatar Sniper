-- Fungsi Eksekusi Remote Purchase
local function fireSnipe()
    local assetId = tonumber(idInput.Text)
    local itemName = nameInput.Text
    local itemType = typeInput.Text

    if not assetId then
        statusLbl.Text = "Error: ID harus berupa angka!"
        statusLbl.TextColor3 = Color3.fromRGB(255, 90, 90)
        return false
    end

    local args = {
        {
            {
                assetId,
                "Asset",
                itemName,
                itemType
            }
        }
    }

    local success, err = pcall(function()
        replicatedStorage:WaitForChild("Honeypot"):WaitForChild("Internal"):WaitForChild("RemoteStorage"):WaitForChild("PromptPurchase - RemoteEvent"):FireServer(unpack(args))
    end)

    if success then
        statusLbl.Text = "Terkirim: " .. itemName .. " (" .. tostring(assetId) .. ")"
        statusLbl.TextColor3 = Color3.fromRGB(120, 255, 140)
    else
        statusLbl.Text = "Gagal: " .. tostring(err)
        statusLbl.TextColor3 = Color3.fromRGB(255, 90, 90)
    end
    return success
end

snipeOnceBtn.MouseButton1Click:Connect(function()
    fireSnipe()
end)

autoSnipeBtn.MouseButton1Click:Connect(function()
    isSniping = not isSniping
    if isSniping then
        autoSnipeBtn.Text = "AUTO SNIPE: ON"
        autoSnipeBtn.BackgroundColor3 = BTN_STOP
        task.spawn(function()
            while isSniping and gui.Parent do
                local ok = fireSnipe()
                if not ok then
                    isSniping = false
                    autoSnipeBtn.Text = "AUTO SNIPE: OFF"
                    autoSnipeBtn.BackgroundColor3 = BTN_START
                    break
                end
                task.wait(0.1)
            end
        end)
    else
        autoSnipeBtn.Text = "AUTO SNIPE: OFF"
        autoSnipeBtn.BackgroundColor3 = BTN_START
        statusLbl.Text = "Status: Auto Snipe dihentikan"
        statusLbl.TextColor3 = Color3.fromRGB(255, 190, 100)
    end
end)

