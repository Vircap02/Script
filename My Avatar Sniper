-- Normalisasi Tipe Accessory dari teks UI
local TYPE_MAP = {
    face = "FaceAccessory",
    faceaccessory = "FaceAccessory",
    hair = "HairAccessory",
    hairaccessory = "HairAccessory",
    hat = "HatAccessory",
    hataccessory = "HatAccessory",
    back = "BackAccessory",
    backaccessory = "BackAccessory",
    front = "FrontAccessory",
    frontaccessory = "FrontAccessory",
    shoulder = "ShoulderAccessory",
    shoulderaccessory = "ShoulderAccessory",
    waist = "WaistAccessory",
    waistaccessory = "WaistAccessory",
    neck = "NeckAccessory",
    neckaccessory = "NeckAccessory",
}

local function normalizeType(raw)
    if type(raw) ~= "string" then return nil end
    local clean = string.gsub(raw, "^%s*(.-)%s*$", "%1")
    local afterPipe = string.match(clean, "|%s*([^|]+)$")
    if afterPipe then
        clean = string.gsub(afterPipe, "^%s*(.-)%s*$", "%1")
    end
    local lower = string.lower(clean)
    if TYPE_MAP[lower] then
        return TYPE_MAP[lower]
    end
    for key, mapped in pairs(TYPE_MAP) do
        if string.find(lower, key, 1, true) then
            return mapped
        end
    end
    return #clean > 0 and clean or nil
end

local function isNoiseText(txt)
    if type(txt) ~= "string" then return true end
    local t = string.gsub(txt, "^%s*(.-)%s*$", "%1")
    if #t == 0 then return true end
    local lt = string.lower(t)
    if lt == "locked" or lt == "buy" or lt == "buy points" or lt == "outfits"
        or lt == "featured" or lt == "all" or lt == "new" or lt == "upcoming"
        or lt == "out of season" or lt == "back" or lt == "map" or lt == "workspace"
        or lt == "terrain" or lt == "part" or lt == "meshpart" or lt == "model"
        or string.find(lt, "no stoc", 1, true)
        or string.find(lt, "pts", 1, true) or string.find(lt, "/10k", 1, true)
        or string.find(lt, "%d+h") or string.find(lt, "%d+m") or string.find(lt, "%d+s")
        or string.match(t, "^[%d%.,]+$") then
        return true
    end
    return false
end

local function extractIdFromText(txt)
    if type(txt) ~= "string" then return nil end
    local lt = string.lower(txt)
    if string.find(lt, "pts", 1, true) or string.find(lt, "k/", 1, true) or string.find(lt, "minutes", 1, true) then
        return nil
    end
    for digits in string.gmatch(txt, "(%d+)") do
        local num = tonumber(digits)
        if num and #digits >= 6 then
            return num
        end
    end
    return nil
end

local function scanContainer(container, state)
    if not container then return end

    for _, attrName in ipairs(container:GetAttributes()) do
        local _ = attrName
    end
    for attrName, v in pairs(container:GetAttributes()) do
        local lattr = string.lower(tostring(attrName))
        if string.find(lattr, "id", 1, true) then
            local n = tonumber(v)
            if n and #tostring(math.floor(n)) >= 6 then
                state.id = state.id or n
            end
        elseif string.find(lattr, "name", 1, true) and type(v) == "string" and not isNoiseText(v) then
            state.name = state.name or v
        elseif string.find(lattr, "type", 1, true) and type(v) == "string" then
            state.itemType = state.itemType or normalizeType(v)
        end
    end

    for _, desc in ipairs(container:GetDescendants()) do
        local lname = string.lower(desc.Name)
        if desc:IsA("IntValue") or desc:IsA("NumberValue") or desc:IsA("StringValue") then
            if string.find(lname, "id", 1, true) then
                local n = tonumber(desc.Value)
                if n and #tostring(math.floor(n)) >= 6 then
                    state.id = state.id or n
                end
            elseif string.find(lname, "name", 1, true) and not isNoiseText(tostring(desc.Value)) then
                state.name = state.name or tostring(desc.Value)
            elseif string.find(lname, "type", 1, true) then
                state.itemType = state.itemType or normalizeType(tostring(desc.Value))
            end
        elseif desc:IsA("TextLabel") or desc:IsA("TextButton") then
            local trimmed = string.gsub(desc.Text, "^%s*(.-)%s*$", "%1")
            if #trimmed > 0 then
                if string.find(trimmed, "|", 1, true) or string.find(string.lower(trimmed), "accessory", 1, true) then
                    local norm = normalizeType(trimmed)
                    if norm then
                        state.itemType = state.itemType or norm
                    end
                elseif not isNoiseText(trimmed) then
                    if not state.name and not string.match(trimmed, "^[%d%.,]+$") then
                        state.name = trimmed
                    end
                end
                local idCand = extractIdFromText(trimmed)
                if idCand then
                    state.id = state.id or idCand
                end
            end
        elseif desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
            local imgId = string.match(tostring(desc.Image), "(%d%d%d%d%d%d+)")
            if imgId and not state.id then
                state.fallbackId = state.fallbackId or tonumber(imgId)
            end
        end
    end
end

local function getAccessibleGuiRoots()
    local roots = { playerGui }
    local ok, cg = pcall(function()
        return cloneref(game:GetService("CoreGui"))
    end)
    if ok and cg and cg ~= uiParent then
        local canRead = pcall(function()
            local _ = cg:GetChildren()
        end)
        if canRead then
            table.insert(roots, cg)
        end
    end
    return roots
end

local function isHitOwnGui(posX, posY)
    for _, root in ipairs(getAccessibleGuiRoots()) do
        local ok, objs = pcall(function()
            return root:GetGuiObjectsAtPosition(posX, posY)
        end)
        if ok and objs then
            for _, gObj in ipairs(objs) do
                if gObj:IsDescendantOf(gui) then
                    return true
                end
            end
        end
    end
    return false
end

local function detectAtPosition(posX, posY)
    local state = { id = nil, name = nil, itemType = nil, fallbackId = nil, debugHit = nil }

    local topUiObj = nil
    for _, root in ipairs(getAccessibleGuiRoots()) do
        local okGui, guiList = pcall(function()
            return root:GetGuiObjectsAtPosition(posX, posY)
        end)
        if okGui and guiList and #guiList > 0 then
            for _, gObj in ipairs(guiList) do
                if not gObj:IsDescendantOf(gui) and gObj.Visible then
                    topUiObj = gObj
                    state.debugHit = gObj.Name
                    break
                end
            end
        end
        if topUiObj then break end
    end

    if topUiObj then
        local curr = topUiObj
        for _ = 1, 9 do
            if not curr or curr:IsA("ScreenGui") or curr:IsA("PlayerGui") or curr:IsA("CoreGui") then break end
            scanContainer(curr, state)
            if state.id and state.name and state.itemType then
                break
            end
            curr = curr.Parent
        end

        if not (state.id and state.name) then
            local screenRoot = topUiObj:FindFirstAncestorOfClass("ScreenGui")
            if screenRoot then
                for _, d in ipairs(screenRoot:GetDescendants()) do
                    if (d:IsA("Frame") or d:IsA("ImageLabel")) and d.Visible and d.AbsoluteSize.X > 120 and d.AbsoluteSize.Y > 120 then
                        local hasShopKeyword = false
                        for _, sub in ipairs(d:GetDescendants()) do
                            if (sub:IsA("TextLabel") or sub:IsA("TextButton")) then
                                local st = string.lower(sub.Text)
                                if st == "buy" or st == "locked" or string.find(st, "pts", 1, true) or string.find(st, "accessory", 1, true) then
                                    hasShopKeyword = true
                                    break
                                end
                            end
                        end
                        if hasShopKeyword then
                            scanContainer(d, state)
                            break
                        end
                    end
                end
            end
        end
    end

    if not (state.id and state.name and state.itemType) then
        local target3D = mouse.Target
        local cam = workspace.CurrentCamera
        if cam then
            local ray = cam:ViewportPointToRay(posX, posY)
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            if localPlayer.Character then
                rayParams.FilterDescendantsInstances = { localPlayer.Character }
            end
            local res = workspace:Raycast(ray.Origin, ray.Direction * 500, rayParams)
            if res and res.Instance then
                target3D = res.Instance
                if not state.debugHit then
                    state.debugHit = res.Instance.Name
                end
            end
        end

        if target3D then
            local curr = target3D
            for _ = 1, 7 do
                if not curr or curr == workspace then break end
                scanContainer(curr, state)
                local digits = string.match(curr.Name, "(%d%d%d%d%d%d+)")
                if digits and not state.id then
                    state.id = tonumber(digits)
                end
                if not state.itemType and curr:IsA("Accoutrement") and curr.AccessoryType ~= Enum.AccessoryType.None then
                    state.itemType = curr.AccessoryType.Name
                end
                if not state.name and not curr:IsA("BasePart") and not string.match(curr.Name, "^%d+$") and not isNoiseText(curr.Name) then
                    state.name = curr.Name
                end
                curr = curr.Parent
            end
        end
    end

    if not state.id and state.fallbackId then
        state.id = state.fallbackId
    end

    if state.id or state.name or state.itemType then
        return state
    end
    return nil, state.debugHit
end

local function applyDetectedData(data, debugHit)
    if data then
        if data.id then
            idInput.Text = tostring(data.id)
        end
        if data.name then
            nameInput.Text = data.name
        end
        if data.itemType then
            typeInput.Text = data.itemType
        end
        local infoText = "Detected: " .. (data.name or "?") .. " | " .. (data.itemType or "?") .. " | " .. tostring(data.id or "?")
        statusLbl.Text = infoText
        statusLbl.TextColor3 = Color3.fromRGB(110, 255, 175)
        print("[AceSniperUI]", infoText)
    else
        local hitLabel = debugHit and (" [" .. tostring(debugHit) .. "]") or ""
        statusLbl.Text = "Belum ada data item terbaca" .. hitLabel
        statusLbl.TextColor3 = Color3.fromRGB(255, 190, 100)
        print("[AceSniperUI] Belum ada data item terbaca pada posisi ini" .. hitLabel)
    end
end

local function handleTapOrClick(pos)
    if not autoDetectEnabled then return end
    if isHitOwnGui(pos.X, pos.Y) then return end

    task.delay(0.1, function()
        if not autoDetectEnabled then return end
        local data, hitName = detectAtPosition(pos.X, pos.Y)
        applyDetectedData(data, hitName)
    end)
end

local function simulateVirtualMouseClick()
    local absPos = cursorFrame.AbsolutePosition
    local absSize = cursorFrame.AbsoluteSize
    local cx = absPos.X + (absSize.X * 0.5)
    local cy = absPos.Y + (absSize.Y * 0.5)

    tweenService:Create(cursorFrame, TweenInfo.new(0.08), {BackgroundColor3 = Color3.fromRGB(110, 255, 160)}):Play()
    task.delay(0.12, function()
        if cursorFrame.Parent then
            tweenService:Create(cursorFrame, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(255, 140, 0)}):Play()
        end
    end)

    for _, root in ipairs(getAccessibleGuiRoots()) do
        local ok, objs = pcall(function()
            return root:GetGuiObjectsAtPosition(cx, cy)
        end)
        if ok and objs then
            for _, gObj in ipairs(objs) do
                if not gObj:IsDescendantOf(gui) and gObj.Visible then
                    if gObj:IsA("GuiButton") then
                        pcall(function()
                            for _, sigName in ipairs({ "MouseButton1Down", "MouseButton1Click", "Activated" }) do
                                local sig = gObj[sigName]
                                if sig and typeof(sig) == "RBXScriptSignal" and firesignal then
                                    firesignal(sig)
                                end
                            end
                        end)
                        break
                    end
                end
            end
        end
    end

    local cam = workspace.CurrentCamera
    if cam then
        local ray = cam:ViewportPointToRay(cx, cy)
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        if localPlayer.Character then
            rayParams.FilterDescendantsInstances = { localPlayer.Character }
        end
        local res = workspace:Raycast(ray.Origin, ray.Direction * 500, rayParams)
        if res and res.Instance then
            for _, d in ipairs(res.Instance:GetDescendants()) do
                if d:IsA("ClickDetector") and fireclickdetector then
                    pcall(function() fireclickdetector(d) end)
                elseif d:IsA("ProximityPrompt") and fireproximityprompt then
                    pcall(function() fireproximityprompt(d) end)
                end
            end
            local parentModel = res.Instance:FindFirstAncestorOfClass("Model")
            if parentModel then
                for _, d in ipairs(parentModel:GetDescendants()) do
                    if d:IsA("ClickDetector") and fireclickdetector then
                        pcall(function() fireclickdetector(d) end)
                    end
                end
            end
        end
    end

    if autoDetectEnabled then
        task.delay(0.1, function()
            local data, hitName = detectAtPosition(cx, cy)
            applyDetectedData(data, hitName)
        end)
    else
        statusLbl.Text = string.format("Virtual Click @ (%d, %d)", math.floor(cx), math.floor(cy))
        statusLbl.TextColor3 = Color3.fromRGB(190, 150, 255)
    end
end

