local function getClosestTarget()
    local closestTarget = nil
    local shortestDistance = maxDistance

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and TARGET_NAMES[obj.Name] and obj:FindFirstChild("HumanoidRootPart") then
            local rootPart = obj.HumanoidRootPart
            local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            
            if myRoot then
                local distance = (rootPart.Position - myRoot.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestTarget = rootPart
                end
            end
        end
    end
    return closestTarget
end

local function throwTrap()
    local args = {
        vector.create(-0.7273741960525513, -0.6696033477783203, 0.15019415318965912),
        0.2193500132610401,
        vector.create(-86.34370422363281, 59.35619354248047, 178.98056030273438)
    }
    
    pcall(function()
        ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Knit"):WaitForChild("Services"):WaitForChild("DemonTrapService"):WaitForChild("RF"):WaitForChild("ThrowTrap"):InvokeServer(unpack(args))
    end)
end

-- Fungsi Auto Collect khusus objek bernama "GalaxyStars"
local function getClosestStar()
    local collectiblesFolder = Workspace:FindFirstChild("[DYNAMIC] Collectibles")
    if not collectiblesFolder then return nil end

    local closestStar = nil
    local shortestDistance = math.huge
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

    if not myRoot then return nil end

    for _, star in pairs(collectiblesFolder:GetChildren()) do
        -- Hanya memproses jika nama objek adalah "GalaxyStars"
        if star.Name == "GalaxyStars" then
            local targetPart = star:IsA("Model") and (star.PrimaryPart or star:FindFirstChildWhichIsA("BasePart")) or (star:IsA("BasePart") and star)
            
            if targetPart then
                local distance = (targetPart.Position - myRoot.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    closestStar = targetPart
                end
            end
        end
    end

    return closestStar
end

-- Fungsi untuk Auto Spam Claim ProximityPrompt
local function triggerClaimPrompt()
    pcall(function()
        local promptHolder = Workspace:FindFirstChild("UGC_ClaimingStations (wip : Missing items)")
            and Workspace["UGC_ClaimingStations (wip : Missing items)"]:FindFirstChild("UGC_ClaimingStation_GnusmasHood")
            and Workspace["UGC_ClaimingStations (wip : Missing items)"].UGC_ClaimingStation_GnusmasHood:FindFirstChild("PromptHolder")
        
        if promptHolder then
            for _, descendant in pairs(promptHolder:GetDescendants()) do
                if descendant:IsA("ProximityPrompt") then
                    fireproximityprompt(descendant)
                end
            end
        end
    end)
end

-- Fungsi Mengelola ESP Pumpkin
local function updatePumpkinESP()
    pcall(function()
        local entrance = Workspace:FindFirstChild("1. Entrance")
        if not entrance then return end
        local shatterables = entrance:FindFirstChild("Shatterables")
        if not shatterables then return end
        local pumpkinsFolder = shatterables:FindFirstChild("Pumpkins")
        
        if isPumpkinEspEnabled and pumpkinsFolder then
            for _, pumpkin in pairs(pumpkinsFolder:GetChildren()) do
                if not pumpkinHighlights[pumpkin] then
                    local highlight = Instance.new("Highlight")
                    highlight.Adornee = pumpkin
                    highlight.FillColor = Color3.fromRGB(255, 140, 0) -- Warna Oranye Pumpkin
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                    highlight.OutlineTransparency = 0
                    highlight.Parent = pumpkin
                    pumpkinHighlights[pumpkin] = highlight
                end
            end
            
            -- Bersihkan highlight jika objek sudah hilang/dihancurkan
            for pumpkin, highlight in pairs(pumpkinHighlights) do
                if not pumpkin or not pumpkin.Parent then
                    if highlight then highlight:Destroy() end
                    pumpkinHighlights[pumpkin] = nil
                end
            end
        else
            for _, highlight in pairs(pumpkinHighlights) do
                if highlight then highlight:Destroy() end
            end
            pumpkinHighlights = {}
        end
    end)
end

local isTweeningStar = false
RunService.RenderStepped:Connect(function()
    local target = getClosestTarget()
    
    -- Logika Aimbot
    if isEnabled and target then
        camera.CFrame = CFrame.new(camera.CFrame.Position, target.Position)
    end
    
    -- Logika Auto Trap
    if isAutoTrapEnabled and target then
        local currentTime = tick()
        if currentTime - lastTrapTime >= trapCooldown then
            lastTrapTime = currentTime
            throwTrap()
        end
    end

    -- Logika Auto Collect Galaxy Star (Hanya nama "GalaxyStars", Speed 5)
    if isAutoCollectEnabled and not isTweeningStar then
        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local starPart = getClosestStar()

        if myRoot and starPart then
            isTweeningStar = true
            local distance = (starPart.Position - myRoot.Position).Magnitude
            local speed = 16
            local duration = distance / speed

            local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
            local tween = TweenService:Create(myRoot, tweenInfo, {CFrame = starPart.CFrame})
            
            tween:Play()
            tween.Completed:Connect(function()
                isTweeningStar = false
            end)
        end
    end

    -- Logika Auto Spam Claim UGC
    if isAutoClaimEnabled then
        triggerClaimPrompt()
    end
    
    -- Logika Update Pumpkin ESP
    updatePumpkinESP()
end)

