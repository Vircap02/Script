   Name = "LIST ANIMO TARGET", Options = getUniqueSpiritList(), CurrentOption = {"Pilih Animo"}, MultipleOptions = false, Flag = "SpiritDropdown",
   Callback = function(Option)
       selectedSpiritName = Option[1]
       if selectedSpiritName == "Tidak ada Animo di map" or selectedSpiritName == "Pilih Animo" then selectedSpiritName = nil return end
       task.spawn(function()
           while selectedSpiritName == Option[1] do
               local folder = workspace:FindFirstChild("ActiveSpirits")
               local char = lp.Character
               if folder and char and char:FindFirstChild("HumanoidRootPart") then
                   local targetPos = char.HumanoidRootPart.CFrame
