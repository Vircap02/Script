-- FUNCTIONS
local function cleanName(name)
    local base = nil
    if string.find(name, "Color") then base = string.match(name, "^(.*)Color")
    elseif string.find(name, "_Roaming") then base = string.match(name, "^(.*)_Roaming")
    elseif string.find(name, "Sound") then base = string.match(name, "^(.*)Sound") end
    if base then base = string.gsub(base, "[%_%s]+$", "") end
    return base
end

local function isAnomaly(spiritGroup)
    for _, child in pairs(spiritGroup:GetDescendants()) do
        local name = child.Name
        if string.find(name, "Color") or string.find(name, "_Roaming") or string.find(name, "Sound") then return false end
    end
    return true
end

local function getUniqueSpiritList()
    local spirits = {}
    local seenNames = {}
    local folder = workspace:FindFirstChild("ActiveSpirits")
    if folder then
        for _, item in pairs(folder:GetDescendants()) do
            local baseName = cleanName(item.Name)
            if baseName and baseName ~= "" and not seenNames[baseName] then
                table.insert(spirits, baseName)
                seenNames[baseName] = true
            end
        end
    end
    table.sort(spirits)
    if #spirits == 0 then return {"Tidak ada Animo di map"} end
    return spirits
end

local function clearAnomalyESP()
    local folder = workspace:FindFirstChild("ActiveSpirits")
    if folder then
        for _, v in pairs(folder:GetDescendants()) do
            if v.Name == "Anomaly_ESP" then v:Destroy() end
        end
    end
end

