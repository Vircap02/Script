    StatusLabel.Text = "Ditemukan " .. #teleportModels .. " Model | Siap!"
else
    StatusLabel.Text = "⚠️ Model Halloween tidak ditemukan!"
end

-- Fungsi Eksekusi Teleport ke Index Tertentu
local function teleportToIndex(index)
    if #teleportModels == 0 then return end
    if index < 1 or index > #teleportModels then
        StatusLabel.Text = "⚠️ Nomor 1 s.d " .. #teleportModels .. " saja!"
        return
    end
    
    currentIndex = index
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local targetModel = teleportModels[currentIndex]
        local modelCFrame = targetModel:GetPivot()
        
        char.HumanoidRootPart.CFrame = modelCFrame + Vector3.new(0, 3, 0)
        StatusLabel.Text = "Ke: " .. targetModel.Name .. " (" .. currentIndex .. "/" .. #teleportModels .. ")"
        
        currentIndex = currentIndex + 1
        if currentIndex > #teleportModels then
            currentIndex = 1
        end
    end
end

-- Tombol GO TO
GoBtn.MouseButton1Click:Connect(function()
    local inputNumber = tonumber(InputBox.Text)
    if inputNumber then
        teleportToIndex(inputNumber)
    else
        StatusLabel.Text = "⚠️ Masukkan angka valid!"
    end
end)

-- Tombol Manual Next
TeleportBtn.MouseButton1Click:Connect(function()
    if isAutoRunning then return end
    teleportToIndex(currentIndex)
end)

-- Tombol Toggle Auto 3 Detik
ToggleBtn.MouseButton1Click:Connect(function()
    isAutoRunning = not isAutoRunning
    if isAutoRunning then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        ToggleBtn.Text = "⏳ AUTO TELEPORT (ON)"
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        ToggleBtn.Text = "⏳ AUTO TELEPORT (OFF)"
    end
end)

-- Loop Auto Teleport
