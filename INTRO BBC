--// VIRGOBOY ANIMAL THEME LOADING INTRO
--// Letakkan sebagai LocalScript

local TS = game:GetService("TweenService")
local PLRS = game:GetService("Players")
local LP = PLRS.LocalPlayer
local PG = LP:WaitForChild("PlayerGui")

local Gui = Instance.new("ScreenGui")
Gui.Name = "VIRGOBOY_ANIMAL_LOADING"
Gui.IgnoreGuiInset = true
Gui.ResetOnSpawn = false
Gui.DisplayOrder = 9999
Gui.Parent = PG

-- Background Bertema Hutan / Animal (Nuansa Hijau Gelap & Alam)
local Bg = Instance.new("Frame")
Bg.Size = UDim2.new(1,0,1,0)
Bg.BackgroundColor3 = Color3.fromRGB(12, 20, 15)
Bg.BorderSizePixel = 0
Bg.Parent = Gui

-- Efek Jejak Kaki / Hewan Dekorasi di Background
for i = 1, 5 do
    local paw = Instance.new("TextLabel")
    paw.Size = UDim2.new(0, 40, 0, 40)
    paw.Position = UDim2.new(math.random(10, 90)/100, 0, math.random(10, 90)/100, 0)
    paw.BackgroundTransparency = 1
    paw.Text = "🐾"
    paw.TextSize = math.random(20, 35)
    paw.TextTransparency = 0.8
    paw.Parent = Bg
end

-- Title Hewan / Animal Theme
local Title = Instance.new("TextLabel")
Title.AnchorPoint = Vector2.new(0.5,0.5)
Title.Position = UDim2.new(0.5,0,0.38,0)
Title.Size = UDim2.new(0.8,0,0.15,0)
Title.BackgroundTransparency = 1
Title.Text = ""
Title.Font = Enum.Font.GothamBlack
Title.TextScaled = true
Title.TextStrokeTransparency = 0.5
Title.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
Title.Parent = Bg

-- Gradient Hijau-Kuning Alam (Animal Vibe)
local Gradient = Instance.new("UIGradient")
Gradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(100, 255, 150)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 200, 50)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(100, 255, 150))
})
Gradient.Rotation = 45
Gradient.Parent = Title

local Stroke = Instance.new("UIStroke")
Stroke.Color = Color3.fromRGB(50, 150, 80)
Stroke.Thickness = 2.5
Stroke.Transparency = 0.2
Stroke.Parent = Title

-- Loading Text
local Loading = Instance.new("TextLabel")
Loading.AnchorPoint = Vector2.new(0.5,0.5)
Loading.Position = UDim2.new(0.5,0,0.68,0)
Loading.Size = UDim2.new(0.6,0,0.05,0)
Loading.BackgroundTransparency = 1
Loading.Text = "Made By Virgoboy"
Loading.Font = Enum.Font.GothamBold
Loading.TextScaled = true
Loading.TextColor3 = Color3.fromRGB(200, 255, 220)
Loading.Parent = Bg

-- Loading Bar Background
local BarBG = Instance.new("Frame")
BarBG.AnchorPoint = Vector2.new(0.5,0.5)
BarBG.Position = UDim2.new(0.5,0,0.62,0)
BarBG.Size = UDim2.new(0.45,0,0.025,0)
BarBG.BackgroundColor3 = Color3.fromRGB(25, 40, 30)
BarBG.BorderSizePixel = 0
BarBG.Parent = Bg

Instance.new("UICorner",BarBG).CornerRadius = UDim.new(1,0)

local Glow = Instance.new("UIStroke")
Glow.Color = Color3.fromRGB(100, 255, 150)
Glow.Thickness = 2
Glow.Parent = BarBG

-- Progress Bar
local Bar = Instance.new("Frame")
Bar.Size = UDim2.new(0,0,1,0)
Bar.BorderSizePixel = 0
Bar.Parent = BarBG

Instance.new("UICorner",Bar).CornerRadius = UDim.new(1,0)

local BarGradient = Instance.new("UIGradient")
BarGradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(50, 255, 100)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 220, 50)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(50, 255, 100))
})
BarGradient.Parent = Bar

-- Gradient Animation
task.spawn(function()
	while Gui.Parent do
		Gradient.Offset = Vector2.new((tick()*0.3)%1,0)
		BarGradient.Offset = Vector2.new((tick()*0.5)%1,0)
		task.wait()
	end
end)

-- Text Animation
local TextToType = "WONDER CHASE 🐾"
for i = 1, #TextToType do
	Title.Text = TextToType:sub(1,i)
	task.wait(0.12)
end

TS:Create(
	Title,
	TweenInfo.new(0.4,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
	{Size = UDim2.new(0.83,0,0.16,0)}
):Play()

task.wait(0.3)

-- Loading Bar Progress
for i = 1,100 do
	Bar.Size = UDim2.new(i/100,0,1,0)
	Loading.Text = "Loading "..i.."%"
	task.wait(0.02)
end

task.wait(0.4)

-- Fade Out Intro
for _,v in ipairs(Bg:GetDescendants()) do
	if v:IsA("TextLabel") then
		TS:Create(v,TweenInfo.new(1),{TextTransparency=1}):Play()
	elseif v:IsA("Frame") then
		TS:Create(v,TweenInfo.new(1),{BackgroundTransparency=1}):Play()
	elseif v:IsA("UIStroke") then
		TS:Create(v,TweenInfo.new(1),{Transparency=1}):Play()
	end
end
TS:Create(Bg,TweenInfo.new(1),{BackgroundTransparency=1}):Play()
task.wait(1.2)
Gui:Destroy()
