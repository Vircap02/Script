local espCache = {}

local function removeEsp(item)
    if espCache[item] then
        if espCache[item].highlight then espCache[item].highlight:Destroy() end
        if espCache[item].billboard then espCache[item].billboard:Destroy() end
        espCache[item] = nil
    end
end

RunService.RenderStepped:Connect(function()
    local anomaliesFolder = getAnomaliesFolder()

    if not anomaliesFolder then
        anomalyDetailBox.Text = "  [ Folder RuntimeAnomalies Tidak Ada ]"
        for item, _ in pairs(espCache) do
            removeEsp(item)
        end
        return
    end

    local activeItems = {}
    local detailLog = ""
    local count = 0

    for _, item in ipairs(anomaliesFolder:GetChildren()) do
        local primaryPart = nil
        if item:IsA("Model") then
            primaryPart = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart", true)
        elseif item:IsA("BasePart") then
            primaryPart = item
        end

        if primaryPart then
            activeItems[item] = true
            count = count + 1

            if espActive then
                if not espCache[item] then
                    espCache[item] = {}
                    
                    local hl = Instance.new("Highlight")
                    hl.Adornee = item
                    hl.FillColor = Color3.fromRGB(255, 100, 0)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.Parent = CoreGui
                    espCache[item].highlight = hl

                    local bb = Instance.new("BillboardGui")
                    bb.Adornee = primaryPart
                    bb.Size = UDim2.new(0, 150, 0, 40)
                    bb.StudsOffset = Vector3.new(0, 2.5, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = CoreGui

                    local textLabel = Instance.new("TextLabel")
                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
                    textLabel.TextStrokeTransparency = 0
                    textLabel.TextSize = 12
                    textLabel.Font = Enum.Font.GothamBold
                    textLabel.Parent = bb

                    espCache[item].billboard = bb
                    espCache[item].text = textLabel
                end

                local data = espCache[item]
                if data.highlight then data.highlight.Enabled = true end
                if data.billboard and data.text then
                    data.billboard.Enabled = true
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local dist = math.floor((player.Character.HumanoidRootPart.Position - primaryPart.Position).Magnitude)
                        data.text.Text = item.Name .. " [" .. dist .. "m]"
                    end
                end
            else
                removeEsp(item)
            end

            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local dist = math.floor((player.Character.HumanoidRootPart.Position - primaryPart.Position).Magnitude)
                if count <= 4 then
                    detailLog = detailLog .. " • " .. item.Name .. " (" .. dist .. "m)\n"
                end
            end
        end
    end

    if count == 0 then
        anomalyDetailBox.Text = "  Tidak ada anomali terdeteksi."
    else
        if count > 4 then
            anomalyDetailBox.Text = detailLog .. "  ...dan " .. (count - 4) .. " lainnya."
        else
            anomalyDetailBox.Text = detailLog
        end
    end

    for item, data in pairs(espCache) do
        if not activeItems[item] or not item.Parent then
            removeEsp(item)
        end
    end
end)

