task.spawn(function()
    while gui.Parent do
        if autoHalloweenLoopActive then
            pcall(function()
                local folder = getHalloweenFolder()
                local char = player.Character
                local humanoidRootPart = char and char:FindFirstChild("HumanoidRootPart")

                if not folder then
                    halloweenStatusLabel.Text = "Status: Folder koleksi tidak ditemukan!"
                    task.wait(1)
                elseif not humanoidRootPart then
                    halloweenStatusLabel.Text = "Status: Karakter tidak ditemukan!"
                    task.wait(1)
                else
                    local items = folder:GetChildren()
                    if #items == 0 then
                        halloweenStatusLabel.Text = "Status: Semua item habis!"
                        task.wait(1)
                    else
                        local nearestItem = nil
                        local shortestDistance = math.huge
                        local nearestCFrame = nil

                        for _, item in ipairs(items) do
                            if not autoHalloweenLoopActive then break end
                            local cf = getTargetCFrame(item)
                            if cf then
                                local dist = (humanoidRootPart.Position - cf.Position).Magnitude
                                if dist < shortestDistance then
                                    shortestDistance = dist
                                    nearestItem = item
                                    nearestCFrame = cf
                                end
                            end
                        end

                        if nearestItem and nearestCFrame and autoHalloweenLoopActive then
                            humanoidRootPart.CFrame = nearestCFrame + Vector3.new(0, 3, 0)
                            halloweenStatusLabel.Text = "Status: TP ke " .. nearestItem.Name .. " (" .. math.floor(shortestDistance) .. "m)"
                            task.wait(0.3)
                        end
                    end
                end
            end)
        else
            halloweenStatusLabel.Text = "Status: Loop TP Item dalam keadaan OFF."
        end
        task.wait(0.1)
    end
end)

