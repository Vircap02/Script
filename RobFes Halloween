local function getTargetFolder()
    local sys = Workspace:FindFirstChild("System")
    if sys then
        return sys:FindFirstChild("Rewards")
    end
    return nil
end

local function getAnomaliesFolder()
    return Workspace:FindFirstChild("RuntimeAnomalies")
end

local function getHalloweenFolder()
    return Workspace:FindFirstChild("LocalHalloweenCollections")
end

local function getTargetCFrame(item)
    if item:IsA("BasePart") then
        return item.CFrame
    elseif item:IsA("Model") then
        if item.PrimaryPart then
            return item.PrimaryPart.CFrame
        else
            local part = item:FindFirstChildWhichIsA("BasePart", true)
            if part then return part.CFrame end
        end
    end
    return nil
end

-- Fungsi Auto Farm FireTouchInterest khusus model "Candy" langsung di Workspace
local function startCandyFarm()
    task.spawn(function()
        while getgenv().CandyFarmActive do
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local rootPart = character.HumanoidRootPart
                
                -- Melakukan perulangan pada isi Workspace untuk mencari objek bernama "Candy"
                for _, descendant in ipairs(Workspace:GetChildren()) do
                    if not getgenv().CandyFarmActive then break end
                    
                    if string.match(descendant.Name:lower(), "candy") then
                        local targetPart = nil
                        if descendant:IsA("BasePart") then
                            targetPart = descendant
                        elseif descendant:IsA("Model") then
                            targetPart = descendant.PrimaryPart or descendant:FindFirstChildWhichIsA("BasePart", true)
                        end
                        
                        if targetPart and targetPart:FindFirstChild("TouchInterest") then
                            pcall(function()
                                firetouchinterest(rootPart, targetPart, 0)
                                task.wait()
                                firetouchinterest(rootPart, targetPart, 1)
                            end)
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

