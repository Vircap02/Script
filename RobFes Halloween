local function switchTab(activeBtn, activeContainer)
    tab1Container.Visible = (activeContainer == tab1Container)
    tab2Container.Visible = (activeContainer == tab2Container)
    tab3Container.Visible = (activeContainer == tab3Container)
    tabConcertContainer.Visible = (activeContainer == tabConcertContainer)

    local buttons = {tabMainBtn, tabEspBtn, tabItemBtn, tabConcertBtn}
    for _, btn in ipairs(buttons) do
        if btn == activeBtn then
            btn.BackgroundColor3 = Color3.fromRGB(50, 45, 70)
            btn.TextColor3 = Color3.new(1, 1, 1)
        else
            btn.BackgroundColor3 = Color3.fromRGB(30, 28, 38)
            btn.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
    end
end

