-- Khusus Patrol: Mengambil item yang mengandung kata "Candy", "Gift", ATAU "Pumpkin"
local function processPatrolItems(folder)
    if not folder then return end
    local character = localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, prompt in ipairs(folder:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
            local parent = prompt.Parent
            local promptName = prompt.Name:lower()
            local parentName = parent.Name:lower()

            if promptName:find("candy") or parentName:find("candy") or 
               promptName:find("gift") or parentName:find("gift") or 
               promptName:find("pumpkin") or parentName:find("pumpkin") then
               
                local targetCFrame = parent:IsA("BasePart") and parent.CFrame or (parent:IsA("Model") and parent:GetPivot())

                if targetCFrame then
                    -- Bergerak menggunakan Tween kecepatan normal
                    tweenToTarget(hrp, targetCFrame * CFrame.new(0, 2.5, 0))
                    task.wait(0.1)

                    if fireproximityprompt then
                        fireproximityprompt(prompt)
                    else
                        prompt:InputHoldBegin()
                        task.wait(prompt.HoldDuration + 0.05)
                        prompt:InputHoldEnd()
                    end
                    
                    -- Jeda 2 detik setelah selesai memproses 1 item
                    task.wait(2.0)
                end
            end
        end
    end
end

