local function updateEspHighlights()
	if not EspEnabled then
		clearEsp()
		return
	end

	local _, allowedSet = getActivePartsList()
	local espParent = getEspParent()
	local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local originPos = hrp and hrp.Position or Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position
	local seen = {}

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if allowedSet[obj.Name] then
			local adornee = getEspAdornee(obj)
			if adornee and obj:IsDescendantOf(Workspace) then
				seen[obj] = true
				local entry = espEntries[obj]
				if not entry then
					entry = {}
					espEntries[obj] = entry
				end

				if not entry.highlight or not entry.highlight.Parent then
					local ok, created = pcall(function()
						local h = Instance.new("Highlight")
						h.Name = "ScavengerEspBox"
						h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						h.FillTransparency = 0.55
						h.OutlineTransparency = 0
						h.Adornee = adornee
						h.Parent = espParent
						return h
					end)
					if ok and created then
						entry.highlight = created
					end
				end

				if not entry.billboard or not entry.billboard.Parent or not entry.label or not entry.label.Parent then
					local bb, lbl = createBillboardForAdornee(adornee, espParent)
					entry.billboard = bb
					entry.label = lbl
				end

				local active = isItemActiveInMap(obj)
				local col = active and ESP_ACTIVE_COLOR or ESP_INACTIVE_COLOR
				local cf = getPivotCFrame(obj)
				local distStuds = (cf and originPos) and math.floor((cf.Position - originPos).Magnitude) or 0
				local shortName = string.gsub(obj.Name, "^StepsScavenger", "")

				if entry.highlight and entry.highlight.Parent then
					pcall(function()
						entry.highlight.Adornee = adornee
						entry.highlight.FillColor = col
						entry.highlight.OutlineColor = col
					end)
				end

				if entry.billboard and entry.billboard.Parent and entry.label and entry.label.Parent then
					pcall(function()
						entry.billboard.Adornee = adornee
						entry.label.TextColor3 = col
						entry.label.Text = string.format("%s [%d stud]", shortName, distStuds)
					end)
				end
			end
		end
	end

	for obj, entry in pairs(espEntries) do
		if not seen[obj] or not obj or not obj.Parent then
			destroyEspEntry(entry)
			espEntries[obj] = nil
		end
	end
end

local function setEspEnabled(state)
	EspEnabled = state
	if EspEnabled then
		updateEspHighlights()
		local elapsed = 0
		espConn = RunService.Heartbeat:Connect(function(dt)
			if not EspEnabled then
				return
			end
			elapsed += dt
			if elapsed >= 0.25 then
				elapsed = 0
				updateEspHighlights()
			end
		end)
	else
		clearEsp()
	end
end

local function triggerInteractionsOn(obj)
	if not AUTO_TRIGGER_PROMPTS or not obj then
		return
	end

	local function fireOnNode(node)
		if node:IsA("ProximityPrompt") and node.Enabled then
			if node.HoldDuration > 0 then
				pcall(function()
					node.HoldDuration = 0
				end)
			end
			if typeof(fireproximityprompt) == "function" then
				pcall(fireproximityprompt, node)
			end
		elseif node:IsA("ClickDetector") and node.MaxActivationDistance > 0 then
			if typeof(fireclickdetector) == "function" then
				pcall(fireclickdetector, node, 0)
			end
		end
	end

	fireOnNode(obj)
	for _, desc in ipairs(obj:GetDescendants()) do
		fireOnNode(desc)
	end
end

local function setRootAtPosition(hrp, targetPos)
	if not hrp or not hrp.Parent then
		return
	end
	local currentLook = hrp.CFrame.LookVector
	local flatLook = Vector3.new(currentLook.X, 0, currentLook.Z)
	if flatLook.Magnitude < 0.01 then
		flatLook = Vector3.new(0, 0, -1)
	else
		flatLook = flatLook.Unit
	end

	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero
	hrp.CFrame = CFrame.lookAt(targetPos, targetPos + flatLook)
end

local function findAllPartsByName(partName, maxLimit)
	if maxLimit and maxLimit <= 0 then
		return {}
	end
	local hrp = getRootPart()
	local origin = hrp and hrp.Position or Vector3.zero
	local list = {}

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj.Name == partName and isItemActiveInMap(obj) then
			local cf = getPivotCFrame(obj)
			if cf then
				table.insert(list, {
					instance = obj,
					cframe = cf,
					dist = (cf.Position - origin).Magnitude,
				})
			end
		end
	end

	table.sort(list, function(a, b)
		return a.dist < b.dist
	end)

	if maxLimit and #list > maxLimit then
		local trimmed = {}
		for i = 1, maxLimit do
			trimmed[i] = list[i]
		end
		return trimmed
	end

	return list
end

local function tpAndWaitCollected(item, isStillValidFn, onStatusFn)
	local obj = item and item.instance
	if not obj or not isItemActiveInMap(obj) then
		return false
	end

	local activeUgc = getActiveUgc()
	local assetId = activeUgc and activeUgc.asset_id or nil
	local startFoundCount = getCollectedCountForUgc(assetId)

	local sinceLast = os.clock() - lastCollectTick
	if sinceLast < PROP_COOLDOWN then
		local waitRemain = PROP_COOLDOWN - sinceLast
		local waitUntil = os.clock() + waitRemain
		while isStillValidFn() and os.clock() < waitUntil do
			if onStatusFn then
				onStatusFn(waitUntil - os.clock(), true)
			end
			RunService.Heartbeat:Wait()
		end
	end

	local startTime = os.clock()
	local lastTrigger = 0
	local collected = false

	while isStillValidFn() do
		if os.clock() - startTime >= COLLECT_TIMEOUT then
			break
		end

		if assetId and getCollectedCountForUgc(assetId) > startFoundCount then
			collected = true
			break
		end

		if not isItemActiveInMap(obj) then
			local graceEnd = os.clock() + 0.35
			while isStillValidFn() and os.clock() < graceEnd do
				if assetId and getCollectedCountForUgc(assetId) > startFoundCount then
					break
				end
				RunService.Heartbeat:Wait()
			end
			collected = true
			break
		end

		local hrp = getRootPart()
		local cf = getPivotCFrame(obj)
		if hrp and cf then
			local goalPos = cf.Position + TP_OFFSET_POS
			if (hrp.Position - goalPos).Magnitude > 0.5 then
				setRootAtPosition(hrp, goalPos)
			else
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
			end

			if os.clock() - lastTrigger >= 0.2 then
				lastTrigger = os.clock()
				triggerInteractionsOn(obj)
			end
		end

		if onStatusFn then
			onStatusFn(math.max(0, COLLECT_TIMEOUT - (os.clock() - startTime)), false)
		end

		RunService.Heartbeat:Wait()
	end

	if collected or (assetId and getCollectedCountForUgc(assetId) > startFoundCount) then
		lastCollectTick = os.clock()
		return true
	end

	return false
end

local function attachGuiToParent(gui)
	local candidates = {}

	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
	if pg then
		table.insert(candidates, pg)
	end

	if typeof(gethui) == "function" then
		local ok, hui = pcall(gethui)
		if ok and typeof(hui) == "Instance" then
			table.insert(candidates, hui)
		end
	end

	local okCore, core = pcall(function()
		return CoreGui
	end)
	if okCore and typeof(core) == "Instance" then
		table.insert(candidates, core)
	end

	for _, targetParent in ipairs(candidates) do
		pcall(function()
			local old = targetParent:FindFirstChild("ScavengerTpGui")
			if old then
				old:Destroy()
			end
		end)

		local okSet = pcall(function()
			gui.Parent = targetParent
		end)
		if okSet and gui.Parent == targetParent then
			attachedParent = targetParent
			return targetParent
		end
	end

	return nil
end

