local function applyHideToInstance(desc)
	if not HidePlayersEnabled or not desc or not desc.Parent then
		return
	end
	if desc:IsA("BasePart") then
		if hiddenPartStates[desc] == nil then
			hiddenPartStates[desc] = {
				Transparency = desc.Transparency,
				LocalTransparencyModifier = desc.LocalTransparencyModifier,
				CastShadow = desc.CastShadow,
			}
		end
		pcall(function()
			desc.Transparency = 1
			desc.LocalTransparencyModifier = 1
			desc.CastShadow = false
		end)
	elseif desc:IsA("Decal") then
		if hiddenDecalStates[desc] == nil then
			hiddenDecalStates[desc] = desc.Transparency
		end
		pcall(function()
			desc.Transparency = 1
		end)
	elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
		if hiddenGuiStates[desc] == nil then
			hiddenGuiStates[desc] = desc.Enabled
		end
		pcall(function()
			desc.Enabled = false
		end)
	end
end

local function hideCharacter(character)
	if not HidePlayersEnabled or not character then
		return
	end
	for _, desc in ipairs(character:GetDescendants()) do
		applyHideToInstance(desc)
	end
	table.insert(playerHookConns, character.DescendantAdded:Connect(function(desc)
		if HidePlayersEnabled then
			applyHideToInstance(desc)
		end
	end))
end

local function hookPlayerForHide(player)
	if player == LocalPlayer then
		return
	end
	if player.Character then
		hideCharacter(player.Character)
	end
	table.insert(playerHookConns, player.CharacterAdded:Connect(function(char)
		if HidePlayersEnabled then
			task.defer(function()
				if HidePlayersEnabled then
					hideCharacter(char)
				end
			end)
		end
	end))
end

local function restoreHiddenPlayers()
	for part, state in pairs(hiddenPartStates) do
		if part and part.Parent then
			pcall(function()
				part.Transparency = state.Transparency
				part.LocalTransparencyModifier = state.LocalTransparencyModifier
				part.CastShadow = state.CastShadow
			end)
		end
		hiddenPartStates[part] = nil
	end

	for decal, origTrans in pairs(hiddenDecalStates) do
		if decal and decal.Parent then
			pcall(function()
				decal.Transparency = origTrans
			end)
		end
		hiddenDecalStates[decal] = nil
	end

	for guiObj, origEnabled in pairs(hiddenGuiStates) do
		if guiObj and guiObj.Parent then
			pcall(function()
				guiObj.Enabled = origEnabled
			end)
		end
		hiddenGuiStates[guiObj] = nil
	end
end

local function disconnectPlayerHooks()
	for _, conn in ipairs(playerHookConns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	table.clear(playerHookConns)
end

local function setHidePlayersEnabled(enabled)
	HidePlayersEnabled = enabled
	disconnectPlayerHooks()

	if HidePlayersEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			hookPlayerForHide(plr)
		end
		table.insert(playerHookConns, Players.PlayerAdded:Connect(function(plr)
			if HidePlayersEnabled then
				hookPlayerForHide(plr)
			end
		end))
	else
		restoreHiddenPlayers()
	end
end

