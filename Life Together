local cachedHuntData = nil
local lastCollectTick = 0

local function getHuntData()
	local attr = Workspace:GetAttribute("StepsScavengerHuntData")
	if typeof(attr) == "string" and attr ~= "" then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, attr)
		if ok and typeof(decoded) == "table" and typeof(decoded.themes) == "table" then
			cachedHuntData = decoded
			return decoded
		end
	end
	if not cachedHuntData then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, FALLBACK_HUNT_JSON)
		if ok and typeof(decoded) == "table" then
			cachedHuntData = decoded
		end
	end
	return cachedHuntData
end

local function safeRequire(pathFn)
	local ok, mod = pcall(pathFn)
	if ok and typeof(mod) == "table" then
		return mod
	end
	return nil
end

local function getQuestClient()
	return safeRequire(function()
		return require(ReplicatedStorage.Modules.Game.BrandIntegrations.Steps.StepsQuestClient)
	end)
end

local function getCoreData()
	return safeRequire(function()
		return require(ReplicatedStorage.Modules.Core.Data)
	end)
end

local function getCollectedCountForUgc(assetId)
	if not assetId then
		return 0
	end
	local questClient = getQuestClient()
	if questClient and typeof(questClient.get_found_count) == "function" then
		local ok, count = pcall(questClient.get_found_count, assetId)
		if ok and typeof(count) == "number" then
			return count
		end
	end

	local dataMod = getCoreData()
	local hunts = dataMod and dataMod.steps_activation and dataMod.steps_activation.scavenger_hunts
	local hunt = hunts and hunts[tostring(assetId)]
	if hunt and typeof(hunt.collected_ids) == "table" then
		local n = 0
		for k, v in pairs(hunt.collected_ids) do
			if v == true then
				n += 1
			end
		end
		return n
	end
	return 0
end

local function getCollectedSetForUgc(assetId)
	local collected = {}
	if not assetId then
		return collected
	end
	local dataMod = getCoreData()
	if dataMod and typeof(dataMod.steps_activation) == "table" then
		local hunts = dataMod.steps_activation.scavenger_hunts
		local hunt = hunts and hunts[tostring(assetId)]
		if hunt and typeof(hunt.collected_ids) == "table" then
			for k, v in pairs(hunt.collected_ids) do
				if v == true then
					collected[tostring(k)] = true
				end
			end
		end
	end
	return collected
end

local function ensureHuntBegun(ugcEntry)
	if not AUTO_BEGIN_HUNT or not ugcEntry or not ugcEntry.asset_id then
		return
	end
	local questClient = getQuestClient()
	if questClient and typeof(questClient.is_hunt_begun) == "function" and typeof(questClient.begin_hunt) == "function" then
		local okBegun, begun = pcall(questClient.is_hunt_begun, ugcEntry.asset_id)
		if okBegun and not begun then
			pcall(questClient.begin_hunt, ugcEntry.asset_id, "scavenger_tp")
		end
	end
end

local function getThemeFilter(ugcEntry)
	if not ugcEntry or not ugcEntry.theme_id then
		return ALL_SCAVENGER_PARTS, ALL_SCAVENGER_SET, nil
	end

	local huntData = getHuntData()
	local themeObj = huntData and huntData.themes and huntData.themes[ugcEntry.theme_id]
	if not themeObj then
		return ALL_SCAVENGER_PARTS, ALL_SCAVENGER_SET, nil
	end

	local collectedIds = getCollectedSetForUgc(ugcEntry.asset_id)
	local remainingByType = {}
	local allowedSet = {}
	local orderedParts = {}

	if typeof(themeObj.props) == "table" then
		for propId, propName in pairs(themeObj.props) do
			if typeof(propName) == "string" and ALL_SCAVENGER_SET[propName] then
				allowedSet[propName] = true
				if not collectedIds[tostring(propId)] then
					remainingByType[propName] = (remainingByType[propName] or 0) + 1
				end
			end
		end
	elseif typeof(themeObj.prop_types) == "table" then
		for propName, info in pairs(themeObj.prop_types) do
			if typeof(propName) == "string" and ALL_SCAVENGER_SET[propName] then
				allowedSet[propName] = true
				remainingByType[propName] = (typeof(info) == "table" and tonumber(info.total)) or 1
			end
		end
	end

	for _, name in ipairs(ALL_SCAVENGER_PARTS) do
		if allowedSet[name] then
			table.insert(orderedParts, name)
		end
	end

	return orderedParts, allowedSet, remainingByType
end

