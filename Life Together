	local hrp = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 10)
	if hrp and hrp.Parent then
		return hrp
	end
	return nil
end

local function getPivotCFrame(obj)
	if not obj or not obj.Parent or not obj:IsDescendantOf(Workspace) then
		return nil
	end

	for _, desc in ipairs(obj:GetDescendants()) do
		if desc:IsA("ProximityPrompt") and desc.Enabled then
			local parent = desc.Parent
			if parent and parent:IsA("BasePart") then
				return parent.CFrame
			elseif parent and parent:IsA("Attachment") then
				return parent.WorldCFrame
			end
		end
	end

	if obj:IsA("BasePart") then
		return obj.CFrame
	elseif obj:IsA("Attachment") then
		return obj.WorldCFrame
	elseif obj:IsA("Model") then
		local ok, cf = pcall(function()
			return obj:GetPivot()
		end)
		if ok and typeof(cf) == "CFrame" then
			return cf
		end
		if obj.PrimaryPart then
			return obj.PrimaryPart.CFrame
		end
		local part = obj:FindFirstChildWhichIsA("BasePart", true)
		if part then
			return part.CFrame
		end
	else
		local part = obj:FindFirstChildWhichIsA("BasePart", true)
		if part then
			return part.CFrame
		end
	end

	return nil
end

local function hasGroundBelow(position, ignoreObj)
	if not REQUIRE_GROUND_BELOW then
		return true
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude

	local filterList = { ignoreObj }
	if LocalPlayer.Character then
		table.insert(filterList, LocalPlayer.Character)
	end
	params.FilterDescendantsInstances = filterList

	local result = Workspace:Raycast(position + Vector3.new(0, 2, 0), Vector3.new(0, -(VOID_RAY_DEPTH + 2), 0), params)
	return result ~= nil and result.Position.Y >= MIN_VALID_Y
end

local function isItemActiveInMap(obj)
	if not obj or not obj.Parent or not obj:IsDescendantOf(Workspace) then
		return false
	end

	local cf = getPivotCFrame(obj)
	if not cf then
		return false
	end

	if cf.Position.Y < MIN_VALID_Y or cf.Position.Y > MAX_VALID_Y then
		return false
	end

	if not hasGroundBelow(cf.Position, obj) then
		return false
	end

	local hasPrompt = false
	for _, desc in ipairs(obj:GetDescendants()) do
		if desc:IsA("ProximityPrompt") then
			hasPrompt = true
			if desc.Enabled then
				return true
			end
		elseif desc:IsA("ClickDetector") then
			if desc.MaxActivationDistance > 0 then
				return true
			end
		end
	end

	if hasPrompt then
		return false
	end

	if obj:IsA("BasePart") then
		return obj.Transparency < 0.95 and obj.Size.Magnitude > 0.05
	end

	for _, desc in ipairs(obj:GetDescendants()) do
		if desc:IsA("BasePart") and desc.Transparency < 0.95 and desc.Size.Magnitude > 0.05 then
			return true
		end
	end

	return false
end

