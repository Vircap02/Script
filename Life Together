local function stopLoop()
	ActiveMode = nil
	ActivePartName = nil
	ActiveIndex = nil
	LoopToken += 1
	refreshButtonHighlights()
	if TitleLabel and TitleLabel.Parent then
		TitleLabel.Text = "Scavenger TP"
	end
end

local function startSingleLoop(idx, partName, shortName)
	local _, allowedSet = getActivePartsList()
	if not allowedSet[partName] then
		if TitleLabel and TitleLabel.Parent then
			TitleLabel.Text = shortName .. " bukan prop tema ini"
		end
		return
	end

	if ActiveMode == "SINGLE" and ActiveIndex == idx then
		stopLoop()
		return
	end

	ActiveMode = "SINGLE"
	ActivePartName = partName
	ActiveIndex = idx
	LoopToken += 1
	local myToken = LoopToken
	ensureHuntBegun(getActiveUgc())
	refreshButtonHighlights()

	local function isValid()
		return ActiveMode == "SINGLE" and ActiveIndex == idx and LoopToken == myToken
	end

	task.spawn(function()
		while isValid() do
			local _, _, currentRem = getActivePartsList()
			local limit = currentRem and (currentRem[partName] or 0) or nil
			local matches = findAllPartsByName(partName, limit)

			if #matches == 0 then
				if TitleLabel and TitleLabel.Parent and isValid() then
					TitleLabel.Text = string.format("#%d %s (0)", idx, shortName)
				end
				RunService.Heartbeat:Wait()
			else
				for i, item in ipairs(matches) do
					if not isValid() then
						break
					end
					if not isItemActiveInMap(item.instance) then
						continue
					end
					tpAndWaitCollected(item, isValid, function(rem, coolingDown)
						if TitleLabel and TitleLabel.Parent and isValid() then
							if coolingDown then
								TitleLabel.Text = string.format("CD %.1fs #%d", rem, idx)
							else
								TitleLabel.Text = string.format("#%d (%d/%d) %.1fs", idx, i, #matches, rem)
							end
						end
					end)
					refreshThemeUi()
				end
			end
		end
	end)
end

local function startAllLoop()
	if ActiveMode == "ALL" then
		stopLoop()
		return
	end

	ActiveMode = "ALL"
	ActivePartName = nil
	ActiveIndex = nil
	LoopToken += 1
	local myToken = LoopToken
	ensureHuntBegun(getActiveUgc())
	refreshButtonHighlights()

	local function isValid()
		return ActiveMode == "ALL" and LoopToken == myToken
	end

	task.spawn(function()
		while isValid() do
			local orderedParts, _, remMap = getActivePartsList()
			for idx, partName in ipairs(orderedParts) do
				if not isValid() then
					break
				end
				local limit = remMap and (remMap[partName] or 0) or nil
				local matches = findAllPartsByName(partName, limit)
				for i, item in ipairs(matches) do
					if not isValid() then
						break
					end
					if not isItemActiveInMap(item.instance) then
						continue
					end
					tpAndWaitCollected(item, isValid, function(rem, coolingDown)
						if TitleLabel and TitleLabel.Parent and isValid() then
							if coolingDown then
								TitleLabel.Text = string.format("CD %.1fs All #%d", rem, idx)
							else
								TitleLabel.Text = string.format("All #%d (%d/%d) %.1fs", idx, i, #matches, rem)
							end
						end
					end)
					refreshThemeUi()
				end
			end
			if isValid() then
				RunService.Heartbeat:Wait()
			end
		end
	end)
end

