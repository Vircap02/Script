    local stageFolder = workspace:FindFirstChild(targetStageName)
    return stageFolder and stageFolder:FindFirstChild("Stations")
end

-- Menjalankan fireproximityprompt pada semua ProximityPrompt di dalam target
local function triggerProximityPrompts(target)
    if not target then return 0 end
    local count = 0
    for _, desc in ipairs(target:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            if fireSinglePrompt(desc) then
                count += 1
            end
        end
    end
    return count
end

-- Helper: Menjalankan prompt pada objek terkunci dengan fallback ke objek lain di container jika penuh/gagal
local function firePromptWithContainerFallback(container, lockedObj, preferredPrompt)
    if preferredPrompt and preferredPrompt.Parent and preferredPrompt.Enabled and not isPromptIndicatingFull(preferredPrompt) then
        if fireSinglePrompt(preferredPrompt) then
            return lockedObj, preferredPrompt
        end
    end

    if lockedObj and lockedObj.Parent then
        local anyObjPrompt = lockedObj:FindFirstChildWhichIsA("ProximityPrompt", true)
        if anyObjPrompt and fireSinglePrompt(anyObjPrompt) then
            return lockedObj, anyObjPrompt
        end
    end

    if container and container.Parent then
        local altObj, altPrompt, altScore = findBestAvailableObjectWithPrompt(container)
        if altObj and altPrompt and altScore > -50 then
            local altCF = getTargetCFrame(altObj)
            if altCF then teleportToCFrame(altCF) end
            task.wait(0.35)
            fireSinglePrompt(altPrompt)
            return altObj, altPrompt
        end
    end

    if preferredPrompt and preferredPrompt.Parent then
        fireSinglePrompt(preferredPrompt)
    elseif lockedObj then
        triggerProximityPrompts(lockedObj)
    end

    return lockedObj, preferredPrompt
end

-- Alur Otomatis Printer (mengikuti selectedStage: Stage1 / Stage2 / Stage3)
local function runPrinterSequence(firstWorkbenchSubName, shelfSubName)
    local startSubName = firstWorkbenchSubName or "KeyAnimationBase"
    local useThreePromptShelfFlow = (shelfSubName ~= nil)
    local activeStage = selectedStage or "Stage1"

    if isRunningPrinterSequence then
        Rayfield:Notify({
            Title = "Sedang Berjalan",
            Content = "Ada sequence yang sedang jalan. Tekan 'Reset / Stop Sequence' dulu jika ingin ganti.",
            Duration = 3,
            Image = 4483362458,
        })
        return
    end

    local stationsFolder = getStationsFolder(activeStage)
    if not stationsFolder then
        Rayfield:Notify({
            Title = "Tidak Ditemukan",
            Content = "workspace." .. activeStage .. ".Stations belum ditemukan.",
            Duration = 4,
            Image = 4483362458,
        })
        return
    end

    printerSequenceToken += 1
    local myToken = printerSequenceToken
    isRunningPrinterSequence = true

    task.spawn(function()
        local ok, err = pcall(function()
            Rayfield:Notify({
                Title = "Minigames Printer (" .. activeStage .. ")",
                Content = "Mulai alur otomatis (" .. startSubName .. ")...",
                Duration = 3,
                Image = 4483362458,
            })

            if not isSequenceTokenActive(myToken) then return end

            -- 1. [Stage].Stations["01_Workbench"].[startSubName / alias] (TP -> 1s -> firepp)
            local workbench = stationsFolder:FindFirstChild("01_Workbench")
            local firstSub = resolveObjectWithAliases(workbench, startSubName, WORKBENCH_ALIASES, false)
            if firstSub then
                local cf1 = getTargetCFrame(firstSub)
                if cf1 then teleportToCFrame(cf1) end
                task.wait(1)
                if not isSequenceTokenActive(myToken) then return end
                triggerProximityPrompts(firstSub)
            end

            -- Tunggu 2 detik
            task.wait(2)
            if not isSequenceTokenActive(myToken) then return end

            -- 2. [Stage].Stations["02_PhotoDesks"] (pilih meja yang tidak penuh / prompt aktif)
            local photoDesks = stationsFolder:FindFirstChild("02_PhotoDesks")
            if photoDesks then
                local lockedPhotoObj, lockedPhotoPrompt = lockOneObjectWithPrompt(photoDesks, 30, myToken)
                if not isSequenceTokenActive(myToken) then return end
                if lockedPhotoObj then
                    local cf2 = getTargetCFrame(lockedPhotoObj)
                    if cf2 then teleportToCFrame(cf2) end
                    task.wait(1)
                    if not isSequenceTokenActive(myToken) then return end
                    lockedPhotoObj, lockedPhotoPrompt = firePromptWithContainerFallback(photoDesks, lockedPhotoObj, lockedPhotoPrompt)

                    -- Tunggu prompt kedua muncul di objek terkunci 02_PhotoDesks
                    local secondPhotoPrompt = waitForNextPromptOnLockedObject(lockedPhotoObj, lockedPhotoPrompt, 30, myToken)
                    if not isSequenceTokenActive(myToken) then return end

                    if useThreePromptShelfFlow then
                        -- Ambil [Stage].Stations["03_ItemShelf"].[shelfSubName / alias] (TP -> 1s -> firepp)
                        local itemShelf = stationsFolder:FindFirstChild("03_ItemShelf")
                        local shelfTarget = resolveObjectWithAliases(itemShelf, shelfSubName, SHELF_ALIASES, false)
                        if shelfTarget then
                            local cfShelf = getTargetCFrame(shelfTarget)
                            if cfShelf then teleportToCFrame(cfShelf) end
                            task.wait(1)
                            if not isSequenceTokenActive(myToken) then return end
                            triggerProximityPrompts(shelfTarget)
                        end

                        -- Balik ke objek 02_PhotoDesks untuk menaruh (TP -> 1s -> firepp)
                        local cfReturn = getTargetCFrame(lockedPhotoObj)
                        if cfReturn then teleportToCFrame(cfReturn) end
                        task.wait(1)
                        if not isSequenceTokenActive(myToken) then return end
                        if secondPhotoPrompt and secondPhotoPrompt.Parent then
                            fireSinglePrompt(secondPhotoPrompt)
                        else
                            triggerProximityPrompts(lockedPhotoObj)
                        end

                        -- Tunggu prompt ke-3 muncul di objek 02_PhotoDesks lalu TP -> 1s -> firepp
                        local thirdPhotoPrompt = waitForNextPromptOnLockedObject(lockedPhotoObj, secondPhotoPrompt, 30, myToken)
                        if not isSequenceTokenActive(myToken) then return end
                        local cfThird = getTargetCFrame(lockedPhotoObj)
                        if cfThird then teleportToCFrame(cfThird) end
                        task.wait(1)
                        if not isSequenceTokenActive(myToken) then return end
                        if thirdPhotoPrompt and thirdPhotoPrompt.Parent then
                            fireSinglePrompt(thirdPhotoPrompt)
                        else
                            triggerProximityPrompts(lockedPhotoObj)
                        end
                    else
                        -- Alur normal (KeyAnimationBase / TimeSheetBase / VideoBase): 2 prompt di 02_PhotoDesks
                        local cf2Again = getTargetCFrame(lockedPhotoObj)
                        if cf2Again then teleportToCFrame(cf2Again) end
                        task.wait(1)
                        if not isSequenceTokenActive(myToken) then return end
                        if secondPhotoPrompt and secondPhotoPrompt.Parent then
                            fireSinglePrompt(secondPhotoPrompt)
                        else
                            triggerProximityPrompts(lockedPhotoObj)
                        end
                    end

                    task.wait(0.3)
                    if not isSequenceTokenActive(myToken) then return end
                end
            end

            -- 3. [Stage].Stations["04_DataPCs"]: pilih objek yang tersedia -> TP -> 1s -> firepp 1 -> tunggu prompt 2 muncul -> TP -> 1s -> firepp 2
            local dataPCs = stationsFolder:FindFirstChild("04_DataPCs")
            if dataPCs then
                local lockedPcObj, lockedPcPrompt = lockOneObjectWithPrompt(dataPCs, 30, myToken)
                if not isSequenceTokenActive(myToken) then return end
                if lockedPcObj then
                    local cf4 = getTargetCFrame(lockedPcObj)
                    if cf4 then teleportToCFrame(cf4) end
                    task.wait(1)
                    if not isSequenceTokenActive(myToken) then return end
                    lockedPcObj, lockedPcPrompt = firePromptWithContainerFallback(dataPCs, lockedPcObj, lockedPcPrompt)

                    local secondPcPrompt = waitForNextPromptOnLockedObject(lockedPcObj, lockedPcPrompt, 30, myToken)
                    if not isSequenceTokenActive(myToken) then return end
                    local cf4Again = getTargetCFrame(lockedPcObj)
                    if cf4Again then teleportToCFrame(cf4Again) end
                    task.wait(1)
                    if not isSequenceTokenActive(myToken) then return end
                    if secondPcPrompt and secondPcPrompt.Parent then
                        fireSinglePrompt(secondPcPrompt)
                    else
                        triggerProximityPrompts(lockedPcObj)
                    end
                    task.wait(0.3)
                    if not isSequenceTokenActive(myToken) then return end
                end
            end

            -- 4. [Stage].Stations["05_CardboardStorage"]: pilih kotak yang tidak penuh/prompt aktif -> TP -> 1s -> firepp
            local cardboardStorage = stationsFolder:FindFirstChild("05_CardboardStorage")
            if cardboardStorage then
                local lockedBoxObj, lockedBoxPrompt = lockOneObjectWithPrompt(cardboardStorage, 30, myToken)
                if not isSequenceTokenActive(myToken) then return end
                if lockedBoxObj then
                    local cf5 = getTargetCFrame(lockedBoxObj)
                    if cf5 then teleportToCFrame(cf5) end
                    task.wait(1)
                    if not isSequenceTokenActive(myToken) then return end
                    firePromptWithContainerFallback(cardboardStorage, lockedBoxObj, lockedBoxPrompt)
                end
            end

            if isSequenceTokenActive(myToken) then
                Rayfield:Notify({
                    Title = "Selesai (" .. activeStage .. ")",
                    Content = "Alur Minigames Printer (" .. startSubName .. ") selesai!",
                    Duration = 4,
                    Image = 4483362458,
                })
            end
        end)

        if printerSequenceToken == myToken then
            isRunningPrinterSequence = false
        end

        if not ok and printerSequenceToken == myToken then
            Rayfield:Notify({
                Title = "Error",
                Content = tostring(err),
                Duration = 5,
                Image = 4483362458,
            })
        end
    end)
end

-- Membaca teks task aktif dari PlayerGui.ArchivePhotographyGameGui.TaskList.Frame
local function getActiveArchiveTaskTexts()
    local tasks = {}
    local playerGui = Player:FindFirstChild("PlayerGui")
    local gui = playerGui and playerGui:FindFirstChild("ArchivePhotographyGameGui")
    local taskList = gui and gui:FindFirstChild("TaskList")
    local frame = taskList and taskList:FindFirstChild("Frame")
    if not frame then return tasks end

    for _, desc in ipairs(frame:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local rawText = tostring(desc.Text or "")
            local cleaned = rawText:gsub("^%s+", ""):gsub("%s+$", "")
            if cleaned ~= "" then
                table.insert(tasks, cleaned)
            end
        end
    end

    return tasks
end

local function buildTaskSnapshotSignature(taskTexts)
    if not taskTexts or #taskTexts == 0 then
        return nil
    end
    return table.concat(taskTexts, " | ")
end

-- Mencocokkan teks task dengan parameter runPrinterSequence(firstWorkbenchSubName, shelfSubName)
local function resolveSequenceFromTaskTexts(taskTexts)
    for _, raw in ipairs(taskTexts) do
        local s = normalizeNameKey(raw)

        if s:find("keyanimation") or s:find("keyanim") then
            return "KeyAnimationBase", nil, raw
        elseif s:find("timesheet") then
            return "TimeSheetBase", nil, raw
        elseif s:find("video") then
            return "VideoBase", nil, raw
        elseif s:find("cel") or s:find("blankpaper") then
            return "CelBase", "BlankPaperBase", raw
        elseif s:find("script") or s:find("clearpanel") then
            return "ScriptBase", "ClearPanelBase", raw
        end
    end

    return nil, nil, nil
end

-- Loop Toggle Auto Task: tunggu task berganti dulu sebelum ambil task penggantinya
local isAutoTaskEnabled = false
local function setAutoTaskEnabled(enabled)
    isAutoTaskEnabled = enabled
    if not enabled then
        lastExecutedTaskSignature = nil
        return
    end

    task.spawn(function()
        while isAutoTaskEnabled do
            if not isRunningPrinterSequence then
                local taskTexts = getActiveArchiveTaskTexts()
                local currentSignature = buildTaskSnapshotSignature(taskTexts)

                if currentSignature then
                    -- Jika task masih sama dengan task terakhir yang sudah dijalankan, tunggu sampai berganti
                    if lastExecutedTaskSignature == nil or currentSignature ~= lastExecutedTaskSignature then
                        local subName, shelfName, matchedText = resolveSequenceFromTaskTexts(taskTexts)

                        if subName then
                            lastExecutedTaskSignature = currentSignature
                            Rayfield:Notify({
                                Title = "Auto Task (" .. tostring(selectedStage) .. ")",
                                Content = "Task baru: " .. tostring(matchedText) .. " -> " .. subName,
                                Duration = 3,
                                Image = 4483362458,
                            })
                            runPrinterSequence(subName, shelfName)

                            while isRunningPrinterSequence and isAutoTaskEnabled do
                                task.wait(0.25)
                            end

                            -- Setelah sequence selesai, perbarui snapshot task agar menunggu pergantian task berikutnya
                            local postTexts = getActiveArchiveTaskTexts()
                            local postSignature = buildTaskSnapshotSignature(postTexts)
                            if postSignature then
                                lastExecutedTaskSignature = postSignature
                            end
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

