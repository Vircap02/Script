-- Helper: Normalisasi string untuk pencocokan nama yang fleksibel
local function normalizeNameKey(str)
    return tostring(str or ""):lower():gsub("[%s_%-]", "")
end

-- Daftar alias untuk antisipasi perubahan nama objek antar Stage / update game
local WORKBENCH_ALIASES = {
    KeyAnimationBase = {"KeyAnimationBase", "KeyAnimBase", "KeyAnimation", "KeyAnim"},
    TimeSheetBase    = {"TimeSheetBase", "TimesheetBase", "TimeSheet", "Timesheet"},
    VideoBase        = {"VideoBase", "Video"},
    CelBase          = {"CelBase", "CelAnimationBase", "CelAnimBase", "CelAnimation", "Cel"},
    ScriptBase       = {"ScriptBase", "Script"},
}

local SHELF_ALIASES = {
    BlankPaperBase = {"BlankPaperBase", "BlankPaper", "PaperBase", "Paper"},
    ClearPanelBase = {"ClearPanelBase", "ClearPanel", "PanelBase", "Panel"},
}

-- Helper: Mencari anak/descendant di container menggunakan nama persis, alias, lalu pencocokan keyword
local function resolveObjectWithAliases(container, preferredName, aliasTable, allowPromptFallback)
    if not container or not preferredName then return nil end

    -- 1. Cek nama persis terlebih dahulu
    local exact = container:FindFirstChild(preferredName)
    if exact then
        return exact
    end

    -- Kumpulkan kandidat alias (ditambah nama asli)
    local candidates = {}
    local seen = {}
    local function addCandidate(nameStr)
        if type(nameStr) == "string" and nameStr ~= "" and not seen[nameStr] then
            seen[nameStr] = true
            table.insert(candidates, nameStr)
        end
    end

    addCandidate(preferredName)
    if aliasTable and aliasTable[preferredName] then
        for _, aliasName in ipairs(aliasTable[preferredName]) do
            addCandidate(aliasName)
        end
    end

    -- 2. Cek alias secara persis maupun dengan normalisasi nama
    for _, cand in ipairs(candidates) do
        local foundExact = container:FindFirstChild(cand)
        if foundExact then
            return foundExact
        end

        local normCand = normalizeNameKey(cand)
        for _, child in ipairs(container:GetChildren()) do
            if normalizeNameKey(child.Name) == normCand then
                return child
            end
        end
    end

    -- 3. Pencocokan kata kunci utama (misalnya "cel" untuk CelBase / CelAnimationBase)
    local stem = normalizeNameKey(preferredName):gsub("base$", ""):gsub("animation$", "")
    if #stem >= 3 then
        for _, child in ipairs(container:GetChildren()) do
            local childNorm = normalizeNameKey(child.Name)
            if childNorm:find(stem, 1, true) then
                return child
            end
        end
    end

    -- 4. Fallback opsional: ambil anak pertama yang memiliki ProximityPrompt
    if allowPromptFallback then
        for _, child in ipairs(container:GetChildren()) do
            if child:FindFirstChildWhichIsA("ProximityPrompt", true) then
                return child
            end
        end
    end

    return nil
end

-- Helper: Mendapatkan CFrame target dari Instance apa pun
local function getTargetCFrame(obj)
    if not obj then return nil end

    if obj:IsA("BasePart") then
        return obj.CFrame + Vector3.new(0, 4, 0)
    elseif obj:IsA("Model") then
        if obj.PrimaryPart then
            return obj.PrimaryPart.CFrame + Vector3.new(0, 4, 0)
        end
        local part = obj:FindFirstChildWhichIsA("BasePart", true)
        if part then
            return part.CFrame + Vector3.new(0, 4, 0)
        end
        return obj:GetPivot() + Vector3.new(0, 4, 0)
    elseif obj:IsA("Folder") then
        local part = obj:FindFirstChildWhichIsA("BasePart", true)
        if part then
            return part.CFrame + Vector3.new(0, 4, 0)
        end
        local model = obj:FindFirstChildWhichIsA("Model", true)
        if model then
            return model:GetPivot() + Vector3.new(0, 4, 0)
        end
    end

    return nil
end

-- Helper: Menjalankan fireproximityprompt pada satu ProximityPrompt
local function fireSinglePrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    local ok = pcall(function()
        prompt.HoldDuration = 0
        prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 100)
        prompt.Enabled = true
        fireproximityprompt(prompt)
    end)
    return ok
end

-- Helper: Mencari SATU objek dan prompt-nya di dalam container
local function findFirstObjectWithPrompt(container)
    if not container then return nil, nil end

    for _, child in ipairs(container:GetChildren()) do
        local prompt = child:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            return child, prompt
        end
    end

    local anyPrompt = container:FindFirstChildWhichIsA("ProximityPrompt", true)
    if anyPrompt then
        return anyPrompt.Parent, anyPrompt
    end

    return nil, nil
end

-- Helper: Cek apakah teks prompt mengindikasikan slot sudah penuh / terisi
local function isPromptIndicatingFull(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    local combined = ((tostring(prompt.ActionText or "") .. " " .. tostring(prompt.ObjectText or ""))):lower()
    local fullKeywords = {"full", "occupied", "taken", "has item", "already", "penuh", "terisi"}
    for _, kw in ipairs(fullKeywords) do
        if combined:find(kw, 1, true) then
            return true
        end
    end
    return false
end

-- Helper: Menilai kelayakan sebuah objek kandidat di dalam container (mendukung multi-objek seperti 2 Desk / 2 Box)
local function evaluateCandidateObject(obj)
    if not obj then return nil, nil, -999 end

    local bestPrompt = nil
    local bestScore = -999

    -- Cek atribut / nilai boolean umum yang menandakan penuh/terisi jika ada
    local attrOccupied = obj:GetAttribute("Occupied") or obj:GetAttribute("Full") or obj:GetAttribute("HasItem") or obj:GetAttribute("InUse")

    for _, desc in ipairs(obj:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            local score = 0
            if desc.Enabled then
                score += 50
            else
                score -= 40
            end

            if isPromptIndicatingFull(desc) then
                score -= 100
            else
                score += 20
            end

            if attrOccupied == true then
                score -= 80
            end

            if score > bestScore then
                bestScore = score
                bestPrompt = desc
            end
        end
    end

    -- Jika objek itu sendiri punya prompt langsung
    if obj:IsA("ProximityPrompt") then
        local score = obj.Enabled and 50 or -40
        if isPromptIndicatingFull(obj) then
            score -= 100
        else
            score += 20
        end
        if score > bestScore then
            bestScore = score
            bestPrompt = obj
        end
    end

    return obj, bestPrompt, bestScore
end

-- Helper: Mencari objek terbaik yang tersedia di container (prioritas yang kosong/prompt aktif, bukan yang penuh)
local function findBestAvailableObjectWithPrompt(container)
    if not container then return nil, nil, -999 end

    local chosenObj, chosenPrompt, chosenScore = nil, nil, -999

    for _, child in ipairs(container:GetChildren()) do
        local obj, prompt, score = evaluateCandidateObject(child)
        if prompt and score > chosenScore then
            chosenObj = obj
            chosenPrompt = prompt
            chosenScore = score
        end
    end

    if chosenObj and chosenPrompt then
        return chosenObj, chosenPrompt, chosenScore
    end

    for _, desc in ipairs(container:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            local obj = desc.Parent
            local _, prompt, score = evaluateCandidateObject(obj)
            if prompt and score > chosenScore then
                chosenObj = obj
                chosenPrompt = prompt
                chosenScore = score
            end
        end
    end

    return chosenObj, chosenPrompt, chosenScore
end

-- Helper: Mengunci 1 objek terbaik yang tersedia di container (jika semua penuh/belum siap, tunggu sampai ada yang kosong)
local function lockOneObjectWithPrompt(container, timeout, token)
    local maxWait = timeout or 30
    local elapsed = 0
    local fallbackObj, fallbackPrompt

    while elapsed < maxWait do
        if token and not isSequenceTokenActive(token) then
            return nil, nil
        end
        if container and container.Parent then
            local obj, prompt, score = findBestAvailableObjectWithPrompt(container)
            if obj and prompt and prompt.Parent then
                if not fallbackObj then
                    fallbackObj, fallbackPrompt = obj, prompt
                end
                -- Skor >= 60 berarti prompt aktif (Enabled == true) dan tidak terindikasi penuh/terisi
                if score >= 60 and prompt.Enabled then
                    return obj, prompt
                end
            end
        end
        task.wait(0.2)
        elapsed += 0.2
    end

    if token and not isSequenceTokenActive(token) then
        return nil, nil
    end

    local finalObj, finalPrompt = findBestAvailableObjectWithPrompt(container)
    return finalObj or fallbackObj, finalPrompt or fallbackPrompt
end

-- Helper: Menunggu prompt berikutnya pada objek yang sudah dikunci
-- 1) Tunggu prompt sebelumnya benar-benar diproses (hilang / Enabled == false / ActionText berubah)
-- 2) Tunggu sampai prompt berikutnya muncul / Enabled == true kembali
local function waitForNextPromptOnLockedObject(lockedObj, previousPrompt, timeout, token)
    if not lockedObj then return nil end
    local maxWait = timeout or 30
    local oldActionText = previousPrompt and previousPrompt.ActionText or ""

    -- Fase 1: Tunggu prompt sebelumnya masuk masa cooldown/proses (maks 6 detik)
    local sawReset = false
    local phase1Elapsed = 0
    while phase1Elapsed < 6 do
        if token and not isSequenceTokenActive(token) then
            return nil
        end
        if not previousPrompt or not previousPrompt.Parent or not previousPrompt.Enabled then
            sawReset = true
            break
        end
        if previousPrompt.ActionText ~= oldActionText then
            sawReset = true
            break
        end
        local otherPrompt = lockedObj:FindFirstChildWhichIsA("ProximityPrompt", true)
        if otherPrompt and otherPrompt ~= previousPrompt and otherPrompt.Enabled then
            return otherPrompt
        end
        task.wait(0.15)
        phase1Elapsed += 0.15
    end

    -- Jika server tidak pernah menonaktifkan prompt sebelumnya, beri jeda aman sebelum lanjut
    if not sawReset then
        task.wait(1)
    end
    if token and not isSequenceTokenActive(token) then
        return nil
    end

    -- Fase 2: Tunggu sampai prompt berikutnya muncul & aktif kembali pada objek terkunci
    local phase2Elapsed = 0
    while phase2Elapsed < maxWait do
        if token and not isSequenceTokenActive(token) then
            return nil
        end
        for _, desc in ipairs(lockedObj:GetDescendants()) do
            if desc:IsA("ProximityPrompt") and desc.Parent and desc.Enabled then
                return desc
            end
        end
        task.wait(0.2)
        phase2Elapsed += 0.2
    end

    if token and not isSequenceTokenActive(token) then
        return nil
    end
    return lockedObj:FindFirstChildWhichIsA("ProximityPrompt", true)
end

-- Helper: Memindahkan karakter dengan aman
local function teleportToCFrame(targetCF)
    local char = Player.Character or Player.CharacterAdded:Wait()
    local currentRoot = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not currentRoot or not targetCF then return false end

    pcall(function()
        if humanoid and humanoid.Sit then
            humanoid.Sit = false
            task.wait(0.05)
        end
        char:PivotTo(targetCF)
        currentRoot.CFrame = targetCF
        currentRoot.AssemblyLinearVelocity = Vector3.zero
        currentRoot.AssemblyAngularVelocity = Vector3.zero
    end)

    return true
end

