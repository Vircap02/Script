-- Ganti targetContainer sesuai lokasi koin di game (contoh: workspace:FindFirstChild("Coins") atau workspace)
local targetContainer = workspace:FindFirstChild("Coins") or workspace

local running = false
local delayPerPickup = 0 -- Jeda antar koin (sesuaikan agar tidak spam/kick)
local loopDelay = 0    -- Jeda tiap putaran scan

-- Fungsi untuk mengekstrak ID dinamis dari objek koin
local function getCoinId(obj)
	-- Cek apakah namanya sudah berbentuk UUID/ID (36 karakter)
	if #obj.Name == 36 and obj.Name:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then
		return obj.Name
	end

	-- Cek jika ada Value object di dalamnya (misal: Id, CoinId, UUID)
	local idValue = obj:FindFirstChildWhichIsA("StringValue")
	if idValue and idValue.Value ~= "" then
		return idValue.Value
	end

	-- Cek jika ada Attribute bernama Id atau CoinId
	local attrId = obj:GetAttribute("Id") or obj:GetAttribute("CoinId") or obj:GetAttribute("UUID")
	if typeof(attrId) == "string" and attrId ~= "" then
		return attrId
	end

	return nil
end

task.spawn(function()
	while true do
		if running then
			for _, item in ipairs(targetContainer:GetChildren()) do
				if not running then break end

				local coinId = getCoinId(item)
				if coinId then
					pcall(function()
						RequestPickup:FireServer(coinId)
					end)
					task.wait(delayPerPickup)
				end
			end
			task.wait(loopDelay)
		else
			task.wait(0.2)
		end
	end
end)

