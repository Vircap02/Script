-- Token pembatalan sequence aktif (naikkan untuk menghentikan sequence yang sedang jalan)
local printerSequenceToken = 0
local isRunningPrinterSequence = false
local lastExecutedTaskSignature = nil

local function isSequenceTokenActive(token)
