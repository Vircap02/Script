--- LOGIKA & ANIMASI INTERAKSI ---

local TweenService = game:GetService("TweenService")
local coordinates = {}
local rawPositions = {} -- Menyimpan data Vector3 murni untuk fungsi teleport

-- Animasi hover tombol
local function setButtonEffects(button, normalColor, hoverColor)
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = hoverColor}):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = normalColor}):Play()
    end)
end

setButtonEffects(closeBtn, Color3.fromRGB(40, 40, 40), Color3.fromRGB(200, 50, 50))
setButtonEffects(markBtn, Color3.fromRGB(0, 136, 255), Color3.fromRGB(0, 110, 210))
setButtonEffects(copyBtn, Color3.fromRGB(40, 40, 40), Color3.fromRGB(30, 45, 55))
setButtonEffects(undoBtn, Color3.fromRGB(40, 40, 40), Color3.fromRGB(50, 40, 30))
setButtonEffects(tpBtn, Color3.fromRGB(40, 40, 40), Color3.fromRGB(45, 30, 55))
setButtonEffects(clearBtn, Color3.fromRGB(40, 40, 40), Color3.fromRGB(50, 30, 30))

-- Fungsi Tutup UI
closeBtn.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

-- Fungsi Ambil Koordinat
markBtn.MouseButton1Click:Connect(function()
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        local pos = hrp.Position
        local formatted = string.format("Vector3.new(%.2f, %.2f, %.2f)", pos.X, pos.Y, pos.Z)
        
        table.insert(coordinates, formatted)
        table.insert(rawPositions, pos)
        textBox.Text = table.concat(coordinates, "\n")
        
        -- Efek flash hijau sukses
        local originalColor = markBtn.BackgroundColor3
        markBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        TweenService:Create(markBtn, TweenInfo.new(0.3), {BackgroundColor3 = originalColor}):Play()
    end
end)

-- Fungsi Copy All ke Clipboard
copyBtn.MouseButton1Click:Connect(function()
    if #coordinates > 0 then
        local allText = table.concat(coordinates, "\n")
        if setclipboard then
            setclipboard(allText)
            local oldText = copyBtn.Text
            copyBtn.Text = "✅ Copied!"
            task.wait(1)
            copyBtn.Text = oldText
        else
            warn("Executor kamu tidak mendukung fungsi setclipboard().")
        end
    end
end)

-- Fungsi Undo / Hapus Koordinat Terakhir
undoBtn.MouseButton1Click:Connect(function()
    if #coordinates > 0 then
        table.remove(coordinates)
        table.remove(rawPositions)
        textBox.Text = table.concat(coordinates, "\n")
    end
end)

-- Fungsi Teleport ke Koordinat Terakhir yang Direkam
tpBtn.MouseButton1Click:Connect(function()
    if #rawPositions > 0 then
        local char = player.Character or player.CharacterAdded:Wait()
        local hrp = char:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            local targetPos = rawPositions[#rawPositions]
            -- Sedikit angkat posisi Y agar tidak nyangkut di dalam lantai/tanah
            hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
            
            -- Efek feedback tombol ungu
            local oldText = tpBtn.Text
            tpBtn.Text = "⚡ Teleported!"
            task.wait(1)
            tpBtn.Text = oldText
        end
    end
end)

-- Fungsi Hapus Semua Log
clearBtn.MouseButton1Click:Connect(function()
    coordinates = {}
    rawPositions = {}
    textBox.Text = ""
end)
