-- Fungsi Ambil Koordinat
markBtn.MouseButton1Click:Connect(function()
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if hrp then
        local pos = hrp.Position
        local formatted = string.format("Vector3.new(%.2f, %.2f, %.2f)", pos.X, pos.Y, pos.Z)
        
        table.insert(coordinates, formatted)
        textBox.Text = table.concat(coordinates, "\n")
        
        -- Efek flash hijau sukses
        local originalColor = markBtn.BackgroundColor3
        markBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        TweenService:Create(markBtn, TweenInfo.new(0.3), {BackgroundColor3 = originalColor}):Play()
    end
end)

