-- Fungsi membuat tombol (mendukung ukuran & posisi custom untuk grid)
local function createActionButton(parent, xPos, yPos, width, height, text, textColor, bgColor)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, width, 0, height)
    btn.Position = UDim2.new(0, xPos, 0, yPos)
    btn.BackgroundColor3 = bgColor or Color3.fromRGB(30, 20, 40)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 9.5
    btn.TextWrapped = true
    btn.TextColor3 = textColor or Color3.fromRGB(255, 200, 100)
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = parent

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    animStroke(btn, 1)
    return btn
end

local function applyToggleVisual(btn, baseLabel, enabled, instant)
    local targetText = baseLabel .. (enabled and "\n[ON]" or "\n[OFF]")
    if baseLabel == "Auto Collect Star" then
        targetText = baseLabel .. (enabled and ": ON" or ": OFF")
    end

    local targetTextColor = enabled and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
    local targetBgColor = enabled and Color3.fromRGB(20, 50, 30) or Color3.fromRGB(30, 20, 40)

    btn.Text = targetText
    btn.TextColor3 = targetTextColor
    if instant then
        btn.BackgroundColor3 = targetBgColor
    else
        tweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = targetBgColor}):Play()
    end
end

local function teleportTo(pos)
    pcall(function()
        local char = localPlayer.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        if rootPart then
            rootPart.CFrame = CFrame.new(pos)
        end
    end)
end

local function safeFireTouch(rootPart, targetPart)
    if not rootPart or not targetPart or not targetPart:IsA("BasePart") then return end
    if localPlayer.Character and targetPart:IsDescendantOf(localPlayer.Character) then return end
    pcall(function()
        firetouchinterest(rootPart, targetPart, 0)
        task.wait()
        firetouchinterest(rootPart, targetPart, 1)
    end)
end

