-- Fungsi Pendeteksi Phase / Stage dari game
local function getCurrentPhase()
    for _, guiObj in ipairs(players.LocalPlayer.PlayerGui:GetDescendants()) do
        if guiObj:IsA("TextLabel") or guiObj:IsA("TextButton") then
            local text = guiObj.Text:lower()
            if text:find("phase") or text:find("stage") or text:find("floor") or text:find("level") then
                for num in text:gmatch("%d+") do
                    local n = tonumber(num)
                    if n and n > 0 and n <= 100 then
                        return n
                    end
                end
            end
        end
    end
    return 1
end

-- Fungsi Pendeteksi Timer dari game
local function getGameTimer()
    for _, guiObj in ipairs(players.LocalPlayer.PlayerGui:GetDescendants()) do
        if guiObj:IsA("TextLabel") or guiObj:IsA("TextButton") then
            local text = guiObj.Text
            -- Mencari format timer seperti "01:30", "12:05", atau mengandung kata "time" / ":"
            if (text:find(":") and text:len() <= 8) or text:lower():find("time") then
                if text:find(":") then
                    return text
                end
            end
        end
    end
    return "N/A"
end

local currentStatusMessage = "Menunggu tombol Start..."

local function updateDisplayLog(actionMsg)
    if actionMsg then
        currentStatusMessage = actionMsg
    end
    local p = getCurrentPhase()
    local t = getGameTimer()
    logText.Text = string.format("Phase: %d | Timer: %s\nStatus: %s", p, t, currentStatusMessage)
end

