autoPlayEnabled = false

local function startAutoPlay()
    task.spawn(function()
        while autoPlayEnabled do
            local currentPhase = getCurrentPhase()
            local targetMaxPhase = getMaxPhase()

            if currentPhase >= targetMaxPhase then
                autoPlayBtn.Text = "🛑 Target Phase Tercapai!"
                updateDisplayLog("Target Phase " .. targetMaxPhase .. " tercapai! Auto Rejoin...")
                triggerAutoRejoin()
                break
            end

            local player = players.LocalPlayer
            local character = player.Character or player.CharacterAdded:Wait()
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            
            if not rootPart then 
                updateDisplayLog("Warning: HumanoidRootPart tidak ada!")
                task.wait(1)
                continue 
            end

            local activeAreaParent = nil

            autoPlayBtn.Text = "🔄 Auto Play: Key ➔ Padlock..."
            local working = true
            while autoPlayEnabled and working do
                working = false
                local targetKey, targetKeyPrompt = nil, nil

                -- 1. Raycast / Cari Key Aktif (_Key)
                for _, descendant in ipairs(workspace:GetDescendants()) do
                    if string.match(descendant.Name, "_Key") then
                        local prompt = descendant:FindFirstChildOfClass("ProximityPrompt")
                        if prompt and prompt.Enabled then
                            targetKey = descendant
                            targetKeyPrompt = prompt
                            activeAreaParent = descendant.Parent
                            break
                        end
                    end
                end

                if targetKey and targetKeyPrompt then
                    local targetCFrame
                    pcall(function()
                        targetCFrame = targetKey:IsA("Model") and targetKey:GetPivot() or targetKey.CFrame
                    end)

                    if targetCFrame then
                        autoPlayBtn.Text = "🔑 Mengambil Key..."
                        updateDisplayLog("Menemukan Key di '" .. targetKey.Name .. "'. Bergerak...")
                        safeDistanceTween(targetCFrame + Vector3.new(0, 3, 0))
                        
                        targetKeyPrompt.HoldDuration = 0
                        local timeout = tick()
                        while autoPlayEnabled and targetKey and targetKey.Parent and targetKeyPrompt.Enabled and (tick() - timeout < 5) do
                            pcall(function()
                                fireproximityprompt(targetKeyPrompt)
                            end)
                            task.wait(0.15)
                        end
                        updateDisplayLog("Key diambil. Mencari Padlock...")
                    end
                end

                if not autoPlayEnabled then break end

                -- 2. Raycast / Cari Padlock Pasangannya (_Padlock)
                local targetCage, targetCagePrompt = nil, nil
                for _, descendant in ipairs(workspace:GetDescendants()) do
                    if string.match(descendant.Name, "_Padlock") then
                        local prompt = descendant:FindFirstChildOfClass("ProximityPrompt")
                        if prompt and prompt.Enabled then
                            targetCage = descendant
                            targetCagePrompt = prompt
                            if not activeAreaParent then
                                activeAreaParent = descendant.Parent
                            end
                            break
                        end
                    end
                end

                if targetCage and targetCagePrompt then
                    working = true
                    local targetCFrame
                    pcall(function()
                        targetCFrame = targetCage:IsA("Model") and targetCage:GetPivot() or targetCage.CFrame
                    end)

                    if targetCFrame then
                        autoPlayBtn.Text = "🔓 Membuka Padlock..."
                        updateDisplayLog("Menemukan Padlock di '" .. targetCage.Name .. "'. Bergerak...")
                        safeDistanceTween(targetCFrame + Vector3.new(0, 3, 0))
                        
                        targetCagePrompt.HoldDuration = 0
                        local timeout = tick()
                        while autoPlayEnabled and targetCage and targetCage.Parent and targetCagePrompt.Enabled and (tick() - timeout < 5) do
                            pcall(function()
                                fireproximityprompt(targetCagePrompt)
                            end)
                            task.wait(0.15)
                        end
                        updateDisplayLog("Padlock terbuka.")
                    end
                end
                
                task.wait(0.2)
            end

            if not autoPlayEnabled then break end

            if getCurrentPhase() >= getMaxPhase() then
                triggerAutoRejoin()
                break
            end

            -- 3. Raycast / Menuju ExitPortal
            autoPlayBtn.Text = "🚪 Menuju ExitPortal..."
            updateDisplayLog("Semua Key & Padlock bersih. Menuju ExitPortal...")
            local targetExit = nil

            if activeAreaParent then
                for _, child in ipairs(activeAreaParent:GetChildren()) do
                    if string.match(child.Name, "ExitPortal") then
                        targetExit = child
                        break
                    end
                end
            end

            if not targetExit then
                local minDistance = math.huge
                for _, desc in ipairs(workspace:GetDescendants()) do
                    if string.match(desc.Name, "ExitPortal") then
                        local part = desc:IsA("Model") and (desc.PrimaryPart or desc:FindFirstChildWhichIsA("BasePart")) or (desc:IsA("BasePart") and desc)
                        if part then
                            local dist = (rootPart and (rootPart.Position - part.Position).Magnitude) or 0
                            if dist < minDistance then
                                minDistance = dist
                                targetExit = desc
                            end
                        end
                    end
                end
            end

            local exitCFrame = nil
            if targetExit then
                pcall(function()
                    exitCFrame = targetExit:IsA("Model") and targetExit:GetPivot() or targetExit.CFrame
                end)

                if exitCFrame then
                    updateDisplayLog("Menuju ExitPortal di '" .. targetExit.Name .. "'...")
                    safeDistanceTween(exitCFrame + Vector3.new(0, 3, 0))
                end
            end

            -- 4. Menunggu fase/stage berikutnya
            autoPlayBtn.Text = "⏳ Menunggu Fase Berikutnya..."
            updateDisplayLog("Menunggu pergantian phase/stage...")
            local waitingForNextPhase = true
            while autoPlayEnabled and waitingForNextPhase do
                if getCurrentPhase() >= getMaxPhase() then
                    triggerAutoRejoin()
                    break
                end

                for _, d in ipairs(workspace:GetDescendants()) do
                    if string.match(d.Name, "_Key") then
                        local p = d:FindFirstChildOfClass("ProximityPrompt")
                        if p and p.Enabled then
                            waitingForNextPhase = false
                            break
                        end
                    end
                end

                if waitingForNextPhase and exitCFrame and rootPart then
                    if (rootPart.Position - exitCFrame.Position).Magnitude > 5 then
                        pcall(function()
                            safeDistanceTween(exitCFrame + Vector3.new(0, 3, 0))
                        end)
                    end
                end

                task.wait(0.5)
            end
            
            task.wait(0.5)
        end
    end)
end

