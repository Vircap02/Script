-- ==========================================
-- FUNGSI ANTI-CHEAT BYPASS JARAK (STEPPING TWEEN)
-- ==========================================
local function safeDistanceTween(targetCFrame, speed)
    speed = speed or 16 -- Kecepatan standar (Studs per detik)
    local player = game:GetService("Players").LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoidRootPart then return end

    local startPos = humanoidRootPart.Position
    local endPos = targetCFrame.Position
    local totalDistance = (startPos - endPos).Magnitude

    local oldAnchored = humanoidRootPart.Anchored
    humanoidRootPart.Anchored = true

    -- Jika jarak sangat jauh (> 50 studs), pecah jadi beberapa bagian (stepping) untuk bypass anti-cheat jarak
    if totalDistance > 50 then
        local maxStepDistance = 40 -- Maksimal jarak per loncatan agar aman
        local steps = math.ceil(totalDistance / maxStepDistance)
        
        for i = 1, steps do
            local alpha = i / steps
            local intermediatePos = startPos:Lerp(endPos, alpha)
            local intermediateCFrame = CFrame.new(intermediatePos) * (targetCFrame - endPos) -- Pertahankan rotasi target di akhir
            
            local stepDist = (humanoidRootPart.Position - intermediatePos).Magnitude
            local duration = stepDist / speed
            if duration < 0.15 then duration = 0.15 end

            local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
            local tween = tweenService:Create(humanoidRootPart, tweenInfo, {CFrame = intermediateCFrame})
            tween:Play()
            tween.Completed:Wait()
        end
    else
        -- Jika jarak dekat, langsung tween biasa
        local duration = totalDistance / speed
        if duration < 0.2 then duration = 0.2 end

        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
        local tween = tweenService:Create(humanoidRootPart, tweenInfo, {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    end

    humanoidRootPart.Anchored = oldAnchored
end

