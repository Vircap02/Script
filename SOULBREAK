local autoPlayEnabled = false

local function startAutoPlay()
    task.spawn(function()
        while autoPlayEnabled do
            local player = game.Players.LocalPlayer
            local character = player.Character or player.CharacterAdded:Wait()
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            
            if not rootPart then 
                task.wait(1)
                continue 
            end

            local activeAreaParent = nil

            -- Logika Berpasangan: Ambil 1 Key -> Buka 1 Padlock -> Ulangi sampai habis
            autoPlayBtn.Text = "🔄 Auto Play: Key ➔ Padlock..."
            local working = true
            while autoPlayEnabled and working do
                working = false
                local targetKey, targetKeyPrompt = nil, nil

                -- 1. Cari 1 Key yang Aktif
                for _, descendant in ipairs(workspace:GetDescendants()) do
                    if string.match(descendant.Name, "_Key") then
                        local prompt = descendant:FindFirstChildOfClass("ProximityPrompt")
                        if prompt and prompt.Enabled then
                            targetKey = descendant
                            targetKeyPrompt = prompt
                            activeAreaParent = descendant.Parent
                            break
                        end
                    end
                end

                if targetKey and targetKeyPrompt then
                    local targetCFrame
                    pcall(function()
                        targetCFrame = targetKey:IsA("Model") and targetKey:GetPivot() or targetKey.CFrame
                    end)

                    if targetCFrame then
                        autoPlayBtn.Text = "🔑 Menuju & Mengambil Key..."
                        safeDistanceTween(targetCFrame + Vector3.new(0, 3, 0), 16)
                        targetKeyPrompt.HoldDuration = 0
                        task.wait(0.1)
                        pcall(function() fireproximityprompt(targetKeyPrompt) end)

                        local timeout = tick()
                        while autoPlayEnabled and targetKey and targetKey.Parent and targetKeyPrompt.Enabled and (tick() - timeout < 5) do
                            pcall(function() fireproximityprompt(targetKeyPrompt) end)
                            task.wait(0.4)
                        end
                    end
                end

                if not autoPlayEnabled then break end

                -- 2. Setelah Key diambil, langsung cari & buka 1 Padlock pasangannya
                local targetCage, targetCagePrompt = nil, nil
                for _, descendant in ipairs(workspace:GetDescendants()) do
                    if string.match(descendant.Name, "_Padlock") then
                        local prompt = descendant:FindFirstChildOfClass("ProximityPrompt")
                        if prompt and prompt.Enabled then
                            targetCage = descendant
                            targetCagePrompt = prompt
                            if not activeAreaParent then
                                activeAreaParent = descendant.Parent
                            end
                            break
                        end
                    end
                end

                if targetCage and targetCagePrompt then
                    working = true -- Tandai bahwa pasangan key-padlock masih ditemukan dan dikerjakan
                    local targetCFrame
                    pcall(function()
                        targetCFrame = targetCage:IsA("Model") and targetCage:GetPivot() or targetCage.CFrame
                    end)

                    if targetCFrame then
                        autoPlayBtn.Text = "🔓 Menuju & Membuka Padlock..."
                        safeDistanceTween(targetCFrame + Vector3.new(0, 3, 0), 16)
                        targetCagePrompt.HoldDuration = 0
                        task.wait(0.1)
                        pcall(function() fireproximityprompt(targetCagePrompt) end)

                        local timeout = tick()
                        while autoPlayEnabled and targetCage and targetCage.Parent and targetCagePrompt.Enabled and (tick() - timeout < 5) do
                            pcall(function() fireproximityprompt(targetCagePrompt) end)
                            task.wait(0.4)
                        end
                    end
                end
                
                task.wait(0.2)
            end

            if not autoPlayEnabled then break end

            -- 3. Pergi ke ExitPortal setelah semua Key & Padlock bersih
            autoPlayBtn.Text = "🚪 Menuju ExitPortal..."
            local targetExit = nil

            if activeAreaParent then
                for _, child in ipairs(activeAreaParent:GetChildren()) do
                    if string.match(child.Name, "ExitPortal") then
                        targetExit = child
                        break
                    end
                end
            end

            if not targetExit then
                local minDistance = math.huge
                for _, desc in ipairs(workspace:GetDescendants()) do
                    if string.match(desc.Name, "ExitPortal") then
                        local part = desc:IsA("Model") and (desc.PrimaryPart or desc:FindFirstChildWhichIsA("BasePart")) or (desc:IsA("BasePart") and desc)
                        if part then
                            local dist = (rootPart and (rootPart.Position - part.Position).Magnitude) or 0
                            if dist < minDistance then
                                minDistance = dist
                                targetExit = desc
                            end
                        end
                    end
                end
            end

            local exitCFrame = nil
            if targetExit then
                pcall(function()
                    exitCFrame = targetExit:IsA("Model") and targetExit:GetPivot() or targetExit.CFrame
                end)

                if exitCFrame then
                    safeDistanceTween(exitCFrame + Vector3.new(0, 3, 0), 16)
                end
            end

            -- 4. Menunggu fase berikutnya
            autoPlayBtn.Text = "⏳ Menunggu Fase Berikutnya..."
            local waitingForNextPhase = true
            while autoPlayEnabled and waitingForNextPhase do
                for _, d in ipairs(workspace:GetDescendants()) do
                    if string.match(d.Name, "_Key") then
                        local p = d:FindFirstChildOfClass("ProximityPrompt")
                        if p and p.Enabled then
                            waitingForNextPhase = false
                            break
                        end
                    end
                end

                if waitingForNextPhase and exitCFrame and rootPart then
                    if (rootPart.Position - exitCFrame.Position).Magnitude > 5 then
                        pcall(function()
                            safeDistanceTween(exitCFrame + Vector3.new(0, 3, 0), 16)
                        end)
                    end
                end

                task.wait(0.5)
            end
            
            task.wait(0.5)
        end
    end)
end

