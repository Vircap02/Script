local response = game:HttpGet("https://raw.githubusercontent.com/Religius-Star/Main/refs/heads/main/ui%20libary/arod.luau", true)
local arod = loadstring(response)()
local response2 = game:HttpGet("https://raw.githubusercontent.com/Mainery-foxxie/Main/refs/heads/main/UI%20Libary/Kawai%20Lib/Source.lua", true)
local Kawai20Lib = loadstring(response2)()

local Window = arod:CreateWindow("Auto Refund", "refresh-cw")
Window:Section("Auto Refund")
Window:Label("Automatically declines purchase prompts and shows item details.")
Window:Label("No Robux or gems are spent – just snipes and refunds.")

getgenv().AutoRefundV2 = false

Window:Toggle("Enable Auto Refund", false, function(arg)
	getgenv().AutoRefundV2 = arg

	if arg then
		Kawai20Lib.Notify({
			Title = "Auto Refund",
			Desc = "Enabled – purchases will be auto-declined",
			Color = { Color3.fromRGB(255, 105, 180), Color3.fromRGB(128, 0, 128) },
			Duration = 3,
			Icon = "128092559044681",
			Type = "success"
		})
	else
		Kawai20Lib.Notify({
			Title = "Auto Refund",
			Desc = "Disabled – purchases will proceed normally",
			Color = { Color3.fromRGB(255, 105, 180), Color3.fromRGB(128, 0, 128) },
			Duration = 3,
			Icon = "128092559044681",
			Type = "warning"
		})
	end
end)

Window:Section("Credits")
Window:Label("Skid by Virgoboy")
arod:Start()

