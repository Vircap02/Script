-- Helper untuk mendeteksi currency / token di dalam leaderstats map
local function getCurrencyStatus()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in ipairs(leaderstats:GetChildren()) do
            if stat:IsA("IntValue") or stat:IsA("NumberValue") then
                return stat.Name .. ": " .. tostring(stat.Value)
            end
        end
    end
    return nil
end

-- Otomatis Berjalan di Belakang Layar (Background Auto-Refund & Currency Checker)
MarketplaceService.PromptPurchaseRequestedV2:Connect(function(player, assetId, isRequirement, equipIfPurchased)
    if player == LocalPlayer then
        -- Paksa batalkan transaksi berulang kali secara instan di background
        task.spawn(function()
            for i = 1, 10 do
                MarketplaceService:SignalPromptPurchaseFinished(player, assetId, false)
                task.wait(0.02)
            end
        end)
        
        -- Ambil info detail item
        local itemName = "Unknown Item"
        local rawIconId = nil
        pcall(function()
            local info = MarketplaceService:GetProductInfo(assetId, Enum.InfoType.Asset)
            if info then
                itemName = info.Name or "Unknown Item"
                if info.IconImageAssetId and info.IconImageAssetId > 0 then
                    rawIconId = info.IconImageAssetId
                end
            end
        end)
        
        task.wait(0.3)
        local currStatus = getCurrencyStatus()
        local currText = currStatus and ("Currency (" .. currStatus .. ") - Safe") or "Balance Protected & Refunded"

        CustomNotify("Refund Success!", "Item: " .. tostring(itemName), "ID: " .. tostring(assetId), rawIconId, currText, false)
    end
end)
