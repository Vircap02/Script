-- 0. Auto Teleport ke Koordinat Saat Executed & Penjaga Posisi
task.spawn(function()
    task.wait(1) -- Tunggu karakter selesai loading awal
    pcall(function()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local rootPart = character:WaitForChild("HumanoidRootPart", 5)
        if rootPart then
            rootPart.CFrame = CFrame.new(TARGET_POSITION)
        end
    end)

    -- Loop penjaga posisi (jika jarak terlalu jauh, kembalikan posisi)
    while true do
        if masterEnabled then
            pcall(function()
                local character = LocalPlayer.Character
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                if rootPart then
                    local distance = (rootPart.Position - TARGET_POSITION).Magnitude
                    if distance > MAX_DISTANCE then
                        rootPart.CFrame = CFrame.new(TARGET_POSITION)
                    end
                end
            end)
        end
        task.wait(1)
    end
end)

-- 1. Auto Free Rewards
task.spawn(function()
    local freeRewardsList = {"RopeReward", "GlasBridgeReward", "ObbyReward", "AnimalReward"}
    while true do
        if masterEnabled and FreeRemote then
            for _, rewardName in ipairs(freeRewardsList) do
                if not masterEnabled then break end
                pcall(function() FreeRemote:InvokeServer(rewardName) end)
                task.wait(0.1)
            end
        end
        task.wait(1)
    end
end)

-- 2. Auto Playtime Rewards
task.spawn(function()
    local maxRewards = 12
    while true do
        if masterEnabled and PlaytimeRemote then
            for i = 1, maxRewards do
                if not masterEnabled then break end
                pcall(function()
                    PlaytimeRemote:InvokeServer(i)
                end)
                task.wait(0.15)
            end
        end
        task.wait(5)
    end
end)

-- 3. Auto Touch Interests (Tanpa Teleport)
local fireTouch = firetouchinterests or firetouchinterest or (syn and syn.firetouchinterests)
task.spawn(function()
    while true do
        if masterEnabled then
            local rewardsFolder = workspace:FindFirstChild("Rewards")
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")

            if rewardsFolder and rootPart then
                for _, part in ipairs(rewardsFolder:GetChildren()) do
                    if not masterEnabled then break end
                    if part:IsA("BasePart") then
                        pcall(function()
                            if fireTouch then
                                fireTouch(rootPart, part, 0)
                                task.wait(0.01)
                                fireTouch(rootPart, part, 1)
                            elseif part:FindFirstChildOfClass("TouchInterest") and firetouchinterest then
                                firetouchinterest(rootPart, part, 0)
                                firetouchinterest(rootPart, part, 1)
                            else
                                for _, conn in pairs(getconnections(part.Touched)) do
                                    conn:Fire(rootPart)
                                end
                            end
                        end)
                    end
                end
            end
        end
        task.wait(0.3)
    end
end)

-- 4. Anti-Fling
RunService.Stepped:Connect(function()
    if masterEnabled then
        pcall(function()
            local character = LocalPlayer.Character
            if character then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        if part.AssemblyLinearVelocity.Magnitude > 100 or part.AssemblyAngularVelocity.Magnitude > 100 then
                            part.AssemblyLinearVelocity = Vector3.zero
                            part.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end
            end
        end)
    end
end)

-- 5. Auto Steal / Anti-Steal Logic
RunService.Stepped:Connect(function()
    if masterEnabled then
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetChildren()) do
                    if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                        part.CanTouch = false
                    end
                end
            end
        end)
    end
end)

