-- Sistem File Config (Agar tersimpan permanen di folder executor)
local CONFIG_FILE = "AutoHubConfig.json"
local configData = {
    autoExecute = false,
    rejoinMinutes = 90
}

-- Load Config jika filenya sudah ada
if writefile and readfile and isfile and isfile(CONFIG_FILE) then
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if success and type(decoded) == "table" then
        if decoded.autoExecute ~= nil then configData.autoExecute = decoded.autoExecute end
        if decoded.rejoinMinutes ~= nil then configData.rejoinMinutes = decoded.rejoinMinutes end
    end
end

-- Fungsi untuk menyimpan config ke file
local function saveConfig()
    if writefile then
        pcall(function()
            writefile(CONFIG_FILE, HttpService:JSONEncode(configData))
        end)
    end
end

