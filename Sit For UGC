-- 6. Auto Refund Purchase Prompt (Dengan Deteksi Nama Item)
MarketplaceService.PromptPurchaseRequestedV2:Connect(function(player, info)
    if player == LocalPlayer and autoRefundEnabled then
        local assetId = info and info.Id or "Unknown"
        local itemName = "Unknown Item"
        
        pcall(function()
            local productInfo = MarketplaceService:GetProductInfo(assetId)
            if productInfo and productInfo.Name then
                itemName = productInfo.Name
            elseif info and (info.Name or info.Title) then
                itemName = info.Name or info.Title
            end
        end)
        
        showRefundNotification(itemName)
        
        pcall(function()
            MarketplaceService:SignalPromptProductRequestFinished(assetId, Enum.ProductPurchaseDecision.NotProcessedYet)
        end)
    end
end)

