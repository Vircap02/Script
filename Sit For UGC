-- Fungsi Helper untuk Rejoin / Teleport dengan Auto Execute
local function safeTeleport()
    saveConfig() -- Simpan sebelum teleport
    
    if autoExecuteEnabled and queue_on_teleport then
        pcall(function()
            queue_on_teleport([[
                task.wait(3)
                loadstring(game:HttpGet("https://raw.githubusercontent.com/Vircap02/Script/refs/heads/main/Sit%20For%20UGC"))()
            ]])
        end)
    end
    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
end

