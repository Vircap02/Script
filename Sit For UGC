-- Task Countdown Timer 10 Menit (Kembali ke Server yang Sama)
task.spawn(function()
    while timeRemaining > 0 do
        task.wait(1)
        if masterEnabled then
            timeRemaining = timeRemaining - 1
            local minutes = math.floor(timeRemaining / 60)
            local seconds = timeRemaining % 60
            TimerLabel.Text = string.format("<b>Auto Rejoin: %02d:%02d</b>", minutes, seconds)
        end
    end
    
    TimerLabel.Text = "<b>Rejoining...</b>"
    task.wait(1)
    pcall(function()
        if CurrentJobId ~= "" then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, CurrentJobId, LocalPlayer)
        else
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end
    end)
end)

