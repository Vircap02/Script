    and ReplicatedStorage.Packages:WaitForChild("Knit", 5) 
    and ReplicatedStorage.Packages.Knit:WaitForChild("Services", 5)

local FreeRemote = KnitServices and KnitServices:FindFirstChild("RewardService") 
    and KnitServices.RewardService:FindFirstChild("RF") 
    and KnitServices.RewardService.RF:FindFirstChild("ClaimFree")

local PlaytimeRemote = KnitServices and KnitServices:FindFirstChild("PlaytimeService") 
    and KnitServices.PlaytimeService:FindFirstChild("RF") 
    and KnitServices.PlaytimeService.RF:FindFirstChild("Claim")

-- ========================================================
--                    LOGIKA WORKER (MASTER)
-- ========================================================

-- 1. Auto Free Rewards
task.spawn(function()
    local freeRewardsList = {"RopeReward", "GlasBridgeReward", "ObbyReward", "AnimalReward"}
    while true do
        if masterEnabled and FreeRemote then
            for _, rewardName in ipairs(freeRewardsList) do
                if not masterEnabled then break end
                pcall(function() FreeRemote:InvokeServer(rewardName) end)
                task.wait(0.1)
            end
        end
        task.wait(1)
    end
end)

-- 2. Auto Playtime Rewards (Dilengkapi deteksi jika semua selesai langsung Rejoin)
task.spawn(function()
    local maxRewards = 8
    while true do
        if masterEnabled and PlaytimeRemote then
            local allClaimed = true
            
            for i = 1, maxRewards do
                if not masterEnabled then break end
                
                local success, result = pcall(function()
                    return PlaytimeRemote:InvokeServer(i)
                end)
                
                -- Jika ada setidaknya satu reward yang masih bisa di-claim, tandai belum selesai
                if success and result ~= nil then
                    allClaimed = false
                end
                
                task.wait(0.15)
            end
            
            -- Jika semua reward playtime (1 sampai 12) terdeteksi sudah habis/terklaim
            if masterEnabled and allClaimed then
                task.wait(2)
                pcall(function()
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                end)
                break
            end
        end
        task.wait(5)
    end
end)

-- 3. Auto Touch Interests (Tanpa Teleport)
local fireTouch = firetouchinterests or firetouchinterest or (syn and syn.firetouchinterests)
task.spawn(function()
    while true do
        if masterEnabled then
            local rewardsFolder = workspace:FindFirstChild("Rewards")
            local character = LocalPlayer.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")

            if rewardsFolder and rootPart then
                for _, part in ipairs(rewardsFolder:GetChildren()) do
                    if not masterEnabled then break end
                    if part:IsA("BasePart") then
                        pcall(function()
                            if fireTouch then
                                fireTouch(rootPart, part, 0)
                                task.wait(0.01)
                                fireTouch(rootPart, part, 1)
                            elseif part:FindFirstChildOfClass("TouchInterest") and firetouchinterest then
                                firetouchinterest(rootPart, part, 0)
                                firetouchinterest(rootPart, part, 1)
                            else
                                for _, conn in pairs(getconnections(part.Touched)) do
                                    conn:Fire(rootPart)
                                end
                            end
                        end)
                    end
                end
            end
        end
        task.wait(0.3)
    end
end)

-- 4. Anti-Fling (Mencegah Karakter Sendiri Terlempar)
RunService.Stepped:Connect(function()
    if masterEnabled then
        pcall(function()
            local character = LocalPlayer.Character
            if character then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        if part.AssemblyLinearVelocity.Magnitude > 100 or part.AssemblyAngularVelocity.Magnitude > 100 then
                            part.AssemblyLinearVelocity = Vector3.zero
                            part.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end
            end
        end)
    end
end)

-- 5. Auto Refund Purchase Prompt
MarketplaceService.PromptPurchaseRequestedV2:Connect(function(player, info)
    if player == LocalPlayer and masterEnabled then
        local assetId = info and info.Id or "Unknown"
        pcall(function()
            MarketplaceService:SignalPromptProductRequestFinished(assetId, Enum.ProductPurchaseDecision.NotProcessedYet)
        end)
    end
end)

-- 6. Anti-AFK
