		task.spawn(function()
			while autoClaimActive do
				for i = 1, 5 do
					pcall(function()
						event:FireServer("3")
					end)
				end
				task.wait(1)
			end
		end)
	else
		claimBtn.Text = "AUTO THETHING : OFF"
		claimBtn.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
		statusLabel.Text = "Status: Auto TheThing Stopped"
	end
end)

-- Event Tombol Teleport Video Zone
zoneBtn.MouseButton1Click:Connect(function()
	character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then
		statusLabel.Text = "Status: Karakter tidak ditemukan!"
		return
	end
	humanoidRootPart = character.HumanoidRootPart

	local targetZone = zonePaths[currentVideoIndex]
	
	if targetZone and targetZone:IsA("BasePart") then
		humanoidRootPart.CFrame = targetZone.CFrame + Vector3.new(0, 3, 0)
		statusLabel.Text = "Status: TP ke Video " .. currentVideoIndex
		
		currentVideoIndex = currentVideoIndex + 1
		if currentVideoIndex > #zonePaths then
			currentVideoIndex = 1
		end
		
		zoneBtn.Text = "Teleport: Video " .. currentVideoIndex
	else
		statusLabel.Text = "Status: Zone Video " .. currentVideoIndex .. " Error/Hilang!"
	end
end)

-- Event Tombol Once Trigger ProximityPrompt di workspace.MAP
mapPromptBtn.MouseButton1Click:Connect(function()
	local mapFolder = Workspace:FindFirstChild("MAP")
	if mapFolder then
		local count = 0
		for _, descendant in ipairs(mapFolder:GetDescendants()) do
			if descendant:IsA("ProximityPrompt") then
				pcall(function()
					fireproximityprompt(descendant)
				end)
				count = count + 1
			end
		end
		statusLabel.Text = "Status: Fired " .. count .. " Prompts di MAP!"
	else
		statusLabel.Text = "Status: Folder workspace.MAP tidak ada!"
	end
end)

