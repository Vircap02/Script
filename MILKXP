-- Fungsi Fire Remote Tunggal
local function fireClaimRemote(reasonTag)
	local rawArg = ugcInputBox.Text
	if rawArg == "" then return false end
	local finalArg = tonumber(rawArg) or rawArg
	local ok = pcall(function()
		local event = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("TheTHING")
		event:FireServer(finalArg)
	end)
	if ok then
		fireCount += 1
		updateMetaLabel()
		if reasonTag then
			statusLabel.Text = "Status: " .. reasonTag
		end
	end
	return ok
end

-- Helper Deteksi Rarity Legendary / Secret
local TARGET_RARITIES = { "legendary", "secret" }

local function matchesTargetRarity(val)
	if typeof(val) ~= "string" then return false end
	local low = val:lower()
	for _, r in ipairs(TARGET_RARITIES) do
		if low:find(r, 1, true) then
			return true
		end
	end
	return false
end

local function isLegendaryOrSecret(spawnObj, itemObj)
	local targets = { itemObj, spawnObj }

	for _, root in ipairs(targets) do
		if root then
			if matchesTargetRarity(root.Name) then
				return true
			end

			for attrName, attrVal in pairs(root:GetAttributes()) do
				if matchesTargetRarity(tostring(attrName)) or matchesTargetRarity(tostring(attrVal)) then
					return true
				end
			end

			for _, desc in ipairs(root:GetDescendants()) do
				if matchesTargetRarity(desc.Name) then
					return true
				end

				for attrName, attrVal in pairs(desc:GetAttributes()) do
					if matchesTargetRarity(tostring(attrName)) or matchesTargetRarity(tostring(attrVal)) then
						return true
					end
				end

				if desc:IsA("StringValue") and matchesTargetRarity(desc.Value) then
					return true
				elseif desc:IsA("ObjectValue") and desc.Value and matchesTargetRarity(desc.Value.Name) then
					return true
				elseif (desc:IsA("TextLabel") or desc:IsA("TextButton")) and matchesTargetRarity(desc.Text) then
					return true
				end
			end
		end
	end

	return false
end

-- Helper Ambil & Collect Item
local function collectSpawnItem(spawnObj, item, statusMsg)
	local targetPart = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or item

	if targetPart and targetPart:IsA("BasePart") then
		humanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)

		local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true) or spawnObj:FindFirstChildWhichIsA("ProximityPrompt", true)
		if prompt then
			fireproximityprompt(prompt)

			pcall(function()
