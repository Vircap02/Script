		return true
	end

	return false
end

-- ===== SLOT UI INDICATOR PARSER (READ-ONLY) =====
local function isVisibleInCard(obj, cardRoot)
	if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and obj.TextTransparency >= 0.95 then
		return false
	end
	local curr = obj
	while curr and curr ~= cardRoot do
		if curr:IsA("GuiObject") and not curr.Visible then
			return false
		end
		curr = curr.Parent
	end
	return true
end

local function isZeroTimer(str)
	local clean = str:gsub("%s+", "")
	return clean == "00:00:00"
		or clean == "0:00:00"
		or clean == "00:00"
		or clean == "0:00"
		or clean == "0s"
		or clean == "00s"
end

local function isReadyAction(str)
	local low = str:lower()
	return low:find("claim")
		or low:find("get")
		or low:find("free")
		or low:find("buy")
		or low:find("available")
		or low:find("ready")
		or low:find("in stock")
end

local function updateSlotIndicators(slotObj)
	if not slotObj or not slotObj.Parent or not gui.Parent then return end

	local foundTimer = nil
	local foundStock = nil
	local foundStatus = nil
	local statusColor = Color3.fromRGB(240, 240, 250)
	local foundName = nil

	for _, obj in ipairs(slotObj:GetDescendants()) do
		if (obj:IsA("TextLabel") or obj:IsA("TextButton")) and isVisibleInCard(obj, slotObj) then
			local txt = obj.Text:gsub("^%s+", ""):gsub("%s+$", "")
			local low = txt:lower()

			if txt ~= "" then
				if not foundTimer and (txt:match("%d+:%d%d") or txt:match("%d+[hms]%s*%d*[ms]?")) then
					foundTimer = txt
				elseif not foundStock and (
					txt:match("%d+%s*/%s*%d+")
					or low:find("stock")
					or low:find("left")
					or low:find("tersisa")
				) then
					foundStock = txt
				elseif not foundStatus and (low:find("already") or low:find("owned") or low:find("dimiliki")) then
					foundStatus = "ALREADY OWNED"
					statusColor = Color3.fromRGB(235, 75, 75)
				elseif not foundStatus and (low:find("sold") or low:find("out of stock") or low:find("habis")) then
					foundStatus = "SOLD OUT"
					statusColor = Color3.fromRGB(235, 75, 75)
				elseif not foundStatus and isReadyAction(txt) then
					foundStatus = txt:upper()
					statusColor = Color3.fromRGB(60, 205, 125)
				elseif not foundStatus and (low:find("restock") or low:find("soon") or low:find("wait") or low:find("locked") or low:find("coming")) then
					foundStatus = txt:upper()
					statusColor = Color3.fromRGB(255, 165, 55)
				elseif not foundName and #txt >= 3 and not txt:match("^[%d%p%s]+$") then
					foundName = txt
				end
			end
		end
	end

	if foundStock and (foundStock:match("^0%s*/") or foundStock:match("%s0%s*/") or foundStock:lower():find(":%s*0$")) then
		if foundStatus ~= "ALREADY OWNED" then
			foundStatus = "OUT OF STOCK"
			statusColor = Color3.fromRGB(235, 75, 75)
		end
	end

	if not foundStatus and foundTimer then
		foundStatus = isZeroTimer(foundTimer) and "TIMER READY" or "WAITING TIMER"
		statusColor = isZeroTimer(foundTimer) and Color3.fromRGB(60, 205, 125) or Color3.fromRGB(255, 165, 55)
	end

	slotItemLabel.Text = "Item: " .. (foundName or ("Slot #" .. tostring(ugcInputBox.Text)))
	slotStatusLabel.Text = "STATUS: " .. (foundStatus or "STANDBY")
	slotStatusLabel.TextColor3 = foundStatus and statusColor or Color3.fromRGB(100, 175, 255)

	local stockText = foundStock or "-"
	local timerText = foundTimer or "-"
	slotStockTimerLabel.Text = ("STOCK: %s | UI TIMER: %s"):format(stockText, timerText)
end

local function clearSlotConnections()
	for _, conn in ipairs(activeSlotConnections) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(activeSlotConnections)
	hookedCount = 0
end

local function getUgcHolder()
	local pg = player:FindFirstChild("PlayerGui")
	local mainGui = pg and pg:FindFirstChild("Main")
	local menus = mainGui and mainGui:FindFirstChild("Menus")
	local ugc = menus and menus:FindFirstChild("UGC")
	return ugc and ugc:FindFirstChild("Holder")
end

local function getGuiChildren(parent)
	local list = {}
	for _, child in ipairs(parent:GetChildren()) do
		if child:IsA("GuiObject") then
			table.insert(list, child)
		end
	end
	return list
end

local function findTargetSlot(holder, slotId)
	if not holder then return nil, 0 end
	local idx = tonumber(slotId)
	if not idx then return nil, 0 end

	local listContainer = holder
	local holderGuiChildren = getGuiChildren(holder)
	if #holderGuiChildren == 1 then
		local innerChildren = getGuiChildren(holderGuiChildren[1])
		if #innerChildren >= 2 then
			listContainer = holderGuiChildren[1]
		end
	end

	local visibleCards = {}
	for _, child in ipairs(listContainer:GetChildren()) do
		if child:IsA("GuiObject") and child.Visible and not child.Name:lower():find("template") then
			if child.Name == slotId or child.Name:match("^%D*" .. slotId .. "$") then
				return child, #listContainer:GetChildren()
			end
			table.insert(visibleCards, child)
		end
	end

	table.sort(visibleCards, function(a, b)
		if a.LayoutOrder ~= b.LayoutOrder then
			return a.LayoutOrder < b.LayoutOrder
		end
		if math.abs(a.AbsolutePosition.Y - b.AbsolutePosition.Y) > 5 then
			return a.AbsolutePosition.Y < b.AbsolutePosition.Y
		end
		return a.AbsolutePosition.X < b.AbsolutePosition.X
	end)

	return visibleCards[idx], #visibleCards
end

local function bindSlotWatcher()
	clearSlotConnections()
	local slotId = ugcInputBox.Text

	if slotId == "" or not slotId:match("^%d+$") then
		slotHeader.Text = "SLOT MONITOR (NON-NUMERIC ARG)"
		slotItemLabel.Text = "Item: Argumen " .. (slotId ~= "" and slotId or "-")
		slotStatusLabel.Text = "STATUS: CUSTOM ARG MODE"
		slotStatusLabel.TextColor3 = Color3.fromRGB(180, 150, 220)
		slotStockTimerLabel.Text = "STOCK: - | UI TIMER: -"
		updateMetaLabel()
		return
	end

	local holder = getUgcHolder()
	local slotObj, totalCards = findTargetSlot(holder, slotId)

	if not slotObj then
		slotHeader.Text = "SLOT MONITOR • #" .. slotId .. " (0/" .. tostring(totalCards) .. ")"
		slotItemLabel.Text = "Item: Buka menu UGC dulu"
		slotStatusLabel.Text = "STATUS: WAITING UI..."
		slotStatusLabel.TextColor3 = Color3.fromRGB(255, 165, 55)
		slotStockTimerLabel.Text = "STOCK: - | UI TIMER: -"
		updateMetaLabel()
		return
	end

	slotHeader.Text = ("SLOT MONITOR • #%s (%s/%d)"):format(slotId, slotId, totalCards)

	local function hookElement(obj)
		if obj:IsA("TextLabel") or obj:IsA("TextButton") then
			hookedCount += 1
			local conn = obj:GetPropertyChangedSignal("Text"):Connect(function()
				updateSlotIndicators(slotObj)
			end)
			table.insert(activeSlotConnections, conn)
		end

		if obj:IsA("GuiObject") and obj ~= slotObj then
			local visConn = obj:GetPropertyChangedSignal("Visible"):Connect(function()
				updateSlotIndicators(slotObj)
			end)
			table.insert(activeSlotConnections, visConn)
		end
	end

	hookElement(slotObj)
	for _, desc in ipairs(slotObj:GetDescendants()) do
		hookElement(desc)
	end

	local addedConn = slotObj.DescendantAdded:Connect(function(desc)
		hookElement(desc)
		updateMetaLabel()
		updateSlotIndicators(slotObj)
	end)
	table.insert(activeSlotConnections, addedConn)

	updateMetaLabel()
	updateSlotIndicators(slotObj)
end

-- Loop Utama RenderStepped: PinkHeader + Server Time + Pre-Fire 
RunService.RenderStepped:Connect(function()
	if not gui.Parent then return end

	pcall(function()
		local serverNow = Workspace:GetServerTimeNow()
		local currentHourIndex = math.floor(serverNow / 3600)

		if currentHourIndex ~= lastHourIndex then
			lastHourIndex = currentHourIndex
			firedForThisHour = false
		end

		local nextHourTimestamp = (currentHourIndex + 1) * 3600
		local remaining = math.max(0, nextHourTimestamp - serverNow)

		local totalMs = math.floor(remaining * 1000)
		local ms = totalMs % 1000
		local totalSec = math.floor(totalMs / 1000)
		local hours = math.floor(totalSec / 3600)
		local minutes = math.floor((totalSec % 3600) / 60)
		local seconds = totalSec % 60
		local serverCountdown = string.format("%02d:%02d:%02d.%03d", hours, minutes, seconds, ms)

		-- 1. Update tampilan timer visual dari GUI game + server countdown
		local pinkHeader = player:FindFirstChild("PlayerGui")
			and player.PlayerGui:FindFirstChild("Main")
			and player.PlayerGui.Main:FindFirstChild("Menus")
			and player.PlayerGui.Main.Menus:FindFirstChild("UGC")
			and player.PlayerGui.Main.Menus.UGC:FindFirstChild("PinkHeader")

		local uiTimerText = "PinkHeader Tidak Ditemukan"
		if pinkHeader then
			if pinkHeader:IsA("TextLabel") or pinkHeader:IsA("TextBox") or pinkHeader:IsA("TextButton") then
				uiTimerText = pinkHeader.Text
			else
				local txtChild = pinkHeader:FindFirstChildWhichIsA("TextLabel", true)
				uiTimerText = txtChild and txtChild.Text or pinkHeader.Name
			end
		end

		timerDisplay.Text = ("SRV: %s | UI: %s"):format(serverCountdown, uiTimerText)

		-- 2. Logika Pre-Fire Single-Hit per Jam Server
		if autoClaimActive and not firedForThisHour and remaining <= PREFIRE_SEC and remaining > 0 then
			firedForThisHour = true
			local dateTable = os.date("!*t", serverNow)
			fireClaimRemote(("Pre-Fire @ %dms (Jam %02d:00)"):format(math.floor(remaining * 1000), dateTable.hour))
		end
	end)
end)

-- Fungsi Logika Auto Farm Item & OpenBox (Seperti Biasa)
local function startAutoFarm()
	if farmConnection then
		farmConnection:Disconnect()
		farmConnection = nil
	end

	farmConnection = RunService.RenderStepped:Connect(function()
		if not autoFarmActive then return end

		character = player.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then return end
		humanoidRootPart = character.HumanoidRootPart

		local itemSpawns = Workspace:FindFirstChild("ItemSpawns")
		if itemSpawns then
			local foundValidItem = false

			for _, spawnObj in ipairs(itemSpawns:GetChildren()) do
				local item = spawnObj:FindFirstChild("Item")

				if item then
					foundValidItem = true
					if collectSpawnItem(spawnObj, item, "Status: Fired Item & OpenBox") then
						break
					end
				end
			end

			if not foundValidItem and not autoCollectLegSecretActive then
				statusLabel.Text = "Status: Mencari Item..."
			end
		elseif not autoCollectLegSecretActive then
			statusLabel.Text = "Status: ItemSpawns tidak ditemukan!"
		end
	end)
end

