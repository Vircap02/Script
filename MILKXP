-- Fungsi Logika Auto Farm Item & OpenBox
local function startAutoFarm()
	farmConnection = RunService.RenderStepped:Connect(function()
		if not autoFarmActive then return end
		
		character = player.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then return end
		humanoidRootPart = character.HumanoidRootPart

		local itemSpawns = Workspace:FindFirstChild("ItemSpawns")
		if itemSpawns then
			local foundValidItem = false
			
			for _, spawnObj in ipairs(itemSpawns:GetChildren()) do
				local item = spawnObj:FindFirstChild("Item") --[cite: 1]
				
				if item then
					foundValidItem = true
					local targetPart = item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")) or item
					
					if targetPart and targetPart:IsA("BasePart") then
						humanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
						
						local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true) or spawnObj:FindFirstChildWhichIsA("ProximityPrompt", true)
						if prompt then
							fireproximityprompt(prompt)
							
							pcall(function()
								ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("OpenBox"):FireServer()
							end)
							
							statusLabel.Text = "Status: Fired Item & OpenBox"
							task.wait(0.3)
						else
							statusLabel.Text = "Status: Teleported (No Prompt)"
						end
						break 
					end
				end
			end
			
			if not foundValidItem then
				statusLabel.Text = "Status: Mencari Item..."
			end
		else
			statusLabel.Text = "Status: ItemSpawns tidak ditemukan!"
		end
	end)
end

