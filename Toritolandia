local function teleportOnce(cf)
	if TP_MODE == "Camera" then
		local cam = workspace.CurrentCamera
		if cam then
			cam.CameraType = Enum.CameraType.Scriptable
			cam.CFrame = cf
			return true
		end
	else
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = cf + TP_OFFSET
			return true
		end
	end
	return false
end

local function cancelPendingRejoin()
	rejoinGeneration += 1
	waitingAllCollectedRejoin = false
end

local function executeRejoinNow()
	if isRejoining then return end
	isRejoining = true
	cancelPendingRejoin()

	if rejoinBtn then
		rejoinBtn.Text = "REJOINING..."
	end
	if statusLbl then
		statusLbl.Text = "Status: Melakukan rejoin..."
	end

	task.spawn(function()
		local ok, err = pcall(function()
			if game.JobId and game.JobId ~= "" then
				TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
			else
				TeleportService:Teleport(game.PlaceId, player)
			end
		end)

		if not ok then
			warn("[Rejoin] Gagal:", err)
			if statusLbl then
				statusLbl.Text = "Status: Rejoin gagal!"
			end
			if rejoinBtn then
				rejoinBtn.Text = "REJOIN"
			end
			isRejoining = false
		end
	end)
end

local function startRejoinAfterAllCollected()
	if not autoRejoinEnabled or isRejoining or waitingAllCollectedRejoin then return end

	waitingAllCollectedRejoin = true
	rejoinGeneration += 1
	local myGen = rejoinGeneration

	task.spawn(function()
		local settleElapsed = 0
		while settleElapsed < ALL_COLLECTED_SETTLE_TIME do
			if not autoRejoinEnabled or isRejoining or rejoinGeneration ~= myGen then
				waitingAllCollectedRejoin = false
				return
			end
			if #getTargetObjects() > 0 then
				waitingAllCollectedRejoin = false
				return
			end
			if statusLbl then
				statusLbl.Text = "Semua diambil, cek sisa item..."
			end
			local step = math.min(0.1, ALL_COLLECTED_SETTLE_TIME - settleElapsed)
			task.wait(step)
			settleElapsed += step
		end

		local remaining = REJOIN_DELAY
		while remaining > 0 do
			if not autoRejoinEnabled or isRejoining or rejoinGeneration ~= myGen then
				waitingAllCollectedRejoin = false
				return
			end
			if #getTargetObjects() > 0 then
				waitingAllCollectedRejoin = false
				return
			end
			if statusLbl then
				statusLbl.Text = string.format("Habis! Rejoin %.1fs...", remaining)
			end
			local step = math.min(0.1, remaining)
			task.wait(step)
			remaining -= step
		end

		waitingAllCollectedRejoin = false
		if autoRejoinEnabled and not isRejoining and rejoinGeneration == myGen and #getTargetObjects() == 0 then
			executeRejoinNow()
		end
	end)
end

