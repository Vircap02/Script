local function getTargetObjects()
	local camFolder = workspace:FindFirstChild("Camera")
	if not camFolder then return {} end

	local list = {}
	for _, child in ipairs(camFolder:GetChildren()) do
		if child.Name == "ToritoCristal" then
			table.insert(list, child)
		end
	end
	return list
end

local function isInstanceStillPresent(inst, targets)
	if not inst or not inst.Parent then
		return false
	end
	for _, item in ipairs(targets) do
		if item == inst then
			return true
		end
	end
	return false
end

local function getPrimaryTargetObject()
	local targets = getTargetObjects()
	return targets[1]
end

local function runFullScan(root)
	if not root then
		warn("[Scan] workspace.Camera.ToritoCristal tidak ditemukan!")
		return
	end

	local descendants = root:GetDescendants()
	local counts = {}

	print("==========================================")
	print("FULL SCAN:", root:GetFullName())
	print("ClassName:", root.ClassName, "| Total Descendants:", #descendants)
	print("==========================================")

	for _, inst in ipairs(descendants) do
		counts[inst.ClassName] = (counts[inst.ClassName] or 0) + 1

		local extra = ""
		if inst:IsA("BasePart") then
			extra = string.format(
				" | Pos=(%.1f, %.1f, %.1f) Size=(%.1f, %.1f, %.1f) Anchored=%s CanCollide=%s",
				inst.Position.X, inst.Position.Y, inst.Position.Z,
				inst.Size.X, inst.Size.Y, inst.Size.Z,
				tostring(inst.Anchored), tostring(inst.CanCollide)
			)
		elseif inst:IsA("Camera") then
			extra = string.format(
				" | Pos=(%.1f, %.1f, %.1f)",
				inst.CFrame.Position.X, inst.CFrame.Position.Y, inst.CFrame.Position.Z
			)
		elseif inst:IsA("Attachment") then
			extra = string.format(
				" | WorldPos=(%.1f, %.1f, %.1f)",
				inst.WorldPosition.X, inst.WorldPosition.Y, inst.WorldPosition.Z
			)
		end

		print(string.format("[%s] %s%s", inst.ClassName, inst:GetFullName(), extra))
	end

	print("------------------------------------------")
	for className, count in pairs(counts) do
		print(string.format("  - %s: %d", className, count))
	end
	print("==========================================")
end

local function getTargetCFrame(target)
	if not target or not target.Parent then return nil end

	if target:IsA("BasePart") then
		return target.CFrame
	elseif target:IsA("Model") then
		if target.PrimaryPart then
			return target.PrimaryPart.CFrame
		end
		local cf, _ = target:GetBoundingBox()
		return cf
	elseif target:IsA("Attachment") then
		return target.WorldCFrame
	elseif target:IsA("Camera") then
		return target.CFrame
	elseif target:IsA("CFrameValue") then
		return target.Value
	elseif target:IsA("Vector3Value") then
		return CFrame.new(target.Value)
	end

	local part = target:FindFirstChildWhichIsA("BasePart", true)
	return part and part.CFrame or nil
end

local function getAdornee(target)
	if not target or not target.Parent then return nil end
	if target:IsA("BasePart") or target:IsA("Attachment") then
		return target
	elseif target:IsA("Model") then
		return target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
	end
	return target:FindFirstChildWhichIsA("BasePart", true)
end

