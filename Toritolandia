-- Fungsi Toggle Minimize / Restore
minBtn.MouseButton1Click:Connect(function()
	minimized = true
	floatingIcon.Position = main.Position

	local tweenOut = tweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Quint), {
		Size = UDim2.new(0, MINI_W, 0, MINI_H),
		BackgroundTransparency = 1
	})

	tweenOut:Play()
	tweenOut.Completed:Connect(function()
		if minimized then
			main.Visible = false
			floatingIcon.Visible = true
		end
	end)
end)

floatingIcon.MouseButton1Click:Connect(function()
	minimized = false
	main.Position = floatingIcon.Position
	main.Visible = true
	floatingIcon.Visible = false

	main.Size = UDim2.new(0, MINI_W, 0, MINI_H)
	main.BackgroundTransparency = 1

	local tweenIn = tweenService:Create(main, TweenInfo.new(0.3, Enum.EasingStyle.Quint), {
		Size = UDim2.new(0, FULL_W, 0, FULL_H),
		BackgroundTransparency = 0.15
	})
	tweenIn:Play()
end)

-- Sistem Dragging untuk Panel Utama & Pop-up Ikon Kecil
do
	local dragging, dragStart, startPos = false, nil, nil

	local function applyDrag(obj)
		obj.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				local abs = obj.AbsolutePosition
				obj.Position = UDim2.new(0, abs.X, 0, abs.Y)
				dragging = true
				dragStart = i.Position
				startPos = obj.Position
			end
		end)
	end

	applyDrag(main)
	applyDrag(floatingIcon)

	userInputService.InputChanged:Connect(function(i)
		if not dragging then return end
		if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
			local d = i.Position - dragStart
			local vp = workspace.CurrentCamera.ViewportSize
			local targetObj = minimized and floatingIcon or main
			local gs = targetObj.AbsoluteSize

			targetObj.Position = UDim2.new(
				0,
				math.clamp(startPos.X.Offset + d.X, 0, vp.X - gs.X),
				0,
				math.clamp(startPos.Y.Offset + d.Y, 0, vp.Y - gs.Y)
			)
		end
	end)

	userInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

-- ================= LOOP UTAMA =================
local focusedTarget = nil
local teleportedItems = {}
local scannedInstances = {}
local hadTargetPreviously = false

local function attachFocus(target)
	focusedTarget = target

	if target and target.Parent then
		if SCAN_ON_START and not scannedInstances[target] then
			scannedInstances[target] = true
			runFullScan(target)
		end
		if espEnabled then
			setupESP(target)
		else
			clearESP()
		end
	else
		clearESP()
	end
end

local function tryTeleportOnceToFocused(target)
	if not autoTpEnabled or not target or not target.Parent then return false end
	if teleportedItems[target] then return false end

	local cf = getTargetCFrame(target)
	if not cf then return false end

	if teleportOnce(cf) then
		teleportedItems[target] = true
		hasTakenAnyItem = true
		return true
	end
	return false
end

local initialTargets = getTargetObjects()
if #initialTargets > 0 then
	hadTargetPreviously = true
	attachFocus(initialTargets[1])
	tryTeleportOnceToFocused(focusedTarget)
else
	warn("[ToritoCristal] Menunggu objek muncul di workspace.Camera...")
end

runService.Heartbeat:Connect(function()
	if not gui.Parent or isRejoining then return end

	local targets = getTargetObjects()
	local targetCount = #targets

	if targetCount > 0 then
		hadTargetPreviously = true
		cancelPendingRejoin()

		-- Fokus ke 1 item sampai hilang/terambil, baru ganti ke item berikutnya
		if not isInstanceStillPresent(focusedTarget, targets) then
			attachFocus(targets[1])
		elseif espEnabled and not espGui then
			setupESP(focusedTarget)
		end

		-- Hanya TP 1 kali untuk item fokus ini (tidak TP berulang di item yang sama)
		if focusedTarget and not teleportedItems[focusedTarget] then
			tryTeleportOnceToFocused(focusedTarget)
		end

		local cf = getTargetCFrame(focusedTarget)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local refPos = hrp and hrp.Position or (workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position)
		local dist = (cf and refPos) and (cf.Position - refPos).Magnitude or 0
		local tpStateText = teleportedItems[focusedTarget] and "DONE" or (autoTpEnabled and "READY" or "PAUSED")

		statusLbl.Text = string.format("Sisa: %d | Jarak: %.1fm | %s", targetCount, dist, tpStateText)

		if espEnabled and espLabel then
			espLabel.Text = string.format("ToritoCristal [%.1fm]\nTP: %s", dist, tpStateText)
		end
	else
		if focusedTarget ~= nil then
			focusedTarget = nil
			clearESP()
		end

		if hadTargetPreviously and hasTakenAnyItem and autoRejoinEnabled then
			startRejoinAfterAllCollected()
		elseif not waitingAllCollectedRejoin then
			statusLbl.Text = "Status: Menunggu ToritoCristal..."
		end
	end
end)

