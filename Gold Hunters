-- Sistem Auto-Write & Auto-Load Konfigurasi
local configData = {
    beamToggleEnabled = false,
    minimized = false,
    posX = nil,
    posY = nil,
}

local function loadConfig()
    if typeof(isfile) == "function" and typeof(readfile) == "function" then
        local ok, raw = pcall(function()
            if isfile(CONFIG_FILE) then
                return readfile(CONFIG_FILE)
            end
            return nil
        end)
        if ok and type(raw) == "string" and #raw > 0 then
            local decOk, decoded = pcall(function()
                return httpService:JSONDecode(raw)
            end)
            if decOk and type(decoded) == "table" then
                if type(decoded.beamToggleEnabled) == "boolean" then
                    configData.beamToggleEnabled = decoded.beamToggleEnabled
                end
                if type(decoded.minimized) == "boolean" then
                    configData.minimized = decoded.minimized
                end
                if type(decoded.posX) == "number" and type(decoded.posY) == "number" then
                    configData.posX = decoded.posX
                    configData.posY = decoded.posY
                end
            end
        end
    end
end

local function saveConfig()
    if typeof(writefile) ~= "function" then return end
    pcall(function()
        if typeof(makefolder) == "function" and typeof(isfolder) == "function" then
            if not isfolder(CONFIG_FOLDER) then
                makefolder(CONFIG_FOLDER)
            end
        end
        local encoded = httpService:JSONEncode(configData)
        writefile(CONFIG_FILE, encoded)
    end)
end

