-- Fungsi update visual & loop Toggle Location Beam
local function refreshBeamButtonVisual(customStatusText)
    if not beamBtn or not beamBtn.Parent then return end
    if beamToggleEnabled then
        beamBtn.BackgroundColor3 = BEAM_ACTIVE
        beamBtn.Text = customStatusText and string.upper(customStatusText) or "FOCUS BEAM + PROMPT LOOP: ON"
        beamBtn.TextColor3 = Color3.fromRGB(165, 255, 185)
    else
        beamBtn.BackgroundColor3 = BEAM_NORMAL
        beamBtn.Text = customStatusText and string.upper(customStatusText) or "FOCUS BEAM + PROMPT LOOP: OFF"
        beamBtn.TextColor3 = Color3.fromRGB(255, 210, 130)
    end
end

local function startBeamLoop()
    -- Loop fokus 1 target: menembak ProximityPrompt terus sampai hilang, lalu jeda 1 detik sebelum pindah target baru
    task.spawn(function()
        while beamToggleEnabled and not isGuiDestroyed do
            local prevTarget = activeBeamTarget
            local ok, msg, switchedAfterComplete = focusOrAdvanceLocationBeam()

            if beamToggleEnabled and not isGuiDestroyed then
                refreshBeamButtonVisual(msg)
            end

            if switchedAfterComplete and beamToggleEnabled and not isGuiDestroyed then
                -- Selama jeda 1 detik sebelum lanjut ke target baru, tetap fire prompt jika masih ada
                local elapsed = 0
                while elapsed < 1 and beamToggleEnabled and not isGuiDestroyed do
                    if prevTarget and prevTarget.instance then
                        triggerPromptsIn(prevTarget.instance)
                    end
                    task.wait(0.1)
                    elapsed += 0.1
                end
            else
                task.wait(0.12)
            end
        end
    end)
end

