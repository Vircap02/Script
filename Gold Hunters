local function safeDebugId(obj)
    local id = "obj"
    if obj then
        pcall(function()
            id = obj:GetDebugId()
        end)
    end
    return id
end

local function buildTargetKey(obj, baseCf)
    local pos = baseCf and baseCf.Position or Vector3.zero
    return ("%s_%.1f_%.1f_%.1f"):format(safeDebugId(obj), pos.X, pos.Y, pos.Z)
end

local function pickUnvisitedCandidate(candidates, visitedSet)
    local unvisited = {}
    local resetHappened = false

    for _, item in ipairs(candidates) do
        if not visitedSet[item.key] then
            table.insert(unvisited, item)
        end
    end

    if #unvisited == 0 then
        table.clear(visitedSet)
        resetHappened = true
        for _, item in ipairs(candidates) do
            table.insert(unvisited, item)
        end
    end

    local chosenIndex = math.random(1, #unvisited)
    local chosen = unvisited[chosenIndex]
    visitedSet[chosen.key] = true

    return chosen, resetHappened
end

-- Fungsi mencari posisi CFrame objek (dengan offset ke atas agar tidak jatuh)
local function getTargetCFrame(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("BasePart") then
        return obj.CFrame + Vector3.new(0, (obj.Size.Y * 0.5) + TP_HEIGHT_OFFSET, 0)
    elseif obj:IsA("Model") then
        local pivot = obj:GetPivot()
        return pivot + Vector3.new(0, TP_HEIGHT_OFFSET, 0)
    elseif obj:IsA("Attachment") then
        return obj.WorldCFrame + Vector3.new(0, TP_HEIGHT_OFFSET, 0)
    else
        local innerPart = obj:FindFirstChildWhichIsA("BasePart", true)
        if innerPart then
            return innerPart.CFrame + Vector3.new(0, (innerPart.Size.Y * 0.5) + TP_HEIGHT_OFFSET, 0)
        end
        local innerAtt = obj:FindFirstChildWhichIsA("Attachment", true)
        if innerAtt then
            return innerAtt.WorldCFrame + Vector3.new(0, TP_HEIGHT_OFFSET, 0)
        end
    end
    return nil
end

local function getBasePositionCFrame(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("BasePart") then
        return obj.CFrame
    elseif obj:IsA("Model") then
        return obj:GetPivot()
    elseif obj:IsA("Attachment") then
        return obj.WorldCFrame
    else
        local innerPart = obj:FindFirstChildWhichIsA("BasePart", true)
        if innerPart then
            return innerPart.CFrame
        end
        local innerAtt = obj:FindFirstChildWhichIsA("Attachment", true)
        if innerAtt then
            return innerAtt.WorldCFrame
        end
    end
    return nil
end

