-- Fungsi mengeksekusi ProximityPrompt pada objek tertentu
local function activateSinglePrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Parent then
        return false
    end

    local oldMaxDist = prompt.MaxActivationDistance
    prompt.MaxActivationDistance = math.max(oldMaxDist, 60)

    if typeof(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, prompt)
        return true
    else
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(math.clamp(prompt.HoldDuration, 0.05, 0.2))
            prompt:InputHoldEnd()
        end)
        return true
    end
end

local function collectPromptsForTarget(targetObj)
    local prompts = {}
    if not targetObj or not targetObj.Parent then
        return prompts
    end

    if targetObj:IsA("ProximityPrompt") and targetObj.Parent then
        table.insert(prompts, targetObj)
    end

    for _, desc in ipairs(targetObj:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Parent then
            table.insert(prompts, desc)
        end
    end

    if #prompts == 0 then
        local targetBaseCf = getBasePositionCFrame(targetObj)
        if targetBaseCf then
            local targetPos = targetBaseCf.Position
            for _, desc in ipairs(workspace:GetDescendants()) do
                if desc:IsA("ProximityPrompt") and desc.Parent then
                    local p = desc.Parent
                    local pPos = nil
                    if p:IsA("BasePart") then
                        pPos = p.Position
                    elseif p:IsA("Model") then
                        pPos = p:GetPivot().Position
                    elseif p:IsA("Attachment") then
                        pPos = p.WorldPosition
                    end

                    if pPos and (pPos - targetPos).Magnitude <= 16 then
                        table.insert(prompts, desc)
                    end
                end
            end
        end
    end

    return prompts
end

local function triggerPromptsIn(standObj)
    local firedCount = 0
    local prompts = collectPromptsForTarget(standObj)
    for _, prompt in ipairs(prompts) do
        if activateSinglePrompt(prompt) then
            firedCount += 1
        end
    end
    return firedCount
end

local function isPortalChild(child)
    if not child or not child.Parent then return false end
    local lowerName = string.lower(child.Name)
    if string.find(lowerName, "portal", 1, true) ~= nil then
        return true
    end
    if child:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil then
        return true
    end
    return false
end

local function teleportAndFireGoldHunterPortal()
    local localPlayer = players.LocalPlayer
    local character = localPlayer and localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return false, "Character tidak ditemukan"
    end

    local candidates = {}
    for _, child in ipairs(workspace:GetChildren()) do
        if isPortalChild(child) then
            local tpCf = getTargetCFrame(child)
            local baseCf = getBasePositionCFrame(child)
            if tpCf and baseCf then
                table.insert(candidates, {
                    instance = child,
                    tpCFrame = tpCf,
                    key = buildTargetKey(child, baseCf)
                })
            end
        end
    end

    if #candidates == 0 then
        return false, "Portal tidak ditemukan"
    end

    local chosen, resetHappened = pickUnvisitedCandidate(candidates, visitedPortals)
    hrp.CFrame = chosen.tpCFrame

    task.wait(0.08)
    local fired = triggerPromptsIn(chosen.instance)

    local prefix = resetHappened and "Reset & " or ""
    if fired > 0 then
        return true, ("%sPortal TP & Fired (%d)"):format(prefix, fired)
    else
        return true, ("%sPortal TP Sukses"):format(prefix)
    end
end

local function findSmelterTarget()
    local env = workspace:FindFirstChild("Environment")
    local inWorldUI = env and env:FindFirstChild("InWorldUI")
    local smelter = inWorldUI and inWorldUI:FindFirstChild("Smelter")
    if smelter then
        return smelter
    end

    if inWorldUI then
        for _, desc in ipairs(inWorldUI:GetDescendants()) do
            if desc.Name == "Smelter" then
                return desc
            end
        end
    end

    return nil
end

local function teleportAndFireSmelter()
    local localPlayer = players.LocalPlayer
    local character = localPlayer and localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then
