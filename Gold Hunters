-- Fungsi mengeksekusi ProximityPrompt pada objek tertentu
local function activateSinglePrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Parent then
        return false
    end

    local oldMaxDist = prompt.MaxActivationDistance
    prompt.MaxActivationDistance = math.max(oldMaxDist, 60)

    if typeof(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, prompt)
        return true
    else
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(math.clamp(prompt.HoldDuration, 0.05, 0.2))
            prompt:InputHoldEnd()
        end)
        return true
    end
end

local function collectPromptsForTarget(targetObj)
    local prompts = {}
    if not targetObj or not targetObj.Parent then
        return prompts
    end

    if targetObj:IsA("ProximityPrompt") and targetObj.Parent then
        table.insert(prompts, targetObj)
    end

    for _, desc in ipairs(targetObj:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Parent then
            table.insert(prompts, desc)
        end
    end

    -- Jika prompt tidak berada di dalam targetObj langsung, cek prompt di dekat posisi targetObj
    if #prompts == 0 then
        local targetBaseCf = getBasePositionCFrame(targetObj)
        if targetBaseCf then
            local targetPos = targetBaseCf.Position
            for _, desc in ipairs(workspace:GetDescendants()) do
                if desc:IsA("ProximityPrompt") and desc.Parent then
                    local p = desc.Parent
                    local pPos = nil
                    if p:IsA("BasePart") then
                        pPos = p.Position
                    elseif p:IsA("Model") then
                        pPos = p:GetPivot().Position
                    elseif p:IsA("Attachment") then
                        pPos = p.WorldPosition
                    end

                    if pPos and (pPos - targetPos).Magnitude <= 14 then
                        table.insert(prompts, desc)
                    end
                end
            end
        end
    end

    return prompts
end

local function triggerPromptsIn(standObj)
    local firedCount = 0
    local prompts = collectPromptsForTarget(standObj)
    for _, prompt in ipairs(prompts) do
        if activateSinglePrompt(prompt) then
            firedCount += 1
        end
    end
    return firedCount
end

local function teleportToScanningStand()
    local localPlayer = players.LocalPlayer
    local character = localPlayer and localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return false, "Character tidak ditemukan"
    end

    local candidates = {}
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc.Name == "ScanningStand" then
            local cf = getTargetCFrame(desc)
            local baseCf = getBasePositionCFrame(desc)
            if cf and baseCf then
                table.insert(candidates, {
                    instance = desc,
                    cframe = cf,
                    key = buildTargetKey(desc, baseCf)
                })
            end
        end
    end

    if #candidates == 0 then
        return false, "ScanningStand tidak ada"
    end

    local chosen, resetHappened = pickUnvisitedCandidate(candidates, visitedStands)
    hrp.CFrame = chosen.cframe

    -- Beri jeda singkat agar posisi & prompt siap, lalu langsung fireproximityprompt
    task.wait(0.08)
    local fired = triggerPromptsIn(chosen.instance)

    local prefix = resetHappened and "Reset & " or ""
    if fired > 0 then
        return true, ("%sTP & Fired (%d)"):format(prefix, fired)
    else
        return true, ("%sTP Sukses"):format(prefix)
    end
end

local function isLocationBeamName(name)
    local normalized = string.lower(name):gsub("[%s_-]+", "")
    return normalized == "locationbeam"
end

local activeBeamTarget = nil

local function refreshAllBeamMarkers(candidates)
    for idx, item in ipairs(candidates) do
        local isSelected = (activeBeamTarget ~= nil and item.key == activeBeamTarget.key)
        markLocationBeam(item.instance, item.baseCFrame, idx, isSelected)
    end
end

local function collectLocationBeamCandidates()
    local candidates = {}
    for _, desc in ipairs(workspace:GetDescendants()) do
        if isLocationBeamName(desc.Name) and desc.Parent then
            local tpCf = getTargetCFrame(desc)
            local baseCf = getBasePositionCFrame(desc)
            if tpCf and baseCf then
                table.insert(candidates, {
                    instance = desc,
                    tpCFrame = tpCf,
                    baseCFrame = baseCf,
                    key = buildTargetKey(desc, baseCf)
                })
            end
        end
    end
    return candidates
end

local function isTargetStillNeedsPrompt(target)
    if not target or not target.instance or not target.instance.Parent then
        return false
    end

    local remainingPrompts = collectPromptsForTarget(target.instance)
    return #remainingPrompts > 0
end

local function focusOrAdvanceLocationBeam()
    local localPlayer = players.LocalPlayer
    local character = localPlayer and localPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return false, "Character tidak ditemukan", false
    end

    local candidates = collectLocationBeamCandidates()
    if #candidates == 0 then
        activeBeamTarget = nil
        return false, "Location Beam tidak ada", false
    end

    -- Jika target aktif masih ada dan ProximityPrompt-nya belum hilang, tetap fokus di target ini
    if activeBeamTarget and isTargetStillNeedsPrompt(activeBeamTarget) then
        local liveTpCf = getTargetCFrame(activeBeamTarget.instance) or activeBeamTarget.tpCFrame
        if hrp and (hrp.Position - liveTpCf.Position).Magnitude > 8 then
            hrp.CFrame = liveTpCf
        end

        local fired = triggerPromptsIn(activeBeamTarget.instance)
        local leftPrompts = #collectPromptsForTarget(activeBeamTarget.instance)
        refreshAllBeamMarkers(candidates)

        return true, ("Focus Beam (Prompt:%d | Fired:%d)"):format(leftPrompts, fired), false
    end

    -- Jika target sebelumnya baru saja selesai (prompt hilang / objek hilang), beri jeda 1 detik sebelum ke target berikutnya
    local hadPreviousTarget = (activeBeamTarget ~= nil)
    activeBeamTarget = nil

    local chosen, resetHappened = pickUnvisitedCandidate(candidates, visitedBeams)
    activeBeamTarget = chosen

    local chosenDisplayIndex = 1
    for idx, item in ipairs(candidates) do
        if item.key == chosen.key then
            chosenDisplayIndex = idx
            break
        end
    end

    refreshAllBeamMarkers(candidates)

    local tpCfNow = getTargetCFrame(chosen.instance) or chosen.tpCFrame
    hrp.CFrame = tpCfNow
    local firedNow = triggerPromptsIn(chosen.instance)

    local prefix = resetHappened and "Reset & " or ""
    return true, ("%sBeam #%d/%d (Fired:%d)"):format(prefix, chosenDisplayIndex, #candidates, firedNow), hadPreviousTarget
end

