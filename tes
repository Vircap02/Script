-- Ganti password di bawah ini sesuai keinginan Anda
local CORRECT_PASSWORD = "VircapPassword123" 

-- Link Raw GitHub script asli Anda
local TARGET_SCRIPT_URL = "https://raw.githubusercontent.com/Vircap02/Script/refs/heads/main/Seasouls%20Halloween"

-- ==========================================
-- MEMBUAT TAMPILAN GUI KEY SYSTEM
-- ==========================================
local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- Hapus GUI lama jika ada agar tidak menumpuk
if PlayerGui:FindFirstChild("SeasoulsKeySystem") then
    PlayerGui.SeasoulsKeySystem:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SeasoulsKeySystem"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

-- Main Frame (Background Hitam Elegan ala Halloween/Dark Theme)
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 380, 0, 200)
MainFrame.Position = UDim2.new(0.5, -190, 0.5, -100)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
