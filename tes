-- Tombol Submit / Unlock
local SubmitBtn = Instance.new("TextButton")
SubmitBtn.Size = UDim2.new(0, 320, 0, 35)
SubmitBtn.Position = UDim2.new(0.5, -160, 0, 138)
SubmitBtn.BackgroundColor3 = Color3.fromRGB(255, 120, 0)
SubmitBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SubmitBtn.Text = "UNLOCKED / JALANKAN"
SubmitBtn.TextSize = 14
SubmitBtn.Font = Enum.Font.GothamBold
SubmitBtn.Parent = MainFrame

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 6)
BtnCorner.Parent = SubmitBtn

-- ==========================================
-- LOGIKA VERIFIKASI PASSWORD
-- ==========================================
SubmitBtn.MouseButton1Click:Connect(function()
    if TextBox.Text == CORRECT_PASSWORD then
        SubmitBtn.Text = "SUKSES! Memuat script..."
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(50, 205, 50)
        task.wait(0.8)
        
        -- Tutup GUI Key System
        ScreenGui:Destroy()
        
        -- Download dan Jalankan Script Asli Anda dari GitHub
        local success, err = pcall(function()
            loadstring(game:HttpGet(TARGET_SCRIPT_URL))()
        end)
        
        if not success then
            warn("Gagal memuat script utama: " .. tostring(err))
        end
    else
        -- Efek jika password salah
        SubmitBtn.Text = "PASSWORD SALAH!"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(220, 20, 60)
        task.wait(1.5)
        SubmitBtn.Text = "UNLOCKED / JALANKAN"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(255, 120, 0)
    end
end)
