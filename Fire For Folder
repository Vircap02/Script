					if hrp then
						local visitedItems = {}
						for _, item in ipairs(targetFolder:GetDescendants()) do
							if not tpRunning then break end
							if item:IsA("BasePart") and not visitedItems[item] then
								visitedItems[item] = true
								hrp.CFrame = item.CFrame + Vector3.new(0, 3, 0)
								task.wait(getDelay())
							end
						end
					end
				end
				task.wait(getDelay())
			end
