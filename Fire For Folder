local function getObjectFromPath(pathStr)
	local currentObj = game
	pathStr = pathStr:gsub("%s+", "")
	
	for partName in string.gmatch(pathStr, "[^%.]+") do
		if currentObj then
			if currentObj == game and partName:lower() == "workspace" then
				currentObj = workspace
			else
				local found = currentObj:FindFirstChild(partName)
				if not found then
					pcall(function()
						found = currentObj:WaitForChild(partName, 2)
					end)
				end
				currentObj = found
			end
		else
			return nil
		end
	end
	return currentObj
end

local function getDelay()
	local val = tonumber(delayTextBox.Text)
	if not val or val < 0 then
		return 0.5 
	end
	return val
end

