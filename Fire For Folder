-- 6. Toggle Auto Tween to Item Loop
tweenToggleBtn.MouseButton1Click:Connect(function()
	tweenRunning = not tweenRunning
	updateBtnState(tweenToggleBtn, "Tween Item", tweenRunning)
	if tweenRunning then
		statusLabel.Text = "Status: Auto Tween berjalan..."
		task.spawn(function()
			while tweenRunning do
				local targetFolder = getObjectFromPath(folderTextBox.Text)
				if targetFolder then
					local character = player.Character
					local hrp = character and character:FindFirstChild("HumanoidRootPart")
					if hrp then
						local visitedItems = {}
						for _, item in ipairs(targetFolder:GetDescendants()) do
							if not tweenRunning then break end
							if item:IsA("BasePart") and not visitedItems[item] then
								visitedItems[item] = true
								
								local distance = (hrp.Position - item.Position).Magnitude
								local speed = 50 
								local duration = math.clamp(distance / speed, 0.1, 1.5)
								
								local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
								local tween = TweenService:Create(hrp, tweenInfo, {CFrame = item.CFrame + Vector3.new(0, 3, 0)})
								
								tween:Play()
								
								local completed = false
								local conn
								conn = tween.Completed:Connect(function()
									completed = true
									if conn then conn:Disconnect() end
								end)
								
								local startTime = tick()
								while not completed and tweenRunning and (tick() - startTime) < (duration + 0.2) do
									task.wait(0.05)
								end
								
								if not tweenRunning then
									tween:Cancel()
									break
								end
								
								task.wait(getDelay())
							end
						end
					end
				end
				task.wait(getDelay())
			end
		end)
	else
		statusLabel.Text = "Status: Auto Tween dimatikan"
	end
end)


