-- Container Penyimpanan Objek ESP agar rapi dan bisa dihapus saat dimatikan
local espHighlights = {}
local espDrawings = {}

-- 7. Toggle ESP Highlight
espHighBtn.MouseButton1Click:Connect(function()
	espHighRunning = not espHighRunning
	updateBtnState(espHighBtn, "ESP Highlight", espHighRunning)
	
	if espHighRunning then
		statusLabel.Text = "Status: ESP Highlight aktif"
		task.spawn(function()
			while espHighRunning do
				local targetFolder = getObjectFromPath(folderTextBox.Text)
				if targetFolder then
					local currentParts = {}
					for _, item in ipairs(targetFolder:GetDescendants()) do
						if item:IsA("BasePart") then
							currentParts[item] = true
							-- Buat Highlight jika belum ada
							if not espHighlights[item] then
								local highlight = Instance.new("Highlight")
								highlight.Name = "AutoEspHighlight"
								highlight.Adornee = item
								highlight.FillColor = Color3.fromRGB(0, 255, 128)
								highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
								highlight.FillTransparency = 0.4
								highlight.OutlineTransparency = 0
								highlight.Parent = item
								espHighlights[item] = highlight
							end
						end
					end
					-- Bersihkan highlight item yang sudah hilang dari folder
					for part, hl in pairs(espHighlights) do
						if not currentParts[part] or not part.Parent then
							if hl then hl:Destroy() end
							espHighlights[part] = nil
						end
					end
				else
					-- Hapus semua jika path tidak ditemukan
					for part, hl in pairs(espHighlights) do
						if hl then hl:Destroy() end
						espHighlights[part] = nil
					end
				end
				task.wait(1)
			end
		end)
	else
		statusLabel.Text = "Status: ESP Highlight dimatikan"
		for part, hl in pairs(espHighlights) do
			if hl then hl:Destroy() end
		end
		espHighlights = {}
	end
end)

-- 8. Toggle ESP Line Tracking & Studs (Menggunakan Drawing API)
espLineBtn.MouseButton1Click:Connect(function()
	espLineRunning = not espLineRunning
	updateBtnState(espLineBtn, "ESP Line & Stud", espLineRunning)
	
	if espLineRunning then
		statusLabel.Text = "Status: ESP Line & Stud aktif"
		
		RunService:BindToRenderStep("AutoEspLineAndStud", Enum.RenderPriority.Camera.Value + 1, function()
			if not espLineRunning then
				RunService:UnbindFromRenderStep("AutoEspLineAndStud")
				-- Bersihkan semua drawing lines & text saat dimatikan
				for part, data in pairs(espDrawings) do
					if data.Line then data.Line:Remove() end
					if data.Text then data.Text:Remove() end
				end
				espDrawings = {}
				return
			end
			
			local targetFolder = getObjectFromPath(folderTextBox.Text)
			local character = player.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			
			local activeParts = {}
			
			if targetFolder and hrp then
				for _, item in ipairs(targetFolder:GetDescendants()) do
					if item:IsA("BasePart") then
						activeParts[item] = true
						
						-- Inisialisasi obyek Drawing jika belum ada
						if not espDrawings[item] then
							local line = Drawing.new("Line")
							line.Thickness = 1.5
							line.Color = Color3.fromRGB(0, 255, 255)
							line.Transparency = 0.8
							line.Visible = false
							
							local text = Drawing.new("Text")
							text.Size = 13
							text.Center = true
							text.Outline = true
							text.Color = Color3.fromRGB(255, 255, 255)
							text.Visible = false
							
							espDrawings[item] = {Line = line, Text = text}
						end
						
						local data = espDrawings[item]
						local vector, onScreen = camera:WorldToViewportPoint(item.Position)
						
						if onScreen then
							-- Hitung Jarak (Studs) dari Player ke Item
							local distance = (hrp.Position - item.Position).Magnitude
							
							-- Update Line Tracking (Dari tengah bawah layar ke posisi objek)
							data.Line.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
							data.Line.To = Vector2.new(vector.X, vector.Y)
							data.Line.Visible = true
							
							-- Update Studs Text di atas objek
							data.Text.Text = string.Format("[%s]\n[%.1f studs]", item.Name, distance)
							data.Text.Position = Vector2.new(vector.X, vector.Y - 25)
							data.Text.Visible = true
						else
							data.Line.Visible = false
							data.Text.Visible = false
						end
					end
				end
			end
			
			-- Hapus drawing untuk item yang sudah tidak ada
			for part, data in pairs(espDrawings) do
				if not activeParts[part] or not part.Parent then
					if data.Line then data.Line:Remove() end
					if data.Text then data.Text:Remove() end
					espDrawings[part] = nil
				end
			end
		end)
	else
		statusLabel.Text = "Status: ESP Line & Stud dimatikan"
		pcall(function()
			RunService:UnbindFromRenderStep("AutoEspLineAndStud")
		end)
		for part, data in pairs(espDrawings) do
			if data.Line then data.Line:Remove() end
			if data.Text then data.Text:Remove() end
		end
		espDrawings = {}
	end
end)
