-- Helper untuk merubah tampilan tombol toggle ketika aktif/mati
local function updateBtnState(btn, title, state)
	if state then
		btn.Text = title .. "\n[ ON ]"
		btn.BackgroundColor3 = Color3.fromRGB(30, 140, 75)
	else
		btn.Text = title .. "\n[ OFF ]"
		btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	end
end

-- 1. Toggle TouchInterest Loop
touchToggleBtn.MouseButton1Click:Connect(function()
	touchRunning = not touchRunning
	updateBtnState(touchToggleBtn, "Touch Interest", touchRunning)
	if touchRunning then
		statusLabel.Text = "Status: TouchInterest berjalan..."
		task.spawn(function()
			while touchRunning do
				local targetFolder = getObjectFromPath(folderTextBox.Text)
				if targetFolder then
					local character = player.Character
					local hrp = character and character:FindFirstChild("HumanoidRootPart")
					if hrp then
						for _, item in ipairs(targetFolder:GetDescendants()) do
							if not touchRunning then break end
							if item:IsA("BasePart") and item:FindFirstChildOfClass("TouchTransmitter") then
								firetouchinterest(hrp, item, 0)
								task.wait(0.02)
								firetouchinterest(hrp, item, 1)
							end
						end
					end
				end
				task.wait(getDelay())
			end
		end)
	else
		statusLabel.Text = "Status: TouchInterest dimatikan"
	end
end)

