    local function getRI()
        local pk = workspace:FindFirstChild("Pickups")
        if not pk then return 0 end
        local c = 0
        for _, i in pairs(pk:GetChildren()) do
            if i:IsA("BasePart") or i:IsA("Model") then c = c + 1 end
        end
        return c
    end

    -- METODE TARGET: Mencari Koordinat CP & Pickups Terdekat Otomatis
    local function gC(root)
        if not root then return nil, nil end
        
        local nextCP, cpDist, cpKey = nil, math.huge, nil
        
        -- Cari Koordinat Checkpoint terdekat yang belum dikunjungi
        for i, coord in ipairs(CP_COORDS) do
            if not V_CP[i] then
                local dist = (root.Position - coord).Magnitude
                if dist < cpDist then
                    cpDist = dist
                    nextCP = coord
                    cpKey = i
                end
            end
        end

        -- Cari Item (Pickups) terdekat
        local pk = workspace:FindFirstChild("Pickups")
        local nextItem, itemDist = nil, math.huge
        if pk and getRI() > S_COLLECT then
            for _, item in pairs(pk:GetChildren()) do
                local p = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart", true)
                if p then
                    local dist = (root.Position - p.Position).Magnitude
                    if dist < itemDist then
                        itemDist = dist
                        nextItem = item
                    end
                end
            end
        end

        -- Bandingkan jarak terdekat antara Checkpoint Vector3 dan Item
        if nextCP and (not nextItem or cpDist <= itemDist) then
            return nextCP, "Checkpoint", cpKey
        elseif nextItem then
            return nextItem, "Item"
        end
        
        return nil, nil
    end

    local function start_run()
        local current_timer = math.random(89, 99)
        S_COLLECT = math.random(2, 5)
        
        ShowNotify("Anti-Cheat Bypass", "Target Sisa Item: " .. S_COLLECT)

        V_CP = {} 
        A_RUN = true
        local char = LP.Character or LP.CharacterAdded:Wait(2)
        local root = char:WaitForChild("HumanoidRootPart", 10)
        
        -- START POINT BARU
        root.Anchored = true
        root.CFrame = CFrame.new(Vector3.new(1826.92, 293.35, 836.21))
        task.wait(0.2)
        root.Anchored = false
        task.wait(1.5)

        local s_tick = tick()
        while A_RUN do
            local r = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not r then task.wait(1) continue end

            local target, ttype, saveKey = gC(r)
            if target then
                r.Velocity = Vector3.new(0,0,0)
                
                if ttype == "Checkpoint" then
                    r.Anchored = true 
                    r.CFrame = CFrame.new(target + Vector3.new(0, 3, 0))
                    if saveKey then V_CP[saveKey] = true end
                    task.wait(0.2)
                    r.Anchored = false 
                    task.wait(0.2)
                    
                    -- JIKA INI ADALAH CHECKPOINT TERAKHIR (Indeks 21), TUNGGU DELAY DISINI
                    if saveKey == #CP_COORDS then
                        ShowNotify("Anti-Cheat Bypass", "Menunggu Timer di CP Terakhir: " .. current_timer .. "s")
                        repeat 
                            task.wait(1) 
                        until tick() - s_tick >= current_timer
                    end
                    
                elseif ttype == "Item" then
                    local tp = target:IsA("BasePart") and target or target:FindFirstChildWhichIsA("BasePart", true)
                    if tp then
                        r.Anchored = true 
                        r.CFrame = tp.CFrame
                        task.wait(0.2)
                        r.Anchored = false 
                    end
                    
                    local pr = target:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if pr then 
                        task.wait(0.1)
                        if fireproximityprompt then fireproximityprompt(pr) else pr:InputHoldBegin() task.wait(0.2) pr:InputHoldEnd() end
                    end
                end
                
                task.wait(M_DELAY + (math.random() * 0.30)) 
            else 
                -- Jika semua checkpoint dan item sudah habis, pastikan timer tetap terpenuhi sebelum ke portal
                if tick() - s_tick < current_timer then
                    ShowNotify("Anti-Cheat Bypass", "Menyelesaikan sisa waktu timer...")
                    repeat task.wait(1) until tick() - s_tick >= current_timer
                end
                break 
            end
            task.wait(0.05)
        end

        -- Teleport Akhir ke Portal Finish
        tP_Finish()
        A_RUN = false
    end

    local function JoinSmallServer()
        ShowNotify("Server Finder", "Mencari server paling sepi...")
        local HttpService = game:GetService("HttpService")
        local TeleportService = game:GetService("TeleportService")
        local PlaceId = game.PlaceId
        
        local success, result = pcall(function()
            local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and result and result.data then
            local targetServer = nil
            for _, server in ipairs(result.data) do
                if server.playing and server.playing < server.maxPlayers and server.id ~= game.JobId then
                    if not targetServer or server.playing < targetServer.playing then
                        targetServer = server
                    end
                end
            end
            
            if targetServer then
                ShowNotify("Server Found", "Menghubungkan ke server sepi...")
                task.wait(1)
                TeleportService:TeleportToPlaceInstance(PlaceId, targetServer.id, LP)
            else
                ShowNotify("Error", "Server kecil tidak ditemukan.")
            end
        else
            ShowNotify("Error", "Gagal mengambil data server.")
        end
    end

