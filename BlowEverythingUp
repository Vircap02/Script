local availableAreas = {
  "Area1", "Area2", "Area3", "Area4", "Area5", "Area6",
  "Area7", "Area8", "Area9", "Area10", "Area11", "Area12"
}

local VOID_Y_LIMIT = -20 
local fixedFarmRadius = 1500 

local function getBlocksBySelectedArea(origin, maxDist)
  local validParts = {}
  local areasFolder = workspace:FindFirstChild("Areas")
  if not areasFolder then return validParts end
  
  local targetIndex = 1
  for i, name in ipairs(availableAreas) do
    if name == selectedArea then
      targetIndex = i
      break
    end
  end
  
  local searchOrder = {}
  table.insert(searchOrder, targetIndex)
  
  for i = targetIndex + 1, #availableAreas do
    table.insert(searchOrder, i)
  end
  
  for i = targetIndex - 1, 1, -1 do
    table.insert(searchOrder, i)
  end
  
  for _, idx in ipairs(searchOrder) do
    local testAreaName = availableAreas[idx]
    local specificArea = areasFolder:FindFirstChild(testAreaName)
    
    if specificArea then
      local blocksFolder = specificArea:FindFirstChild("Blocks")
      if blocksFolder and #blocksFolder:GetChildren() > 0 then
        for _, obj in pairs(blocksFolder:GetDescendants()) do
          local success, pos = pcall(function()
            if obj:IsA("BasePart") then
              return obj.Position
            end
          end)
          
          if success and pos and pos.Y > VOID_Y_LIMIT then
            table.insert(validParts, obj)
          end
        end
        
        if #validParts >= 5 then
          if testAreaName ~= selectedArea then
            if idx > targetIndex then
              areaDropdownBtn.Text = "  Area: " .. selectedArea .. " ➔ [Up: " .. testAreaName .. "]"
            else
              areaDropdownBtn.Text = "  Area: " .. selectedArea .. " ➔ [Down: " .. testAreaName .. "]"
            end
          else
            areaDropdownBtn.Text = "  Area: " .. selectedArea .. " [AUTO]"
          end
          return validParts
        end
      end
    end
  end
  
  return validParts
end

