-- 6.1 AUTO BUY & EQUIP GEAR (Membaca sub-folder launcher & skin yang benar dari Directory.Skins.Launcher)
local function startAutoBuyGear()
  task.spawn(function()
    while isAutoBuyGearRunning do
      pcall(function()
        local remotesFolder = workspace:WaitForChild("__THINGS"):WaitForChild("__REMOTES")
        local assetsFolder = ReplicatedStorage:WaitForChild("Assets")
        local buyItemRemote = remotesFolder:FindFirstChild("BuyItem")
        local equipItemRemote = remotesFolder:FindFirstChild("EquipItem")
        
        local skinsLauncherFolder = nil
        pcall(function()
          skinsLauncherFolder = ReplicatedStorage:WaitForChild("Directory"):WaitForChild("Skins"):WaitForChild("Launcher")
        end)
        
        local launcherFolder = assetsFolder:FindFirstChild("Launcher")
        if launcherFolder then
          for _, item in ipairs(launcherFolder:GetChildren()) do
            if not isBomb(item.Name) then
              local weaponName = item.Name
              
              -- 1. Beli Launcher
              if buyItemRemote then
                pcall(function()
                  buyItemRemote:InvokeServer("Launcher", weaponName)
                end)
                task.wait(0.1)
              end
              
              -- 2. Ambil skin yang tersedia di dalam sub-folder senjata
              local selectedSkin = nil
              if skinsLauncherFolder and skinsLauncherFolder:FindFirstChild(weaponName) then
                local weaponSkinFolder = skinsLauncherFolder[weaponName]
                local skinChildren = weaponSkinFolder:GetChildren()
                if #skinChildren > 0 then
                  selectedSkin = skinChildren[#skinChildren].Name
                end
              end
              
              if not selectedSkin then
                selectedSkin = "Urban DDPTA"
              end
              
              -- 3. Eksekusi EquipItem dengan Launcher dan Skin yang sesuai
              if equipItemRemote then
                pcall(function()
                  local args = {
                    "Launcher",
                    weaponName,
                    selectedSkin
                  }
                  equipItemRemote:FireServer(unpack(args))
                end)
                task.wait(0.2)
              end
            end
          end
        end
        
      end)
      task.wait(5)
    end
  end)
end

