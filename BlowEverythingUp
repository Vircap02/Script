local function isBomb(name)
  return string.match(string.lower(name), "bomb") ~= nil
end

local function getLatestBackpackWeapon()
  local backpack = player:FindFirstChild("Backpack")
  if backpack then
    local tools = {}
    for _, tool in ipairs(backpack:GetChildren()) do
      if tool:IsA("Tool") and not isBomb(tool.Name) then
        table.insert(tools, tool)
      end
    end
    if #tools > 0 then
      return tools[#tools].Name
    end
  end
  return nil
end

local function getValidWeapon()
  local latestTool = getLatestBackpackWeapon()
  if latestTool then
    return latestTool
  end
  
  local character = player.Character
  if character then
    for _, tool in ipairs(character:GetChildren()) do
      if tool:IsA("Tool") and not isBomb(tool.Name) then
        return tool.Name
      end
    end
  end

  local success, launcherFolder = pcall(function()
    return ReplicatedStorage:WaitForChild("Assets"):WaitForChild("Launcher")
  end)
  if success and launcherFolder then
    for _, item in ipairs(launcherFolder:GetChildren()) do
      if not isBomb(item.Name) then
        return item.Name
      end
    end
  end
  
  return "Golden Launcher"
end

