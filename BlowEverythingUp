  if isDestroyRunning then startAutoDestroy() end
end)

-- 4. SMART FARM & SELL OTOMATIS
local function startSmartFarm()
  startFly()
  task.spawn(function()
    while isSmartFarmRunning do
      local farmDuration = 20 
      local startTime = tick()
      
      while isSmartFarmRunning and (tick() - startTime < farmDuration) do
        pcall(function()
          local character = player.Character
          if character and character:FindFirstChild("HumanoidRootPart") then
            local hrp = character.HumanoidRootPart
            local parts = getBlocksBySelectedArea(hrp.Position, fixedFarmRadius)
            
            if #parts > 0 then
              local randomPart = parts[math.random(1, #parts)]
              if randomPart and randomPart.Parent then
                local safePos = randomPart.Position
                if safePos.Y > VOID_Y_LIMIT then
                  hrp.CFrame = randomPart.CFrame + Vector3.new(0, 3, 0)
                end
              end
            end
          end
        end)
        
        local customDelay = tonumber(randomTpDelayInput.Text) or 0.5
        task.wait(math.max(customDelay, 0.05))
      end
      
      if not isSmartFarmRunning then break end

      local sellDuration = 1 
      local sellStartTime = tick()
      
      while isSmartFarmRunning and (tick() - sellStartTime < sellDuration) do
        pcall(function()
          local character = player.Character
          if character and character:FindFirstChild("HumanoidRootPart") then
            local hrp = character.HumanoidRootPart
            hrp.CFrame = CFrame.new(-3.68, 4.49, -75.81)
          end
        end)
        task.wait()
      end
    end
    stopFly()
  end)
end

