-- 3. Auto-Destroy, Auto-Equip, & Auto-Respawn Proteksi Macet
local function getNearestBlock(origin, maxDist)
  local parts = getBlocksBySelectedArea(origin, maxDist)
  local nearestDist = math.huge
  local nearestPart = nil
  
  for _, obj in ipairs(parts) do
    local success, pos = pcall(function() return obj.Position end)
    if success and pos and pos.Y > VOID_Y_LIMIT then
      local dist = (pos - origin).Magnitude
      if dist < nearestDist then
        nearestDist = dist
        nearestPart = obj
      end
    end
  end
  return nearestPart
end

local function autoEquipWeapon(weaponName)
  local character = player.Character
  local backpack = player:FindFirstChild("Backpack")
  if not character or not backpack then return end

  local equipped = character:FindFirstChild(weaponName)
  if not equipped then
    local toolInBackpack = backpack:FindFirstChild(weaponName)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if toolInBackpack and humanoid then
      humanoid:EquipTool(toolInBackpack)
    end
  end
end

local function startAutoDestroy()
  task.spawn(function()
    local cooldown = 0.15
    local remote = workspace:WaitForChild("__THINGS"):WaitForChild("__REMOTES"):WaitForChild("ExplodeEvent")
    
    local lastValidTarget = nil
    local stuckTimer = tick()

    while isDestroyRunning do
      task.wait(cooldown)
      pcall(function()
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
          local hrp = character.HumanoidRootPart
          local targetPart = getNearestBlock(hrp.Position, fixedFarmRadius)
          local weaponToUse = getValidWeapon()
          
          autoEquipWeapon(weaponToUse)
          
          if targetPart and targetPart.Parent then
            if targetPart ~= lastValidTarget then
              lastValidTarget = targetPart
              stuckTimer = tick()
            end

            if tick() - stuckTimer > 5 then
              local humanoid = character:FindFirstChildOfClass("Humanoid")
              if humanoid then
                humanoid.Health = 0
              end
              task.wait(2)
              stuckTimer = tick()
            end

            local spawnPos = targetPart.Position
            if spawnPos.Y > VOID_Y_LIMIT then
              local args = {
                vector.create(spawnPos.X, spawnPos.Y, spawnPos.Z),
                targetPart,
                weaponToUse
              }
              remote:FireServer(unpack(args))
            end
          else
            stuckTimer = tick()
          end
        end
      end)
    end
  end)
end

