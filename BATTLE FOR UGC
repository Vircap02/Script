-- Anti-Fling Ringan
task.spawn(function()
    while task.wait(0.1) do
        for _, player in pairs(game.Players:GetPlayers()) do
            if player ~= p and player.Character then
                for _, part in pairs(player.Character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        if part.AssemblyLinearVelocity.Magnitude > 50 then 
                            part.AssemblyLinearVelocity = Vector3.zero 
                        end
                    end
                end
            end
        end
    end
end)

-- Loop Auto Equip / Unequip All
task.spawn(function()
    while task.wait(0.2) do
        local char, bp = p.Character, p:FindFirstChild("Backpack")
        if autoEquipActive then
            if char and bp then 
                for _, t in pairs(bp:GetChildren()) do 
                    if t:IsA("Tool") then 
                        t.Parent = char 
                    end 
                end 
            end
        end
    end
end)

-- Loop Auto Respawn ketika memegang senjata (Tool)
task.spawn(function()
    local wasHoldingTool = false
    while task.wait(0.2) do
        if autoRespawnWeaponActive then
            local char = p.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local equippedTool = char and char:FindFirstChildOfClass("Tool")
            
            if hum and hum.Health > 0 then
                if equippedTool then
                    if not wasHoldingTool then
                        wasHoldingTool = true
                        task.wait(0.5) 
                        if char and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health > 0 then
                            char.Humanoid.Health = 0
                        end
                    end
                else
                    wasHoldingTool = false
                end
            else
                wasHoldingTool = false
            end
        else
            wasHoldingTool = false
        end
    end
end)

-- Logika Pencarian Target
local function GetNextTarget()
    if selectedPlayerName then
        local targetPlr = game.Players:FindFirstChild(selectedPlayerName)
        if targetPlr then
            return targetPlr
        end
    end

    for _, player in ipairs(game.Players:GetPlayers()) do
        if player ~= p and player.Character then
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and hrp then
                return player
            end
        end
    end
    return nil
end

-- Loop Kill Aura
task.spawn(function()
    while task.wait(0.05) do
        if kaActive then
            local char = p.Character
            if char and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health > 0 then
                local tool = char:FindFirstChildOfClass("Tool")
                if not tool then
                    local bp = p:FindFirstChild("Backpack")
                    if bp then
                        local bpTool = bp:FindFirstChildOfClass("Tool")
                        if bpTool then bpTool.Parent = char tool = bpTool end
                    end
                end

                local ps = game.Players:GetPlayers()
                for i = 2, #ps do
                    local v = ps[i].Character
                    if v and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                        if p:DistanceFromCharacter(v.HumanoidRootPart.Position) <= kaRange then
                            if tool and tool:FindFirstChild("Handle") then
                                tool:Activate()
                                local handle = tool.Handle
                                for _, part in ipairs(v:GetChildren()) do
                                    if part:IsA("BasePart") then
                                        firetouchinterest(handle, part, 0)
                                        firetouchinterest(handle, part, 1)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- Loop Teleport ke Depan Hadapan Target (Hanya aktif jika memegang Tool/Senjata)
task.spawn(function()
    while task.wait(0.03) do
        if autoFollowActive then
            local myChar = p.Character
            local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local equippedTool = myChar and myChar:FindFirstChildOfClass("Tool")
            
            if equippedTool and myHrp and myHum and myHum.Health > 0 then
                if not selectedPlayerName then
                    if not currentTarget or not currentTarget.Parent or not currentTarget.Character or not currentTarget.Character:FindFirstChildOfClass("Humanoid") or currentTarget.Character.Humanoid.Health <= 0 then
                        currentTarget = GetNextTarget()
                    end
                else
                    currentTarget = GetNextTarget()
                end

                if currentTarget and currentTarget.Character then
                    local targetHum = currentTarget.Character:FindFirstChildOfClass("Humanoid")
                    local targetHrp = currentTarget.Character:FindFirstChild("HumanoidRootPart")
                    
                    if targetHum and targetHum.Health > 0 and targetHrp then
                        local frontCFrame = targetHrp.CFrame * CFrame.new(0, 0, -3) * CFrame.Angles(0, math.pi, 0)
                        myHrp.CFrame = frontCFrame
                    end
                end
            end
        end
    end
end)

