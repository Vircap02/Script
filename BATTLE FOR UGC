-- Fungsi pembantu membuat Toggle
local function CreateBattleToggle(name, callback)
    local ToggleContainer = Instance.new("Frame")
    ToggleContainer.Size = UDim2.new(1, 0, 0, 42)
    ToggleContainer.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    ToggleContainer.BorderSizePixel = 0
    ToggleContainer.Parent = ContentContainer

    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(0, 6)
    ToggleCorner.Parent = ToggleContainer

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -70, 1, 0)
    Label.Position = UDim2.new(0, 12, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Font = Enum.Font.GothamMedium
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(220, 220, 220)
    Label.TextSize = 13
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = ToggleContainer

    local SwitchBtn = Instance.new("TextButton")
    SwitchBtn.Size = UDim2.new(0, 45, 0, 24)
    SwitchBtn.Position = UDim2.new(1, -55, 0.5, -12)
    SwitchBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
    SwitchBtn.AutoButtonColor = false
    SwitchBtn.Text = ""
    SwitchBtn.Parent = ToggleContainer

    local SwitchCorner = Instance.new("UICorner")
    SwitchCorner.CornerRadius = UDim.new(1, 0)
    SwitchCorner.Parent = SwitchBtn

    local Circle = Instance.new("Frame")
    Circle.Size = UDim2.new(0, 18, 0, 18)
    Circle.Position = UDim2.new(0, 3, 0.5, -9)
    Circle.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    Circle.Parent = SwitchBtn

    local CircleCorner = Instance.new("UICorner")
    CircleCorner.CornerRadius = UDim.new(1, 0)
    CircleCorner.Parent = Circle

    local active = false
    SwitchBtn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            SwitchBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
            Circle:TweenPosition(UDim2.new(1, -21, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        else
            SwitchBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
            Circle:TweenPosition(UDim2.new(0, 3, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        end
        callback(active)
    end)
end

-- 1. Toggle Auto Matchmaking Request
CreateBattleToggle("Auto Matchmaking Request", function(Value)
    matchmakingActive = Value
    if matchmakingActive then
        matchmakingThread = task.spawn(function()
            while matchmakingActive do
                local char = p.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if char and hum and hum.Health > 0 then
                    pcall(function() 
                        ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("MatchmakingRequest"):FireServer() 
                    end)
                    task.wait(3)
                else
                    p.CharacterAdded:Wait()
                    task.wait(2)
                end
            end
        end)
    else
        if matchmakingThread then 
            task.cancel(matchmakingThread)
            matchmakingThread = nil 
        end
    end
end)

