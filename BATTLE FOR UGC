-- Tombol Tab Match
local MatchBtn = CreateButton(MatchPage, "Match Auto: OFF", UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, 26), Color3.fromRGB(70, 50, 60))
MatchBtn.MouseButton1Click:Connect(function()
    matchmakingActive = not matchmakingActive
    
    if matchmakingActive then
        MatchBtn.Text = "Match Auto: ON"
        MatchBtn.BackgroundColor3 = Color3.fromRGB(40, 140, 60)
        
        if matchmakingThread then 
            task.cancel(matchmakingThread) 
            matchmakingThread = nil 
        end
        
        matchmakingThread = task.spawn(function()
            while matchmakingActive do
                local char = p.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                
                if char and hum and hum.Health > 0 then
                    pcall(function() 
                        game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("MatchmakingRequest"):FireServer() 
                    end)
                    
                    local elapsed = 0
                    while elapsed < 3 and matchmakingActive do
                        task.wait(0.2)
                        elapsed = elapsed + 0.2
                    end
                else
                    p.CharacterAdded:Wait()
                    task.wait(2)
                end
            end
        end)
    else
        MatchBtn.Text = "Match Auto: OFF"
        MatchBtn.BackgroundColor3 = Color3.fromRGB(70, 50, 60)
        
        if matchmakingThread then 
            task.cancel(matchmakingThread) 
            matchmakingThread = nil 
        end
    end
end)
