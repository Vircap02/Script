local function UpdatePlayerList()
    for _, child in ipairs(PlayerListScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    local autoBtn = Instance.new("TextButton", PlayerListScroll)
    autoBtn.Size = UDim2.new(1, -6, 0, 18)
    autoBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    autoBtn.Text = "Auto (Random)"
    autoBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    autoBtn.Font = Enum.Font.GothamMedium
    autoBtn.TextSize = 9
    Instance.new("UICorner", autoBtn).CornerRadius = UDim.new(0, 3)
    autoBtn.MouseButton1Click:Connect(function()
        selectedPlayerName = nil
        PlayerDropdown.Text = "Select Player: Auto"
        PlayerListScroll.Visible = false
        currentTarget = GetNextTarget()
    end)
    
    for _, plr in ipairs(game.Players:GetPlayers()) do
        if plr ~= p then
            local pBtn = Instance.new("TextButton", PlayerListScroll)
            pBtn.Size = UDim2.new(1, -6, 0, 18)
            pBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            pBtn.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
            pBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            pBtn.Font = Enum.Font.GothamMedium
            pBtn.TextSize = 9
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 3)
            
            pBtn.MouseButton1Click:Connect(function()
                selectedPlayerName = plr.Name
                PlayerDropdown.Text = "Locked: " .. plr.DisplayName
                PlayerListScroll.Visible = false
                currentTarget = GetNextTarget()
            end)
        end
    end
    PlayerListScroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 4)
end

PlayerDropdown.MouseButton1Click:Connect(function()
    PlayerListScroll.Visible = not PlayerListScroll.Visible
    if PlayerListScroll.Visible then UpdatePlayerList() end
