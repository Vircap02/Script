-- ==========================================
-- LOGIKA UTAMA + AUTO REJOINS
-- ==========================================
local player = Players.LocalPlayer
local COOLDOWN_TIME = 310 -- 5 menit per putaran

local function startFarm()
    if farmThread then task.cancel(farmThread) end
    farmThread = task.spawn(function()
        local ClaimFreeRF = ReplicatedStorage:WaitForChild("Packages")
            :WaitForChild("Knit")
            :WaitForChild("Services")
            :WaitForChild("ChestRewardService")
            :WaitForChild("RF")
            :WaitForChild("ClaimFree")

        local rewardLocations = {
            {name = "GlassBridge", part = workspace:WaitForChild("GlassBridge"):WaitForChild("GlassReward")},
            {name = "MathPuzzle",  part = workspace:WaitForChild("MathPuzzle"):WaitForChild("MathReward")},
            {name = "RainbowObby", part = workspace:WaitForChild("RainbowObby"):WaitForChild("RainbowReward")},
            {name = "WallEscape",  part = workspace:WaitForChild("WallEscape"):WaitForChild("WallReward")},
        }

        local completedCycles = 0

        while isRunning do
            local character = player.Character or player.CharacterAdded:Wait()
            local rootPart = character:WaitForChild("HumanoidRootPart", 5)

            if rootPart and isRunning then
                local cycleStartTime = os.clock()
                
                -- 1. Teleport & Klaim Semua Reward
                for index, location in ipairs(rewardLocations) do
                    if not isRunning then break end
                    
                    local targetPart = location.part
                    if targetPart then
                        statusLabel.Text = "Teleport ke: " .. location.name
                        rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                        task.wait(0.3)

                        for id = 1, 99 do
                            if not isRunning then break end
                            pcall(function()
                                ClaimFreeRF:InvokeServer(id)
                            end)
                            task.wait()
                        end
                    end

                    if index < #rewardLocations and isRunning then
                        task.wait(1)
                    end
                end

                completedCycles = completedCycles + 1

                -- 2. Tunggu Timer 5 Menit Habis Dulu
                while isRunning do
                    local elapsedTime = os.clock() - cycleStartTime
                    local remainingTime = COOLDOWN_TIME - elapsedTime
                    
                    if remainingTime <= 0 then
                        break
                    end
                    
                    local targetCycles = tonumber(rejoinInput.Text) or 1
                    local mins = math.floor(remainingTime / 60)
                    local secs = math.floor(remainingTime % 60)
                    statusLabel.Text = string.format("Putaran %d/%d | Sisa: %02d:%02d", completedCycles, targetCycles, mins, secs)
                    task.wait(0.5)
                end

                if not isRunning then break end

                -- 3. Setelah Timer Habis, Cek Apakah Waktunya Rejoin
                local targetCycles = tonumber(rejoinInput.Text) or 1
                if completedCycles >= targetCycles then
                    statusLabel.Text = "Timer habis! Rejoining..."
                    task.wait(1)
                    triggerRejoin()
                    break
                end
            else
                statusLabel.Text = "Menunggu Karakter..."
                task.wait(1)
            end
        end
    end)

    if playtimeThread then task.cancel(playtimeThread) end
    playtimeThread = task.spawn(function()
        local PlaytimeRF = ReplicatedStorage:WaitForChild("Packages")
            :WaitForChild("Knit")
            :WaitForChild("Services")
            :WaitForChild("PlaytimeRewardsService")
            :WaitForChild("RF")
            :WaitForChild("Claim")

        while isRunning do
            for i = 1, 8 do
                if not isRunning then break end
                pcall(function()
                    PlaytimeRF:InvokeServer(i)
                end)
                task.wait()
            end
            
            for _ = 1, 1 do
                if not isRunning then break end
                task.wait()
            end
        end
    end)
end

local function stopFarm()
    isRunning = false
    if farmThread then
        task.cancel(farmThread)
        farmThread = nil
    end
    if playtimeThread then
        task.cancel(playtimeThread)
        playtimeThread = nil
    end
    statusLabel.Text = "Status: Idle"
end

