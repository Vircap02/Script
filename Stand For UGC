-- Sistem Penyimpanan Config (Auto Save/Load)
local CONFIG_FILE = "VirgoboyAutoFarm_Config.json"

local function saveConfig(val)
    if writefile then
        local success, err = pcall(function()
            writefile(CONFIG_FILE, tostring(val))
        end)
    end
end

local function loadConfig()
    if readfile and isfile and isfile(CONFIG_FILE) then
        local success, result = pcall(function()
            return readfile(CONFIG_FILE)
        end)
        if success and result then
            return string.gsub(result, "%s+", "") -- Hapus spasi/newline berlebih
        end
    end
    return "1" -- Default jika file belum ada
end

