-- ========== LOGIC ==========
local cache = {}
local store = {Asc = {t = 0, data = {}}, Desc = {t = 0, data = {}}}
local TTL = 90       -- detik data dianggap segar (tidak request ulang)
local COOLDOWN = 8   -- detik minimal antar tekan Refresh
local lastForce = 0
local busy = false

local function setStatus(t, color)
    status.Text = t
    status.TextColor3 = color or C.sub
end

local function highlightModes()
    for name, b in pairs(modes) do
        b.BackgroundColor3 = (name == currentMode) and C.accent or C.item
    end
end

local function join(server)
    setStatus("Teleport ke server " .. server.id:sub(1, 8) .. "...", C.green)
    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
    end)
    if not ok then setStatus("Gagal join: " .. tostring(err), C.red) end
end

local function render()
    for _, c in ipairs(list:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end

    local mn = tonumber(boxMin.Text) or 0
    local mx = tonumber(boxMax.Text) or math.huge

    local filtered = {}
    for _, s in ipairs(cache) do
        local p = s.playing or 0
        if p >= mn and p <= mx then table.insert(filtered, s) end
    end

    table.sort(filtered, function(a, b)
        if currentMode == "Rame" then return (a.playing or 0) > (b.playing or 0) end
        return (a.playing or 0) < (b.playing or 0)
    end)

    for i, s in ipairs(filtered) do
        local isCurrent = (s.id == game.JobId)
        local row = new("Frame", {
            Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = C.item,
            BorderSizePixel = 0, LayoutOrder = i,
        }, list)
        corner(row, 6)

        local playing, maxP = s.playing or 0, s.maxPlayers or 0
        local ratio = (maxP > 0) and (playing / maxP) or 0
        local dot = ratio >= 0.8 and "🔴" or (ratio >= 0.4 and "🟡" or "🟢")

        new("TextLabel", {
            Text = ("%s  %d/%d players   •   Ping %s"):format(dot, playing, maxP, s.ping and (s.ping .. "ms") or "-"),
            Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = C.text,
            BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
            Position = UDim2.new(0, 10, 0, 3), Size = UDim2.new(1, -90, 0, 18),
        }, row)
        new("TextLabel", {
            Text = "ID: " .. s.id:sub(1, 18) .. "..." .. (isCurrent and "  (server ini)" or ""),
            Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = C.sub,
            BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
            Position = UDim2.new(0, 10, 0, 21), Size = UDim2.new(1, -90, 0, 14),
        }, row)

        local j = button(isCurrent and "Here" or "Join", isCurrent and C.item or C.green, row, {
            Position = UDim2.new(1, -66, 0.5, -13), Size = UDim2.new(0, 58, 0, 26),
            Active = not isCurrent, AutoButtonColor = not isCurrent,
        })
        if not isCurrent then
            j.MouseButton1Click:Connect(function() join(s) end)
        end
    end

    setStatus(("Menampilkan %d dari %d server  |  Mode: %s"):format(#filtered, #cache, currentMode),
        C.text)
end

local function refresh(force)
    if busy then return end
    local order = (currentMode == "Rame") and "Desc" or "Asc"
    local slot = store[order]

    if force then
        local left = COOLDOWN - (os.clock() - lastForce)
        if left > 0 then
            setStatus(("Tunggu %ds sebelum refresh lagi."):format(math.ceil(left)), C.red)
            return
        end
        lastForce = os.clock()
    elseif #slot.data > 0 and (os.clock() - slot.t) < TTL then
        cache = slot.data -- pakai cache, tanpa request
        render()
        return
    end

    busy = true
    btnRefresh.Text = "..."
    setStatus("Memuat server...", C.sub)

    task.spawn(function()
        local servers, err = fetchServers(order,
            function(n, p) setStatus(("Memuat... %d server (hal. %d)"):format(n, p), C.sub) end,
            function(a, d) setStatus(("Rate limit, retry %d/6 dalam %ds..."):format(a, d), C.red) end
        )
        if #servers > 0 then slot.data, slot.t = servers, os.clock() end
        cache = (#servers > 0) and servers or slot.data
        render()
        if err then setStatus(err, C.red) end
        btnRefresh.Text = "⟳ Refresh"
        busy = false

        -- mode berubah saat loading -> sinkronkan
        local want = (currentMode == "Rame") and "Desc" or "Asc"
        if want ~= order then refresh(false) end
    end)
end

