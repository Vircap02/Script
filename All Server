-- ========== HTTP (anti rate limit) ==========
local HOSTS = {"games.roblox.com", "games.roproxy.com"} -- fallback otomatis

local function httpGet(url)
    local req = (syn and syn.request) or request or http_request or (http and http.request)
    if req then
        local ok, r = pcall(function() return req({Url = url, Method = "GET"}) end)
        if ok and r then return r.Body, r.StatusCode end
    end
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and res then return res, 200 end
    return nil, tostring(res):find("429") and 429 or 0
end

local function fetchPage(order, cursor, onWait)
    for attempt = 1, 6 do
        local host = HOSTS[(attempt - 1) % #HOSTS + 1]
        local url = ("https://%s/v1/games/%d/servers/Public?sortOrder=%s&limit=100%s")
            :format(host, PlaceId, order, cursor and ("&cursor=" .. cursor) or "")
        local body, code = httpGet(url)
        if body and (code == 200 or code == nil) then
            local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
            if ok and type(data) == "table" and data.data then return data end
        end
        local delay = attempt * 2 -- backoff: 2s, 4s, 6s, ...
        if onWait then onWait(attempt, delay) end
        task.wait(delay)
    end
    return nil
end

local function fetchServers(order, onProgress, onWait)
    local result, cursor = {}, nil
    for page = 1, MAX_PAGES do
        local data = fetchPage(order, cursor, onWait)
        if not data then return result, "Gagal memuat (rate limit). Coba lagi nanti." end
        for _, s in ipairs(data.data) do table.insert(result, s) end
        if onProgress then onProgress(#result, page) end
        cursor = data.nextPageCursor
        if not cursor then break end
        task.wait(1) -- jeda antar halaman
    end
    return result, nil
end

