-- 6. LOOP ESP VAMPIRE
local espCache = {}

local function removeESP(item)
	if espCache[item] then
		if espCache[item].billboard then espCache[item].billboard:Destroy() end
		if espCache[item].highlight then espCache[item].highlight:Destroy() end
		espCache[item] = nil
	end
end

local function addESP(item)
	if not espCache[item] and (item:IsA("Model") or item:IsA("BasePart")) then
		local highlight = Instance.new("Highlight")
		highlight.Name = "VampireESP_Highlight"
		highlight.Adornee = item
		highlight.FillColor = Color3.fromRGB(150, 0, 255)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.5
		highlight.Parent = item

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "VampireESP_Text"
		billboard.Size = UDim2.new(0, 100, 0, 40)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = true
		
		local textLabel = Instance.new("TextLabel")
		textLabel.Size = UDim2.new(1, 0, 1, 0)
		textLabel.BackgroundTransparency = 1
		textLabel.Text = "Vampire (Feriac)"
		textLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
		textLabel.TextSize = 14
		textLabel.Font = Enum.Font.GothamBold
		textLabel.Parent = billboard

		local targetPart = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart") or item:FindFirstChildOfClass("BasePart")
		if targetPart then
			billboard.Adornee = targetPart
			billboard.Parent = targetPart
		end

		espCache[item] = {highlight = highlight, billboard = billboard}
	end
end

RunService.Heartbeat:Connect(function()
	if not espEnabled then
		for item, _ in pairs(espCache) do removeESP(item) end
		return
	end
	
	local vTarget = getVampireTarget()
	local activeItems = {}

	if vTarget then
		activeItems[vTarget] = true
		addESP(vTarget)
	end

	for item, _ in pairs(espCache) do
		if not activeItems[item] then removeESP(item) end
	end
end)

