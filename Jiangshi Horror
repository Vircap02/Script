-- Helper khusus mencari SpawnHaloRing presisi berdasarkan Folder & Posisi Radius
local function getMatchedHaloRings(folderName)
    local matchedRings = {}
    local folder = Workspace:FindFirstChild(folderName)
    if not folder then return matchedRings end

    -- 1. PENCARIAN HIRARKI DIRECT: Cek apakah SpawnHaloRing berada di dalam folder tersebut
    for _, item in ipairs(folder:GetDescendants()) do
        if item.Name == "SpawnHaloRing" then
            local haloPart = item:IsA("BasePart") and item or (item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")))
            if haloPart then
                table.insert(matchedRings, haloPart)
            end
        end
    end

    -- Jika SpawnHaloRing berada langsung di dalam folder, gunakan hasil ini
    if #matchedRings > 0 then
        return matchedRings
    end

    -- 2. PENCARIAN JIKA SpawnHaloRing DI LUAR FOLDER (Pencocokan Posisi Jarak Terdekat)
    local spawnPositions = {}
    for _, item in ipairs(folder:GetDescendants()) do
        if item:IsA("BasePart") then
            table.insert(spawnPositions, item.Position)
        end
    end

    if #spawnPositions == 0 then return matchedRings end

    for _, item in ipairs(Workspace:GetDescendants()) do
        if item.Name == "SpawnHaloRing" then
            local haloPart = item:IsA("BasePart") and item or (item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")))
            if haloPart then
                for _, spawnPos in ipairs(spawnPositions) do
                    -- Memperketat toleransi jarak radius menjadi max 4 stud agar tidak salah ambil
                    if (haloPart.Position - spawnPos).Magnitude <= 4 then
                        table.insert(matchedRings, haloPart)
                        break
                    end
                end
            end
        end
    end

    return matchedRings
end

-- Helper khusus mencari SEMUA objek yang berawalan nama "Teared" (Mantra) di Workspace
local function getMantraObjects()
    local mantraList = {}
    for _, item in ipairs(Workspace:GetDescendants()) do
        -- Deteksi semua nama objek yang berawalan "Teared"
        if string.sub(item.Name, 1, 6) == "Teared" then
            if item:IsA("BasePart") then
                table.insert(mantraList, item)
            elseif item:IsA("Model") then
                local mainPart = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
                if mainPart then
                    table.insert(mantraList, mainPart)
                end
            end
        end
    end
    return mantraList
end


