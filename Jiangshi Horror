-- 8. AUTO REVIVE / HELP PLAYER (Tunggu Player Minta Tolong Baru Cari Medkit, Revive, Lalu TP Acak)
local helpCooldown = 0
local isHelping = false
local lastHelpRandomIndex = 0

RunService.Heartbeat:Connect(function()
    if not autoRevivePlayerActive or isHelping then return end
    if tick() < helpCooldown then return end

    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not hum then return end

    -- Deteksi apakah ada player lain yang butuh bantuan (memiliki proximity prompt aktif)
    local targetPlayerPrompt = nil
    local targetPlayerHrp = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= lp and player.Character then
            local tHrp = player.Character:FindFirstChild("HumanoidRootPart")
            if tHrp then
                for _, prompt in ipairs(player.Character:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        targetPlayerPrompt = prompt
                        targetPlayerHrp = tHrp
                        break
                    end
                end
            end
        end
        if targetPlayerPrompt then break end
    end

    -- Jika ada player yang minta tolong, baru jalankan aksi
    if targetPlayerPrompt and targetPlayerHrp then
        isHelping = true

        -- 1. Cek apakah sudah punya medkit
        local medkitTool = getItemByName("medkit")

        -- 2. Jika belum punya medkit, cari dan ambil medkit terlebih dahulu secara cepat
        if not medkitTool then
            local medkitRings = getMatchedHaloRings("MedkitSpawnPoints")
            local startTime = tick()
            
            -- Loop kilat teleport ke spawn medkit sampai medkit didapat atau timeout 4 detik
            while not medkitTool and (tick() - startTime < 4) do
                for _, ringPart in ipairs(medkitRings) do
                    if ringPart and hrp then
                        pcall(function()
                            hrp.CFrame = ringPart.CFrame + Vector3.new(0, 3, 0)
                            firePromptNearCharacter()
                        end)
                        task.wait(0.2)
                        medkitTool = getItemByName("medkit")
                        if medkitTool then break end
                    end
                end
                task.wait(0.1)
            end
        end

        -- 3. Jika medkit sudah ada, teleport ke player dan lakukan revive
        local currentCharacter = lp.Character
        local currentHrp = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
        local currentHum = currentCharacter and currentCharacter:FindFirstChildOfClass("Humanoid")
        local finalMedkit = getItemByName("medkit")

        if currentHrp and currentHum and finalMedkit then
            if finalMedkit.Parent ~= currentCharacter then
                currentHum:EquipTool(finalMedkit)
            end

            pcall(function()
                currentHrp.CFrame = targetPlayerHrp.CFrame + Vector3.new(0, 3, 0)
                fireproximityprompt(targetPlayerPrompt)
            end)

            if finalMedkit.Parent == currentCharacter then
                pcall(function() finalMedkit:Activate() end)
            end
            
            -- Jeda sejenak untuk memastikan prompt/revive tereksekusi server
            task.wait(0.3)

            -- 4. TELEPORT ACAK KE TEMPAT JAUH SETELAH SELESAI REVIVE
            local freshChar = lp.Character
            local freshHrp = freshChar and freshChar:FindFirstChild("HumanoidRootPart")
            if freshHrp and #guiLocations > 0 then
                local randomIndex
                repeat
                    randomIndex = math.random(1, #guiLocations)
                until randomIndex ~= lastHelpRandomIndex or #guiLocations == 1
                
                lastHelpRandomIndex = randomIndex
                local randomTargetPos = guiLocations[randomIndex]

                pcall(function()
                    freshHrp.CFrame = CFrame.new(randomTargetPos) + Vector3.new(0, 3, 0)
                end)
            end
        end

        helpCooldown = tick() + 2
        isHelping = false
    end
end)


